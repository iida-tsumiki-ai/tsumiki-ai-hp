---
/**
 * /seminar/ — 経営者合同セミナー LP（F3 / カテゴリA × 主力3マス）
 * 設計書: 11 §6 / 2026-04-23 論点2 反映（Lv3講座が副読本）
 * 役割: ★主力。Lv3経営者の他社経営者とのピアラーニング → AI駆動経営伴走支援への導線
 * リリース: Phase 3（2026 Q4）第1回 / 千葉県内
 */
import Layout from "../../layouts/Layout.astro";

const programFlow = [
  { time: "09:30", label: "受付・名刺交換", body: "千葉県内の会場（具体所在地は決定次第ご案内）。10名定員のピアラーニング。" },
  { time: "10:00", label: "オープニング — 4段階モデルの再確認", body: "DX→AI駆動経営の連続体／❶❷DX領域・❸❹AI領域。各社が今いる位置の自己宣言から始めます。" },
  { time: "10:45", label: "午前ワーク — 自社の現状整理", body: "事前に記入した「DX診断結果＋自社の壁」を持ち寄り、3名グループで現状言語化。" },
  { time: "12:30", label: "ランチ（全員参加）", body: "業界・規模を超えた経営者同士の交流時間。同質性の罠から抜けるための設計です。" },
  { time: "13:30", label: "午後ワーク — 他社事例から学ぶ", body: "10名のうち2-3名が30分ずつ自社のAI駆動経営取り組みを共有。質疑応答で自社に引き寄せて考えます。" },
  { time: "15:30", label: "個別ワーク — 四半期計画ドラフト", body: "「この四半期はここに投資する」を A4 1枚に言語化。テンプレート提供。" },
  { time: "17:00", label: "発表とフィードバック", body: "10名全員が四半期計画を発表 → 他参加者から1分ずつフィードバック。" },
  { time: "18:00", label: "終了 — 任意の懇親会（実費）", body: "希望者のみ。千葉県内で2時間程度。継続的な経営者ネットワークの起点に。" },
];

const expectedOutcomes = [
  "「この四半期はここに投資する」が A4 1枚で言語化されている",
  "他社経営者の AI駆動経営事例を3つ以上持ち帰れる",
  "自社の Lv3→Lv4 の壁が具体的に見えている",
  "経営者ネットワークが10名広がっている",
];

const cantDo = [
  {
    title: "Lv1-Lv2 の経営者は早すぎます",
    body: "本セミナーは Lv3 の経営者を想定しています。全社AI活用の底上げと業務棚卸しが完了していない場合、議論についていきにくいです。<a href=\"/courses/\">講座シリーズ</a> または <a href=\"/diagnose/\">DX診断</a> から始めてください。",
  },
  {
    title: "他社事例の守秘義務に注意",
    body: "本セミナーで共有された他社事例は、参加者の許可なく外部公開・SNS発信できません。誓約書にサインいただきます。安心して話せる場づくりが本セミナーの価値の核です。",
  },
  {
    title: "同業界・同規模での開催ではありません",
    body: "意図的に異業種・異規模を混ぜます。「同じ業界の人だけで集まりたい」というニーズには応えられません。同質性の中では新しい視点が生まれにくいためです。",
  },
];

const faq = [
  {
    q: "オンライン参加はできますか？",
    a: "本セミナーは <strong>対面・1日集合のみ</strong>です。オンラインでは「ピアラーニングの場の力」が出ないと判断しています。千葉県内会場での開催。遠方からの参加者には宿泊の手配サポートも検討中です。",
  },
  {
    q: "Lv3 講座は受けたほうがいいですか？",
    a: "<strong>本セミナーが主、Lv3講座は副読本</strong>です。本セミナー単独でも完結する設計ですが、Lv3講座（¥3,000）を事前に読むと議論への参加が深まります。Lv3講座は Phase 4（2027 Q1-Q2）リリース予定です。",
  },
  {
    q: "リリース時期は？",
    a: "Phase 3（<strong>2026 Q4 / 10〜12月</strong>）に第1回開催予定です。具体日程・会場・申込みフォームは決定次第ご案内します。<strong>関心登録</strong>（メアドのみ）いただくと優先案内します。",
  },
  {
    q: "費用は？",
    a: "<strong>参加費 ¥50,000 / 名</strong>（税別 / 1日・ランチ込み）。10名定員。懇親会費用は別途実費（任意参加）。事前に案内する DX診断結果の記入と簡単な事前課題（A4 1枚）が条件です。",
  },
  {
    q: "AI駆動経営伴走支援との関係は？",
    a: "本セミナーは <strong>AI駆動経営伴走支援への自然な導線</strong>として設計しています。1日のワークで「自社だけでは越えられない壁」が見えた経営者には、伴走支援を案内します。営業色は強くしませんが、本セミナーは AI駆動経営伴走支援の前段ステップとして機能します。",
  },
];
---

<Layout
  title="経営者合同セミナー — ツミキAI"
  description="★主力。Lv3経営者10名と1日集まる、ピアラーニング型のAI駆動経営合同セミナー。¥5万/名・千葉県内・Phase 3（2026 Q4）開催予定。"
>
  <!-- ========== §HERO ========== -->
  <section class="page-section page-section--warm">
    <div class="page-container hero">
      <p class="kicker">A. 経営者が先に学ぶ — 経営者合同セミナー（★主力）</p>
      <h1 class="hero-title">
        1日で<br />
        <span class="hero-accent">「この四半期はここに投資する」を作る。</span>
      </h1>
      <p class="hero-lead">
        千葉県の <strong>Lv3経営者10名</strong> が1日集まる、ピアラーニング型セミナー。
        他社経営者と<strong>AI駆動経営の事例を持ち寄り</strong>、自社の四半期計画を A4 1枚に言語化して持ち帰ります。
      </p>
      <div class="hero-meta">
        <span class="hero-price">¥5万 / 名</span>
        <span class="hero-price-note">10名定員 / 1日 / 千葉県内</span>
        <span class="hero-release">Phase 3（2026 Q4）第1回開催予定</span>
      </div>
      <div class="hero-ctas">
        <a class="btn btn-primary btn-lg" href="/contact/">関心登録（開催が決まったら優先案内）</a>
        <a class="btn btn-secondary btn-lg" href="/diagnose/">先に DX診断（10問・3分）</a>
      </div>
    </div>
  </section>

  <!-- ========== §こんな方へ ========== -->
  <section class="page-section">
    <div class="page-container">
      <header class="sec-head">
        <p class="sec-kicker">こんな方へ</p>
        <h2 class="sec-title">Lv3 を超える壁は、一人では越えにくい。</h2>
        <p class="sec-lead">
          Lv2 → Lv3 の壁は「最も高い壁」だと考えています。個別効率化から戦略転換へ、自分だけで言語化するのが難しい段階。
          <strong>他社経営者の事例を浴びる</strong>のが、最も効率的な進み方です。
        </p>
      </header>
      <ul class="audience-list">
        <li>全社でAI活用の底上げが進み、個別効率化は形になった</li>
        <li>基幹系・重要サービスの再選定が必要だと感じ始めている</li>
        <li>データを経営判断に使う仕組みを作りたい</li>
        <li>社内CTO機能（選定・運用・教育）の役割設計が定まっていない</li>
        <li>他社経営者の生の事例から学びたい</li>
      </ul>
    </div>
  </section>

  <!-- ========== §プログラム ========== -->
  <section class="page-section page-section--subtle">
    <div class="page-container">
      <header class="sec-head">
        <p class="sec-kicker">プログラム</p>
        <h2 class="sec-title">1日のタイムテーブル。</h2>
        <p class="sec-lead">
          午前は「現状整理」、午後は「他社事例 → 自社の四半期計画ドラフト」、最後は「全員の発表とフィードバック」。
          <strong>終了時に A4 1枚の四半期計画</strong>が手元に残ります。
        </p>
      </header>
      <ol class="program-flow">
        {programFlow.map((step) => (
          <li class="flow-step">
            <div class="flow-time">{step.time}</div>
            <div class="flow-body">
              <h3 class="flow-label">{step.label}</h3>
              <p class="flow-text">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ========== §持ち帰れるもの ========== -->
  <section class="page-section">
    <div class="page-container">
      <header class="sec-head">
        <p class="sec-kicker">持ち帰れるもの</p>
        <h2 class="sec-title">1日後、こうなっています。</h2>
      </header>
      <ul class="outcomes-list">
        {expectedOutcomes.map((item) => (
          <li class="outcome-item">
            <span class="outcome-mark" aria-hidden="true">✓</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ========== §費用と開催 ========== -->
  <section class="page-section page-section--subtle">
    <div class="page-container">
      <header class="sec-head">
        <p class="sec-kicker">費用と開催情報</p>
        <h2 class="sec-title">¥5万 / 名 × 10名定員 / 1日。</h2>
      </header>
      <div class="info-grid">
        <div class="info-card">
          <div class="info-label">参加費</div>
          <div class="info-value">¥50,000 / 名</div>
          <p class="info-note">税別 / 1日・ランチ込み・懇親会費用は別途実費</p>
        </div>
        <div class="info-card">
          <div class="info-label">定員</div>
          <div class="info-value">10名（最少催行 6名）</div>
          <p class="info-note">意図的に異業種・異規模を混ぜます</p>
        </div>
        <div class="info-card">
          <div class="info-label">開催日</div>
          <div class="info-value">2026 Q4（10〜12月）</div>
          <p class="info-note">具体日程・会場は決定次第ご案内</p>
        </div>
        <div class="info-card">
          <div class="info-label">場所</div>
          <div class="info-value">千葉県内</div>
          <p class="info-note">遠方参加者には宿泊サポート検討中</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== §Lv3講座との関係 ========== -->
  <section class="page-section">
    <div class="page-container">
      <div class="bridge-block">
        <h3 class="bridge-title">Lv3講座（¥3,000）は、本セミナーの副読本です。</h3>
        <p>
          Lv3講座は本セミナーに進む前の「頭の整理」として読む副読本として設計しています。
          原則は Lv3講座（¥3,000）で整理できますが、<strong>実装の判断は他社経営者との事例持ち寄り（本セミナー）で前進</strong>します。
        </p>
        <a class="bridge-link" href="/courses/lv3/">Lv3講座（副読本）の詳細を見る →</a>
      </div>
    </div>
  </section>

  <!-- ========== §できないこと ========== -->
  <section class="page-section page-section--subtle">
    <div class="page-container">
      <header class="sec-head">
        <p class="sec-kicker">できないこと</p>
        <h2 class="sec-title">先に「お受けしないこと」をお伝えします。</h2>
      </header>
      <ul class="cantdo-list">
        {cantDo.map((c) => (
          <li class="cantdo-card">
            <div class="cantdo-mark" aria-hidden="true">×</div>
            <h3 class="cantdo-title">{c.title}</h3>
            <p class="cantdo-body" set:html={c.body}></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ========== §FAQ ========== -->
  <section class="page-section">
    <div class="page-container">
      <header class="sec-head">
        <p class="sec-kicker">よくある質問</p>
        <h2 class="sec-title">事前にいただきやすい質問。</h2>
      </header>
      <ul class="faq-list">
        {faq.map((f, idx) => (
          <li class="faq-item">
            <details>
              <summary>
                <span class="faq-q-mark">Q{idx + 1}</span>
                <span class="faq-q-text">{f.q}</span>
                <span class="faq-toggle" aria-hidden="true">＋</span>
              </summary>
              <div class="faq-answer">
                <p set:html={f.a}></p>
              </div>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ========== §最終CTA ========== -->
  <section class="page-section page-section--warm">
    <div class="page-container final-cta">
      <h2 class="final-title">「他社経営者と1日」を、まず関心登録から。</h2>
      <p class="final-lead">
        Phase 3（2026 Q4）開催に向けて準備中です。関心登録いただいた方には、開催日程・会場・申込みフォームを優先案内します。
      </p>
      <div class="final-ctas">
        <a class="btn btn-primary btn-lg" href="/contact/">関心登録（メアドのみ）</a>
        <a class="btn btn-secondary btn-lg" href="/diagnose/">DX診断（10問・3分）</a>
        <a class="btn btn-ghost btn-lg" href="/contact/">無料個別相談</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-section {
    width: 100%;
    padding-top: var(--section-py-desktop);
    padding-bottom: var(--section-py-desktop);
  }
  .page-section--subtle { background: var(--color-bg-subtle); }
  .page-section--warm { background: var(--color-bg-warm); }
  @media (max-width: 768px) {
    .page-section { padding-top: var(--section-py-mobile); padding-bottom: var(--section-py-mobile); }
  }

  .page-container {
    max-width: var(--container-lg);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .sec-head { max-width: 720px; margin: 0 0 var(--space-8) 0; }
  .sec-kicker {
    font-family: var(--font-en);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 var(--space-3) 0;
  }
  .sec-title {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-4) 0;
  }
  .sec-lead {
    font-size: var(--text-body-lg);
    line-height: var(--leading-body-lg);
    color: var(--color-text-body);
    margin: 0;
  }
  .sec-lead strong {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    font-family: var(--font-jp);
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    transition: background-color var(--duration-hover) var(--ease-out-quint), transform var(--duration-hover) var(--ease-out-quint);
    white-space: nowrap;
  }
  .btn-lg { padding: var(--space-4) var(--space-8); font-size: var(--text-body-lg); }
  .btn-primary {
    background: var(--color-accent);
    color: #fff;
    box-shadow: var(--shadow-button);
  }
  .btn-primary:hover { background: #E55A2B; color: #fff; transform: translateY(-1px); }
  .btn-secondary {
    background: transparent;
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
  }
  .btn-secondary:hover { background: var(--color-primary); color: #fff; }
  .btn-ghost {
    background: transparent;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
  }
  .btn-ghost:hover { background: var(--color-bg-subtle); color: var(--color-text); }

  /* HERO */
  .hero { text-align: center; max-width: 880px; }
  .kicker {
    font-family: var(--font-en);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 var(--space-4) 0;
  }
  .hero-title {
    font-family: var(--font-jp-serif);
    font-size: var(--text-display);
    line-height: var(--leading-display);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-6) 0;
  }
  .hero-accent { color: var(--color-accent); }
  .hero-lead {
    font-size: var(--text-body-lg);
    line-height: var(--leading-body-lg);
    color: var(--color-text-body);
    max-width: 700px;
    margin: 0 auto var(--space-6);
  }
  .hero-lead strong { color: var(--color-text); font-weight: var(--weight-semibold); }
  .hero-meta {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }
  .hero-price {
    font-family: var(--font-en), var(--font-jp);
    font-size: var(--text-h2);
    font-weight: var(--weight-bold);
    color: var(--color-accent);
  }
  .hero-price-note,
  .hero-release {
    align-self: center;
    padding: var(--space-2) var(--space-4);
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }
  .hero-ctas { display: flex; justify-content: center; gap: var(--space-3); flex-wrap: wrap; }

  /* audience */
  .audience-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .audience-list li {
    position: relative;
    padding: var(--space-4) var(--space-4) var(--space-4) var(--space-10);
    background: var(--color-bg-warm);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-md);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-text);
  }
  .audience-list li::before {
    content: "▸";
    position: absolute;
    left: var(--space-4);
    top: var(--space-4);
    color: var(--color-accent);
    font-weight: var(--weight-bold);
  }

  /* program flow */
  .program-flow {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .flow-step {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: var(--space-6);
    align-items: flex-start;
    padding: var(--space-4) var(--space-6);
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .flow-time {
    font-family: var(--font-en);
    font-size: var(--text-h4);
    font-weight: var(--weight-bold);
    color: var(--color-accent);
    font-feature-settings: "tnum";
  }
  .flow-label {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h4);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-1) 0;
  }
  .flow-text {
    font-size: var(--text-body-sm);
    line-height: 1.7;
    color: var(--color-text-body);
    margin: 0;
  }

  /* outcomes */
  .outcomes-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .outcome-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--color-bg-warm);
    border-radius: var(--radius-md);
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--color-text);
  }
  .outcome-mark {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
  }

  /* info */
  .info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
