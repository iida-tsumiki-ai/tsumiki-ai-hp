---
/**
 * InlineIcon — 汎用インラインSVGアイコン
 * DESIGN.md §10.5 アンチパターン「絵文字をUI文字として使う」回避用。
 *
 * 置換元の絵文字:
 *   bookOpenCheck → 📖 (副読本マーク)
 *   lightbulb     → 💡 (ヒント・気づき)
 */

type IconName = "bookOpenCheck" | "lightbulb";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  ariaLabel?: string;
}

const { name, size = 24, class: className = "", ariaLabel } = Astro.props;

const labelMap: Record<IconName, string> = {
  bookOpenCheck: "副読本",
  lightbulb: "ヒント",
};
const a11yLabel = ariaLabel ?? labelMap[name];
---

{name === "bookOpenCheck" && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={`inline-icon ${className}`}
    role="img"
    aria-label={a11yLabel}
  >
    <path d="M8 3H2v15h7c1.7 0 3 1.3 3 3V7c0-2.2-1.8-4-4-4Z" />
    <path d="m16 12 2 2 4-4" />
    <path d="M22 6V3h-6c-2.2 0-4 1.8-4 4v14c0-1.7 1.3-3 3-3h7v-2.3" />
  </svg>
)}
{name === "lightbulb" && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={`inline-icon ${className}`}
    role="img"
    aria-label={a11yLabel}
  >
    <path d="M15 14c.2-1 .7-1.7 1.5-2.5C17.7 10.2 18 9 18 7.5a6 6 0 0 0-12 0c0 1.5.3 2.7 1.5 4 .8.8 1.3 1.5 1.5 2.5" />
    <path d="M9 18h6" />
    <path d="M10 22h4" />
  </svg>
)}
