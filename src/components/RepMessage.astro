---
/**
 * RepMessage — ホーム §5「代表メッセージ（エピソード型）」
 * 設計書: 11_HPリニューアル_設計書.md §1 §5（D案で FAQ 前に前倒し）
 * 素材: 01_マーケティング/エピソード集_20260424_代表タケ.md（I1 成果物）
 *
 * 目的:
 *   - 誠実さ②「エピソードで輪郭を作る」の実装
 *   - 数字や役職ではなく"語り"で信頼を構築
 *   - ① 動機 → ② 業界知見 → ③ 地域密着 → ④ 失敗体験 の順で読み手の信頼ステップを上げる
 */

type Episode = {
  label: string;
  kicker: string;
  body: string;
};

const episodes: Episode[] = [
  {
    label: "① 動機",
    kicker: "中小企業が後回しにされがちな社会",
    body: "日本の会社数の9割、働く人の7割が中小企業にいます。それなのに、世の中の仕組みは大企業向けにできていて、中小企業の現場は後回しにされがち。弥生で中小企業のリアルを調べていた6年間で、この違和感がずっと頭にありました。独立したのは、この状況を少しでも変えたかったからです。",
  },
  {
    label: "② 業界知見",
    kicker: "法改正と現場のギャップ",
    body: "弥生ではインボイス制度・電帳法の製品対応を指揮しました。どちらも「難しい法改正だな」と身構えたのを覚えています。制度は始まっても、中小企業の現場はまだ追いついていない会社がたくさんある。制度を作る側と現場の間に、誰かが立つ必要があると感じています。",
  },
  {
    label: "③ 地域密着",
    kicker: "「IT化しないと困る」という発想が、そもそもない",
    body: "千葉に戻って地域の経営者と話すと、クラウド化していない会社がまだまだ多い。特に小規模になるほどその傾向は強いです。でもそれは怠慢ではなく、「IT化していないことで困る」という発想自体がない、というのが本当のところ。だから押し売りはしない。困りごとを一緒に言語化するところから始めます。",
  },
  {
    label: "④ 失敗体験",
    kicker: "EC経営で痛感した「手作業の壁」",
    body: "独立前にEC事業をやっていました。仕入れは市場相場で決まるので、ダイレクト買付しないと利益が出ない。送料込みで赤字になることもあって、仕入れ・梱包・発送はすべて手作業。商品の大きさが違うだけで手順が崩れる。この体験があるから、「AIで効率化」の話をする時に現場の感覚を持って話せます。効率化は想像より遥かに大変です。",
  },
];
---

<div class="rep-block">
  <header class="rep-head">
    <p class="kicker">§5 代表メッセージ</p>
    <h2 class="rep-title">数字ではなく、場面で語ります。</h2>
  </header>

  <article class="rep-article">
    <aside class="rep-profile">
      <figure class="rep-photo">
        <img
          src="/images/rep-interview.jpg"
          alt="ツミキAI代表 飯田武之（タケ）"
          width="360"
          height="480"
          loading="lazy"
        />
      </figure>
      <div class="rep-profile-meta">
        <p class="rep-name">
          飯田 武之 <span class="rep-nickname">（タケ）</span>
        </p>
        <p class="rep-role">ツミキAI 代表</p>
        <ul class="rep-credentials">
          <li>自治体・金融 SI 6年（PM）</li>
          <li>弥生株式会社 6年（複数プロダクト責任者 / インボイス・電帳法対応指揮）</li>
          <li>EC事業経営 を経て独立</li>
          <li>千葉県印西市拠点</li>
        </ul>
        <a class="rep-more" href="/about/">会社情報を詳しく見る →</a>
      </div>
    </aside>

    <div class="rep-stories">
      {
        episodes.map((ep) => (
          <section class="rep-story">
            <p class="rep-story-label">{ep.label}</p>
            <h3 class="rep-story-kicker">{ep.kicker}</h3>
            <p class="rep-story-body">{ep.body}</p>
          </section>
        ))
      }
    </div>
  </article>
</div>

<style>
  .rep-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* Head */
  .rep-head {
    max-width: 720px;
  }
  .kicker {
    font-family: var(--font-en);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 var(--space-3) 0;
  }
  .rep-title {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-heading);
    color: var(--color-text);
    margin: 0;
  }

  /* Article Layout: photo + stories side-by-side (desktop) */
  .rep-article {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  /* Profile column */
  .rep-profile {
    position: sticky;
    top: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .rep-photo {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: var(--color-bg-subtle);
    aspect-ratio: 3 / 4;
  }
  .rep-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .rep-profile-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .rep-name {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin: 0;
    line-height: 1.3;
  }
  .rep-nickname {
    font-family: var(--font-jp);
    font-size: var(--text-body);
    font-weight: var(--weight-regular);
    color: var(--color-text-muted);
    margin-left: var(--space-2);
  }
  .rep-role {
    font-family: var(--font-jp);
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
    margin: 0;
  }
  .rep-credentials {
    list-style: none;
    padding: var(--space-4) 0 0 0;
    margin: 0;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .rep-credentials li {
    position: relative;
    padding-left: var(--space-4);
    font-size: var(--text-body-sm);
    line-height: 1.55;
    color: var(--color-text-body);
  }
  .rep-credentials li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    background: var(--color-accent);
    border-radius: 1px;
  }
  .rep-more {
    margin-top: var(--space-3);
    font-family: var(--font-jp);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    text-decoration: none;
  }
  .rep-more:hover {
    color: var(--color-primary-hover);
  }

  /* Stories column */
  .rep-stories {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  .rep-story {
    position: relative;
    padding-left: var(--space-6);
    border-left: 2px solid var(--color-border);
  }
  .rep-story::before {
    content: "";
    position: absolute;
    left: -7px;
    top: 0;
    width: 12px;
    height: 12px;
    background: var(--color-accent);
    border-radius: 2px;
  }
  .rep-story-label {
    font-family: var(--font-en);
    font-size: var(--text-caption);
    font-weight: var(--weight-bold);
    color: var(--color-accent);
    letter-spacing: 0.08em;
    margin: 0 0 var(--space-2) 0;
  }
  .rep-story-kicker {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-4) 0;
  }
  .rep-story-body {
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-text-body);
    margin: 0;
  }

  /* ========================================
   * Responsive
   * ======================================== */
  @media (max-width: 1023px) {
    .rep-article {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .rep-profile {
      position: static;
      flex-direction: row;
      gap: var(--space-6);
      align-items: center;
    }
    .rep-photo {
      flex-shrink: 0;
      width: 180px;
    }
    .rep-profile-meta {
      flex: 1;
    }
  }

  @media (max-width: 640px) {
    .rep-title {
      font-size: var(--text-h2);
    }
    .rep-profile {
      flex-direction: column;
      align-items: flex-start;
    }
    .rep-photo {
      width: 160px;
    }
    .rep-story-kicker {
      font-size: var(--text-h4);
    }
  }
</style>
