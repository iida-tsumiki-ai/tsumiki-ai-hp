---
/**
 * /privacy/ — プライバシーポリシー
 * 取得元: 現行 https://tsumiki.ai/privacy/ の構成に揃える（2026-05-03 同期）。
 */
import Layout from "../../layouts/Layout.astro";

const sections = [
  {
    no: "1",
    title: "事業者情報",
    body: `
      <p>本ポリシーは、ツミキAI（代表: 飯田武之 / 千葉県印西市）が運営するウェブサイト <a href="https://tsumiki.ai/">https://tsumiki.ai/</a> および同事業が提供するサービス（以下「本サービス」）における、お客様の個人情報の取り扱いを定めるものです。</p>
    `,
  },
  {
    no: "2",
    title: "取得する個人情報",
    body: `
      <p>本サービスでは、お問い合わせフォーム等を通じて以下の情報を取得することがあります。</p>
      <ul>
        <li>お名前</li>
        <li>メールアドレス</li>
        <li>電話番号</li>
        <li>会社名</li>
        <li>お問い合わせ内容</li>
      </ul>
    `,
  },
  {
    no: "3",
    title: "利用目的",
    body: `
      <p>取得した個人情報は、以下の目的で利用します。</p>
      <ul>
        <li>お問い合わせへのご回答や情報提供</li>
        <li>ご相談内容に関するサポートやフォローアップ</li>
      </ul>
    `,
  },
  {
    no: "4",
    title: "第三者提供",
    body: `
      <p>お客様の同意がある場合、または法令に基づく場合を除き、取得した個人情報を第三者に開示・提供することはありません。</p>
    `,
  },
  {
    no: "5",
    title: "セキュリティ対策",
    body: `
      <p>個人情報の紛失・破壊・改ざん、および不正アクセスのリスクを防ぐため、適切なセキュリティ対策を実施しています。</p>
    `,
  },
  {
    no: "6",
    title: "アクセスログについて",
    body: `
      <p>本サービスではアクセスログを取得していますが、これらは個人を特定する情報を含まず、統計的な利用状況の把握のみに使用します。</p>
    `,
  },
  {
    no: "7",
    title: "ポリシーの変更",
    body: `
      <p>本ポリシーは、必要に応じて改定することがあります。改定後の内容はウェブサイト上で告知します。</p>
    `,
  },
  {
    no: "8",
    title: "お問い合わせ窓口",
    body: `
      <p>本ポリシーに関するお問い合わせは、下記までご連絡ください。</p>
      <ul class="contact-info">
        <li><strong>事業者名</strong>：ツミキAI</li>
        <li><strong>代表</strong>：飯田武之</li>
        <li><strong>所在地</strong>：千葉県印西市</li>
        <li><strong>連絡先</strong>：<a href="mailto:iida@tsumiki.ai">iida@tsumiki.ai</a></li>
      </ul>
    `,
  },
];

const lastUpdated = "2026-05-03";
---

<Layout
  title="プライバシーポリシー — ツミキAI"
  description="ツミキAI のプライバシーポリシー。個人情報の取得・利用目的・第三者提供・開示請求・お問い合わせ窓口について。"
>
  <!-- ========== §HERO ========== -->
  <section class="page-section page-section--warm">
    <div class="page-container hero">
      <p class="kicker">Privacy Policy</p>
      <h1 class="hero-title">プライバシーポリシー</h1>
      <p class="hero-lead">
        ツミキAI（代表: 飯田武之）が運営する本サービスにおける、個人情報の取り扱いを定めます。
      </p>
      <p class="hero-meta">最終更新日: {lastUpdated}</p>
    </div>
  </section>

  <!-- ========== §本文 ========== -->
  <section class="page-section">
    <div class="page-container policy-container">
      {sections.map((s) => (
        <article class="policy-section">
          <h2 class="policy-no">第{s.no}条　{s.title}</h2>
          <div class="policy-body" set:html={s.body}></div>
        </article>
      ))}
    </div>
  </section>

  <!-- ========== §戻る ========== -->
  <section class="page-section page-section--subtle">
    <div class="page-container back-cta">
      <a class="btn btn-secondary" href="/">トップに戻る</a>
      <a class="btn btn-secondary" href="/contact/">お問い合わせ</a>
    </div>
  </section>
</Layout>

<style>
  .page-section {
    width: 100%;
    padding-top: var(--section-py-desktop);
    padding-bottom: var(--section-py-desktop);
  }
  .page-section--subtle { background: var(--color-bg-subtle); }
  .page-section--warm { background: var(--color-bg-warm); }
  @media (max-width: 768px) {
    .page-section { padding-top: var(--section-py-mobile); padding-bottom: var(--section-py-mobile); }
  }

  .page-container {
    max-width: var(--container-lg);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .policy-container {
    max-width: 880px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    font-family: var(--font-jp);
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    transition: background-color var(--duration-hover) var(--ease-out-quint);
    white-space: nowrap;
  }
  .btn-secondary {
    background: transparent;
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
  }
  .btn-secondary:hover { background: var(--color-primary); color: #fff; }

  /* HERO */
  .hero { text-align: center; max-width: 720px; }
  .kicker {
    font-family: var(--font-en);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 var(--space-4) 0;
  }
  .hero-title {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-4) 0;
  }
  .hero-lead {
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-text-body);
    margin: 0 0 var(--space-3) 0;
  }
  .hero-meta {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    margin: 0;
  }

  /* policy */
  .policy-section {
    margin-bottom: var(--space-8);
  }
  .policy-section:last-child { margin-bottom: 0; }
  .policy-no {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-4) 0;
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-primary);
  }
  .policy-body {
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-text-body);
  }
  .policy-body :global(p) {
    margin: 0 0 var(--space-3) 0;
  }
  .policy-body :global(p:last-child) {
    margin-bottom: 0;
  }
  .policy-body :global(ul) {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-3) 0;
  }
  .policy-body :global(li) {
    position: relative;
    padding: var(--space-2) 0 var(--space-2) var(--space-6);
    line-height: 1.7;
  }
  .policy-body :global(li::before) {
    content: "▸";
    position: absolute;
    left: 0;
    top: var(--space-2);
    color: var(--color-primary);
  }
  .policy-body :global(strong) {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }
  .policy-body :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    font-weight: var(--weight-semibold);
  }
  .policy-body :global(a:hover) { text-decoration: underline; }
  .policy-body :global(.contact-info) {
    background: var(--color-bg-warm);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-6);
  }
  .policy-body :global(.contact-info li) {
    padding-left: 0;
  }
  .policy-body :global(.contact-info li::before) {
    display: none;
  }

  .back-cta {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .hero-title { font-size: var(--text-h2); }
    .policy-no { font-size: var(--text-h4); }
  }
</style>
