---
/**
 * CategoryIcon — 3カテゴリ（A/B/C）共通アイコン
 * DESIGN.md §10.5 アンチパターン「絵文字をUI文字として使う」回避用。
 * Lucide v0.x の BookOpen / Users / Handshake を 24x24 / stroke 1.5px で実装。
 *
 * 置換元の絵文字:
 *   A → 👨‍💼 (BookOpen)
 *   B → 👥 (Users)
 *   C → 🤝 (Handshake)
 */

interface Props {
  category: "A" | "B" | "C";
  size?: number;
  class?: string;
  ariaLabel?: string;
}

const { category, size = 24, class: className = "", ariaLabel } = Astro.props;

const labelMap = {
  A: "経営者が先に学ぶ",
  B: "組織に入れる",
  C: "一緒に実行する",
};

const a11yLabel = ariaLabel ?? labelMap[category];
---

{category === "A" && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={`category-icon ${className}`}
    role="img"
    aria-label={a11yLabel}
  >
    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
    <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
  </svg>
)}
{category === "B" && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={`category-icon ${className}`}
    role="img"
    aria-label={a11yLabel}
  >
    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
    <circle cx="9" cy="7" r="4" />
    <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
  </svg>
)}
{category === "C" && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={`category-icon ${className}`}
    role="img"
    aria-label={a11yLabel}
  >
    <path d="m11 17 2 2a1 1 0 1 0 3-3" />
    <path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4" />
    <path d="m21 3 1 11h-2" />
    <path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3" />
    <path d="M3 4h8" />
  </svg>
)}
