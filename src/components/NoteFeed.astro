---
/**
 * NoteFeed — ホーム §7「note最新記事ブロック」（★新設 2026-04-23）
 * 設計書: 11_HPリニューアル_設計書.md §1 §7 / B5 タスク
 *
 * 目的:
 *   - Phase 2 以降の note 公開が始まる時点から即効果が出る導線
 *   - POSTS 東京の Insight 型レイアウトを参照
 *   - ロードマップ講座（無料note）への誘導補強
 *
 * NOTE: 現時点は **ダミー記事** を3本配置。Phase 2 開始後に note RSS 連動（または手動差し替え）で本記事化。
 */

type Article = {
  title: string;
  excerpt: string;
  category: string;
  publishedAt: string;
  href: string;
  readingTime?: string;
};

const articles: Article[] = [
  {
    title: "中小企業のDX → AI駆動経営、4ステージで上る道筋",
    excerpt:
      "AI駆動経営診断の結果から、自社がLv1〜Lv4のどこにいるかを把握できます。ロードマップ講座のダイジェスト版として、4ステージの輪郭を2,000字で解説しています。",
    category: "ロードマップ",
    publishedAt: "Coming soon",
    href: "/courses/roadmap/",
    readingTime: "8分",
  },
  {
    title: "AI活用が進まない会社に共通する、3つのつまずき",
    excerpt:
      "ツールを導入したのに使われません。個人では使えるのに全社展開できません。そんな詰まりポイントを、弥生6年＋現場観察から整理しています。",
    category: "現場ノート",
    publishedAt: "Coming soon",
    href: "#",
    readingTime: "6分",
  },
  {
    title: "EC経営で痛感した「業務を流れに繋ぐ難しさ」",
    excerpt:
      "独立前のEC経営で痛感したのは、個別作業ではなく業務を一連の流れに繋ぐ難しさでした。AI効率化が万能に見えてしまう経営者に、最初に話す4つのことをまとめています。",
    category: "失敗談",
    publishedAt: "Coming soon",
    href: "#",
    readingTime: "7分",
  },
];
---

<div class="note-block">
  <header class="note-head">
    <div class="note-head-left">
      <p class="kicker">noteで発信している最新の知見</p>
      <h2 class="note-title">note で現場の話を続けています。</h2>
      <p class="note-lead">
        制度と現場の間にあるギャップ、AI効率化の現実、経営者の判断材料を扱います。
        売り込みではない、業界の共通言語としての記事を更新していきます。
      </p>
    </div>
    <a class="note-follow" href="https://note.com/tsumiki_ai" target="_blank" rel="noopener noreferrer">
      note をフォロー →
    </a>
  </header>

  <ul class="note-grid">
    {
      articles.map((a) => (
        <li class="note-card">
          <a class="note-card-link" href={a.href}>
            <div class="note-card-meta">
              <span class="note-category">{a.category}</span>
              <span class="note-date">{a.publishedAt}</span>
            </div>
            <h3 class="note-card-title">{a.title}</h3>
            <p class="note-card-excerpt">{a.excerpt}</p>
            <div class="note-card-foot">
              {a.readingTime && <span class="note-reading">読了 {a.readingTime}</span>}
              <span class="note-more" aria-hidden="true">
                続きを読む →
              </span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>

  <p class="note-note">
    ※ ダミー記事（Coming soon）。Phase 2（2026 Q3〜）から本記事を順次公開予定。
  </p>
</div>

<style>
  .note-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* Head */
  .note-head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: var(--space-6);
  }
  .note-head-left {
    max-width: 720px;
  }
  .kicker {
    font-family: var(--font-en);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 var(--space-3) 0;
  }
  .note-title {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-heading);
    color: var(--color-text);
    margin: 0 0 var(--space-4) 0;
  }
  .note-lead {
    font-size: var(--text-body-lg);
    line-height: var(--leading-body-lg);
    color: var(--color-text-body);
    margin: 0;
  }
  .note-follow {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    background: var(--color-bg);
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-full);
    font-family: var(--font-jp);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    transition: all var(--duration-hover) var(--ease-out-quint);
    white-space: nowrap;
  }
  .note-follow:hover {
    background: var(--color-primary);
    color: #fff;
  }

  /* Grid */
  .note-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .note-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition:
      box-shadow var(--duration-hover) var(--ease-out-quint),
      transform var(--duration-hover) var(--ease-out-quint);
  }
  .note-card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .note-card-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .note-card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--text-caption);
  }
  .note-category {
    display: inline-block;
    padding: 2px var(--space-3);
    background: var(--color-accent-soft);
    color: #B84A1E;
    border-radius: var(--radius-full);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
  }
  .note-date {
    font-family: var(--font-en);
    color: var(--color-text-muted);
  }

  .note-card-title {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h4);
    line-height: 1.4;
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    margin: 0;
  }
  .note-card-excerpt {
    font-size: var(--text-body-sm);
    line-height: 1.65;
    color: var(--color-text-body);
    margin: 0;
    flex-grow: 1;
  }
  .note-card-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-caption);
  }
  .note-reading {
    color: var(--color-text-muted);
  }
  .note-more {
    color: var(--color-primary);
    font-weight: var(--weight-semibold);
  }

  .note-note {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    text-align: center;
    margin: 0;
  }

  /* ========================================
   * Responsive
   * ======================================== */
  @media (max-width: 1023px) {
    .note-grid {
      grid-template-columns: 1fr 1fr;
    }
    .note-head {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }

  @media (max-width: 640px) {
    .note-title {
      font-size: var(--text-h2);
    }
    .note-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
