---
/**
 * Hero — ホーム §1「HERO」本実装
 * 設計書: 11_HPリニューアル_設計書.md §1 §1 / DESIGN.md §1 積み木モチーフ
 *
 * 要素:
 *   - 大見出し（ブランドストーリーの一行）
 *   - サブ（"中小企業のAIネイティブ化を伴走"）
 *   - ダブルCTA（無料DX診断 / 無料個別相談）
 *   - 右側に積み木ビジュアル（4ブロックを段々に積む / SVG＋CSS animation）
 *
 * デザイン方針（DESIGN.md §1 / §10.5）:
 *   - 青紫グラデは禁止
 *   - オレンジ大面積禁止（積み木は accent-soft 優位）
 *   - 見出しは明朝（Shippori Mincho）
 */
---

<div class="hero-block">
  <div class="hero-content">
    <p class="kicker">ツミキAI — 中小企業のAI伴走</p>
    <h1 class="hero-title">
      小さく始めて、<br />
      一つずつ積み上げる。
    </h1>
    <p class="hero-lead">
      ツミキAIは、中小企業がAIを「当たり前のツール」にするための伴走者です。<br />
      診断で<strong>現在地</strong>がわかり、<strong>作って終わる</strong>。そして<strong>卒業できる</strong>。
    </p>

    <div class="hero-cta-row">
      <a class="hero-cta hero-cta--primary" href="/diagnose/">
        <span class="hero-cta-level">L1 / 0円</span>
        <span class="hero-cta-label">無料DX診断を受ける</span>
      </a>
      <a class="hero-cta hero-cta--secondary" href="/contact/">
        <span class="hero-cta-level">L3 / 無料</span>
        <span class="hero-cta-label">個別相談で話す</span>
      </a>
    </div>

    <p class="hero-footnote">
      240万社規模のインフラ品質 × AI活用スピードで、千葉から中小企業の現場を変える。
    </p>
  </div>

  <div class="hero-visual" aria-hidden="true">
    <div class="stack">
      <div class="block block--4">
        <span class="block-label">❹ AIネイティブ</span>
      </div>
      <div class="block block--3">
        <span class="block-label">❸ 戦略を描く</span>
      </div>
      <div class="block block--2">
        <span class="block-label">❷ 活用を広げる</span>
      </div>
      <div class="block block--1">
        <span class="block-label">❶ 現在地を知る</span>
      </div>
    </div>
  </div>
</div>

<style>
  .hero-block {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-16);
    align-items: center;
    min-height: 520px;
  }

  /* Content */
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .kicker {
    font-family: var(--font-en);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
  }
  .hero-title {
    font-family: var(--font-jp-serif);
    font-size: var(--text-display);
    line-height: var(--leading-display);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-heading);
    color: var(--color-text);
    margin: 0;
  }
  .hero-lead {
    font-size: var(--text-body-lg);
    line-height: var(--leading-body-lg);
    color: var(--color-text-body);
    margin: 0;
  }
  .hero-lead strong {
    color: var(--color-text);
    font-weight: var(--weight-bold);
  }

  /* CTA */
  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }
  .hero-cta {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-md);
    text-decoration: none;
    box-shadow: var(--shadow-button);
    transition:
      transform var(--duration-hover) var(--ease-out-quint),
      box-shadow var(--duration-hover) var(--ease-out-quint);
  }
  .hero-cta:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .hero-cta--primary {
    background: var(--color-primary);
    color: #fff;
  }
  .hero-cta--primary:hover {
    color: #fff;
  }
  .hero-cta--secondary {
    background: #fff;
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
  }
  .hero-cta-level {
    font-family: var(--font-en);
    font-size: 11px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.05em;
    opacity: 0.8;
  }
  .hero-cta-label {
    font-family: var(--font-jp);
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
  }

  .hero-footnote {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    margin: 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  /* ========================================
   * Visual — 積み木を段々に積むイラスト
   * DESIGN.md §1 工芸品モチーフ / §5「積み木」表現
   * ======================================== */
  .hero-visual {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: var(--space-8);
  }
  .stack {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    width: 100%;
    max-width: 420px;
    animation: stack-reveal var(--duration-reveal) var(--ease-out-quint) both;
  }
  .block {
    display: flex;
    align-items: center;
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-md);
    font-family: var(--font-jp-serif);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    box-shadow: var(--shadow-sm);
    animation: block-in var(--duration-reveal) var(--ease-out-quint) both;
  }
  .block-label {
    font-size: var(--text-body);
  }
  .block--1 {
    width: 96%;
    background: var(--color-bg-warm);
    border: 1px solid var(--color-border);
    animation-delay: 0ms;
  }
  .block--2 {
    width: 78%;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    margin-left: var(--space-6);
    animation-delay: 120ms;
  }
  .block--3 {
    width: 62%;
    background: var(--color-accent-soft);
    color: #B84A1E;
    margin-left: var(--space-12);
    animation-delay: 240ms;
  }
  .block--4 {
    width: 44%;
    background: var(--color-primary);
    color: #fff;
    margin-left: var(--space-16);
    animation-delay: 360ms;
    box-shadow: var(--shadow-md);
  }

  @keyframes stack-reveal {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes block-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ========================================
   * Responsive
   * ======================================== */
  @media (max-width: 1023px) {
    .hero-block {
      grid-template-columns: 1fr;
      gap: var(--space-8);
      min-height: auto;
    }
    .hero-visual {
      padding: 0;
    }
    .stack {
      max-width: 100%;
    }
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: var(--text-h1);
    }
    .block--1 {
      width: 100%;
    }
    .block--2 {
      width: 85%;
      margin-left: var(--space-4);
    }
    .block--3 {
      width: 70%;
      margin-left: var(--space-8);
    }
    .block--4 {
      width: 55%;
      margin-left: var(--space-12);
    }
  }
</style>
