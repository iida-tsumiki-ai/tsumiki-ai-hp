---
/**
 * ThumbnailCard — note 記事サムネ画像（1280×670 / 1.91:1）
 *
 * 設計書: 03_デザイン・アセット/試作/thumbnail_template.html を Astro 化したもの。
 * 6 バリアント（roadmap / roadmap-v2 / lv1 / lv2 / lv3 / lv4）を `variant` prop で切替。
 *
 * 使い方:
 *   <ThumbnailCard variant="lv1" />
 *
 * バリアント定義: src/data/thumbnails.ts
 */
import { thumbnailConfigs, type ThumbnailVariant } from "../data/thumbnails.ts";

interface Props {
  variant: ThumbnailVariant;
}

const { variant } = Astro.props;
const cfg = thumbnailConfigs[variant];
const isPunch = cfg.variantStyle === "punch";
---

<div class:list={["thumbnail", { "is-punch": isPunch }]}>
  <!-- LEFT: テキスト -->
  <div class="text-col">
    <span class="series-badge">
      <img
        class="series-badge-icon"
        src="/images/symbol-on-navy-v2.png"
        alt=""
        aria-hidden="true"
      />
      ツミキAI 経営者講座
    </span>
    <p class="level-label">{cfg.levelLabel}</p>
    {cfg.punchPre && <p class="punch-pre" set:html={cfg.punchPre} />}
    <h1 class="main-title" set:html={cfg.title} />
    <p class="sub-title">{cfg.subtitle}</p>
  </div>

  <!-- RIGHT: 積み木4段（Lv4が上、Lv1が下） — Hero / og-default と同じ階段スタック -->
  <div class="blocks-col" aria-hidden="true">
    <div class="stack">
      <div class:list={["block", "block--4", { faded: cfg.blocks[0] === "faded", overview: cfg.blocks[0] === "overview" }]}>
        <span class="block-num">04</span>
        <span class="block-name">AI駆動経営</span>
      </div>
      <div class:list={["block", "block--3", { faded: cfg.blocks[1] === "faded", overview: cfg.blocks[1] === "overview" }]}>
        <span class="block-num">03</span>
        <span class="block-name">戦略を描く</span>
      </div>
      <div class:list={["block", "block--2", { faded: cfg.blocks[2] === "faded", overview: cfg.blocks[2] === "overview" }]}>
        <span class="block-num">02</span>
        <span class="block-name">活用を広げる</span>
      </div>
      <div class:list={["block", "block--1", { faded: cfg.blocks[3] === "faded", overview: cfg.blocks[3] === "overview" }]}>
        <span class="block-num">01</span>
        <span class="block-name">土台を組む</span>
      </div>
      <div class="stack-base"></div>
    </div>
  </div>

  <!-- BOTTOM: ロゴ＋メタ情報 -->
  <div class="bottom-strip">
    <p class="strip-meta"><strong>{cfg.stripMeta}</strong></p>
    <div class="strip-logo">
      <img
        class="strip-logo-img"
        src="/images/logo-white-on-navy-v2.png"
        alt="ツミキAI"
      />
    </div>
  </div>
</div>

<style>
  /* DESIGN.md トークンと共有（tokens.css は呼び出し側で読み込み済み前提） */
  :root {
    --strip-h: 72px;
  }

  .thumbnail {
    width: 1280px;
    height: 670px;
    position: relative;
    overflow: hidden;
    background: var(--color-bg-warm);
    box-shadow: 0 8px 32px rgba(26, 58, 95, 0.18);
    display: flex;
    flex-direction: row;
  }

  /* ===== LEFT カラム（65%） ===== */
  .text-col {
    flex: 0 0 65%;
    padding: 52px 40px calc(var(--strip-h) + 24px) 72px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
  }

  .series-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--color-primary);
    color: #fff;
    padding: 8px 18px;
    border-radius: 999px;
    font-family: var(--font-jp);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: 0.05em;
    width: fit-content;
  }
  .series-badge-icon {
    width: 28px;
    height: 28px;
    object-fit: contain;
    border-radius: 4px;
  }

  .level-label {
    font-family: var(--font-en);
    font-weight: 800;
    font-size: 24px;
    color: var(--color-accent);
    letter-spacing: 0.06em;
    display: flex;
    align-items: center;
    gap: 14px;
    line-height: 1;
    margin: 0;
  }
  .level-label::before {
    content: "";
    display: block;
    width: 40px;
    height: 5px;
    background: var(--color-accent);
    border-radius: 3px;
    flex-shrink: 0;
  }

  .main-title {
    font-family: var(--font-jp-serif);
    font-weight: 700;
    font-size: 84px;
    line-height: 1.18;
    color: var(--color-primary);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .sub-title {
    font-family: var(--font-jp);
    font-weight: 500;
    font-size: 28px;
    line-height: 1.6;
    color: var(--color-text-body);
    margin: 0;
  }

  /* ===== punch バリアント（roadmap-v2）専用 ===== */
  .thumbnail.is-punch .punch-pre {
    font-family: var(--font-jp-serif);
    font-weight: 600;
    font-size: 38px;
    line-height: 1.4;
    color: var(--color-text-body);
    letter-spacing: -0.01em;
    margin: 0 0 -4px 0;
  }
  .thumbnail.is-punch .main-title {
    font-size: 76px;
    line-height: 1.18;
  }
  .punch-pre :global(.punch-emph) {
    color: var(--color-accent);
    font-weight: 700;
  }
  .main-title :global(.hl) {
    background: linear-gradient(transparent 65%, var(--color-accent-soft) 65%);
    padding: 0 4px;
  }

  /* ===== RIGHT カラム（35%）＝ Hero / og-default と同じ階段スタック ===== */
  .blocks-col {
    flex: 0 0 35%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 40px 28px calc(var(--strip-h) + 24px) 8px;
  }
  .stack {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    width: 100%;
    max-width: 420px;
  }
  .stack-base {
    align-self: stretch;
    height: 14px;
    margin-top: 6px;
    background: radial-gradient(
      ellipse 60% 100% at 50% 0%,
      rgba(26, 58, 95, 0.18) 0%,
      transparent 70%
    );
  }
  .block {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 22px;
    border-radius: var(--radius-md);
    color: var(--color-text);
    background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.12) 0%, transparent 30%);
    box-shadow: var(--shadow-sm);
    transition: opacity var(--duration-hover, 200ms) var(--ease-out-quint, cubic-bezier(0.22, 1, 0.36, 1));
  }
  /* 立体感（側面影） */
  .block::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--block-side, rgba(26, 58, 95, 0.14));
    transform: translate(5px, 7px);
    z-index: -1;
  }
  .block-num {
    font-family: var(--font-en);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.06em;
    color: inherit;
    opacity: 0.65;
  }
  .block-name {
    font-family: var(--font-jp-serif);
    font-weight: 600;
    font-size: 19px;
    white-space: nowrap;
  }

  /* 各レベルの見た目 */
  .block--1 {
    width: 96%;
    background: var(--color-bg-warm);
    border: 1px solid var(--color-border);
    --block-side: #E8DFCE;
  }
  .block--2 {
    width: 78%;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    margin-left: 28px;
    --block-side: #DCD7C9;
  }
  .block--3 {
    width: 62%;
    background: var(--color-accent-soft);
    color: #B84A1E;
    margin-left: 56px;
    --block-side: #F4C5A4;
  }
  .block--4 {
    width: 44%;
    background: var(--color-primary);
    color: #fff;
    margin-left: 84px;
    box-shadow: var(--shadow-md);
    --block-side: #102845;
  }

  /* 状態: faded（未到達 / 例: Lv1 講座での Lv2-Lv4） */
  .block.faded {
    opacity: 0.28;
  }
  .block.faded::after {
    opacity: 0.4;
  }

  /* 状態: overview（roadmap 用 / 全段を控えめに表示） */
  .block.overview {
    opacity: 0.7;
  }

  /* ===== BOTTOM ストリップ ===== */
  .bottom-strip {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: var(--strip-h);
    background: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 64px;
  }
  .strip-meta {
    font-family: var(--font-jp);
    font-size: 18px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.75);
    letter-spacing: 0.03em;
    margin: 0;
  }
  .strip-meta strong {
    color: #fff;
    font-weight: 700;
  }
  .strip-logo {
    display: flex;
    align-items: center;
  }
  .strip-logo-img {
    display: block;
    height: 48px;
    width: auto;
    object-fit: contain;
  }
</style>
