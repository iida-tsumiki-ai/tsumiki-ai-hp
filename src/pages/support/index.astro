---
/**
 * /support/ — AI駆動経営伴走支援 LP（主力 / カテゴリC）
 *
 * 実装方針:
 *   - 11_HPリニューアル_設計書.md §5 ワイヤー（2026-04-27 同期版）に準拠
 *   - 2026-04-28 案α: C列は Lv1-Lv4 を1サービスでカバー（旧4商品統合）
 *   - 3プラン構造（ライト/スタンダード/プレミアム）を価格セクションに反映（2026-04-28 user 提示）
 *   - ブランド言語: 1段ずつ着実に / 自走モデル / 実務を通して作る / DX→AI連続体
 *
 * セクション構成:
 *   §HERO → §1 本質3点 → §2 4フェーズ Flow → §3 Lv別の進め方 →
 *   §4 3プラン比較 → §5 自走事例（スタブ） → §6 OBコミュニティ →
 *   §7 できないこと → §8 最終CTA
 */
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";

const phases = [
  {
