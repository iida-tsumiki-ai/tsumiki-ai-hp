---
/**
 * PriceTierChart — ホーム §2.5「4ステージ × 価格帯 帯グラフ」
 * 設計書: 11_HPリニューアル_設計書.md §1 §2.5（2026-04-23 新設）
 *
 * 目的:
 *   - 誠実さ①「情報の非対称性を自ら解消」（DESIGN.md ブランド哲学）の視覚装置
 *   - 経営者が"自分の該当ゾーン"を横軸（ステージ）×縦軸（価格帯）で即特定できる
 *   - ¥3,000〜月30万（100倍レンジ）の萎縮を緩和する
 *
 * 実装:
 *   - 縦軸: 5価格帯（無料 / ¥3,000 / 中価格 / 伴走 / スポット）
 *   - 横軸: 4ステージ（Lv1 / Lv2 / Lv3 / Lv4）
 *   - 各商品は帯の span として配置（grid-column span）
 */

type Tier = {
  id: string;
  label: string;
  priceRange: string;
  bars: Bar[];
};

type Bar = {
  label: string;
  sublabel?: string;
  stageStart: 1 | 2 | 3 | 4;
  stageEnd: 1 | 2 | 3 | 4;
  variant: "free" | "low" | "mid" | "support" | "spot" | "flagship";
  isFlagship?: boolean;
  href?: string;
};

const tiers: Tier[] = [
  {
    id: "free",
    label: "無料帯",
    priceRange: "¥0",
    bars: [
      {
        label: "ロードマップ講座",
        sublabel: "全Lv共通の地図",
        stageStart: 1,
        stageEnd: 4,
        variant: "free",
        href: "/courses/roadmap/",
      },
    ],
  },
  {
    id: "low",
    label: "低価格帯",
    priceRange: "¥3,000",
    bars: [
      {
        label: "Lv1講座",
        sublabel: "★主力 / GWS・MS365版",
        stageStart: 1,
        stageEnd: 1,
        variant: "flagship",
        isFlagship: true,
        href: "/courses/lv1/",
      },
      {
        label: "Lv2講座",
        sublabel: "GWS・MS365版",
        stageStart: 2,
        stageEnd: 2,
        variant: "low",
        href: "/courses/lv2/",
      },
      {
        label: "Lv3講座",
        sublabel: "共通版・副読本",
        stageStart: 3,
        stageEnd: 3,
        variant: "low",
        href: "/courses/lv3/",
      },
      {
        label: "Lv4講座",
        sublabel: "共通版・事例集",
        stageStart: 4,
        stageEnd: 4,
        variant: "low",
        href: "/courses/lv4/",
      },
    ],
  },
  {
    id: "mid",
    label: "中価格帯（研修）",
    priceRange: "¥10〜25万",
    bars: [
      {
        label: "❶入門コース",
        sublabel: "半日 / ¥10万",
        stageStart: 1,
        stageEnd: 1,
        variant: "mid",
        href: "/training/#stage1-training",
      },
      {
        label: "❷実践コース",
        sublabel: "1日 / ¥25万",
        stageStart: 2,
        stageEnd: 2,
        variant: "mid",
        href: "/training/#stage2-training",
      },
    ],
  },
  {
    id: "support",
    label: "伴走",
    priceRange: "月 ¥20万〜",
    bars: [
      {
        label: "❶初期導入伴走",
        stageStart: 1,
        stageEnd: 1,
        variant: "support",
        href: "/support/#stage1-onboarding",
      },
      {
        label: "❷広げる伴走",
        stageStart: 2,
        stageEnd: 2,
        variant: "support",
        href: "/support/#stage2-support",
      },
      {
        label: "❸描く伴走",
        stageStart: 3,
        stageEnd: 3,
        variant: "support",
        href: "/support/#stage3-support",
      },
      {
        label: "★ B伴走支援",
        sublabel: "月 ¥20〜30万 / 半年〜1年で卒業",
        stageStart: 4,
        stageEnd: 4,
        variant: "flagship",
        isFlagship: true,
        href: "/support-b/",
      },
    ],
  },
  {
    id: "spot",
    label: "スポット",
    priceRange: "¥50万 / 日",
    bars: [
      {
        label: "★ 経営者合同セミナー",
        sublabel: "¥5万 × 10名 / 日",
        stageStart: 3,
        stageEnd: 3,
        variant: "flagship",
        isFlagship: true,
        href: "/seminar/",
      },
    ],
  },
];

const stageLabels = [
  { id: 1, short: "Lv1", full: "現在地を知る" },
  { id: 2, short: "Lv2", full: "活用を広げる" },
  { id: 3, short: "Lv3", full: "戦略を描く" },
  { id: 4, short: "Lv4", full: "AIネイティブ" },
];
---

<div class="tier-block">
  <header class="tier-head">
    <p class="kicker">§2.5 価格レンジ一覧</p>
    <h2 class="tier-title">あなたの会社はどの段階？<br />価格を先にお見せします。</h2>
    <p class="tier-lead">
      ツミキAIの商品は<strong>無料〜月30万</strong>のレンジで、ステージと目的ごとに選べます。
      「個別見積もり」で濁さず、ここにすべて並べます。
      <br /><em>※ 誠実さ①「情報の非対称性を、自ら解消する」の視覚装置。</em>
    </p>
  </header>

  <div class="chart" role="table" aria-label="4ステージ × 価格帯 帯グラフ">
    <!-- ヘッダ: ステージ -->
    <div class="head-corner" aria-hidden="true">価格帯 ＼ ステージ</div>
    {
      stageLabels.map((s) => (
        <div class="head-stage" role="columnheader">
          <span class="stage-short">{s.short}</span>
          <span class="stage-full">{s.full}</span>
        </div>
      ))
    }

    <!-- 各価格帯の行 -->
    {
      tiers.map((tier) => (
        <>
          <div class={`tier-label tier-label--${tier.id}`} role="rowheader">
            <span class="tier-name">{tier.label}</span>
            <span class="tier-price">{tier.priceRange}</span>
          </div>
          <div class="tier-lane" style={{ "--lane-cols": 4 }}>
            {tier.bars.map((bar) => {
              const startCol = bar.stageStart;
              const span = bar.stageEnd - bar.stageStart + 1;
              const style = {
                gridColumn: `${startCol} / span ${span}`,
              };
              const className = [
                "bar",
                `bar--${bar.variant}`,
                bar.isFlagship ? "bar--flagship" : "",
              ]
                .filter(Boolean)
                .join(" ");

              const content = (
                <>
                  <span class="bar-label">{bar.label}</span>
                  {bar.sublabel && <span class="bar-sub">{bar.sublabel}</span>}
                </>
              );

              return bar.href ? (
                <a href={bar.href} class={className} style={style}>
                  {content}
                </a>
              ) : (
                <div class={className} style={style}>
                  {content}
                </div>
              );
            })}
          </div>
        </>
      ))
    }
  </div>

  <p class="tier-note">
    ★ = 主力3マス（Lv1講座 / 合同セミナー / B伴走支援）
    &nbsp;/&nbsp; 価格は税別
    &nbsp;/&nbsp; 各商品の詳細は §3 マトリックスまたは商品ページで
  </p>
</div>

<style>
  .tier-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* Header */
  .tier-head {
    max-width: 720px;
  }
  .kicker {
    font-family: var(--font-en);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 var(--space-3) 0;
  }
  .tier-title {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-heading);
    color: var(--color-text);
    margin: 0 0 var(--space-4) 0;
  }
  .tier-lead {
    font-size: var(--text-body-lg);
    line-height: var(--leading-body-lg);
    color: var(--color-text-body);
    margin: 0;
  }
  .tier-lead strong {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }
  .tier-lead em {
    display: inline-block;
    margin-top: var(--space-2);
    font-style: normal;
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
  }

  /* Chart */
  .chart {
    display: grid;
    grid-template-columns: 160px repeat(4, 1fr);
    gap: var(--space-2);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-card);
  }

  /* ヘッダ行 */
  .head-corner {
    font-family: var(--font-jp);
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    padding: var(--space-3) var(--space-2);
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: flex-end;
  }
  .head-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    text-align: center;
    padding: var(--space-3) var(--space-2);
    border-bottom: 2px solid var(--color-primary);
  }
  .stage-short {
    font-family: var(--font-en);
    font-size: var(--text-body-lg);
    font-weight: var(--weight-bold);
    color: var(--color-primary);
    letter-spacing: 0.02em;
  }
  .stage-full {
    font-family: var(--font-jp);
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    margin-top: 2px;
  }

  /* Tier label（左列） */
  .tier-label {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-4) var(--space-3);
    background: var(--color-bg-subtle);
    border-radius: var(--radius-md);
    border-left: 4px solid var(--color-border);
  }
  .tier-label--free {
    border-left-color: var(--color-success);
  }
  .tier-label--low {
    border-left-color: var(--color-accent);
  }
  .tier-label--mid {
    border-left-color: var(--color-primary);
  }
  .tier-label--support {
    border-left-color: var(--color-primary);
  }
  .tier-label--spot {
    border-left-color: var(--color-accent-soft);
  }
  .tier-name {
    font-family: var(--font-jp-serif);
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
  }
  .tier-price {
    font-family: var(--font-en), var(--font-jp);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    color: #B84A1E;
    margin-top: 2px;
    font-feature-settings: "tnum";
  }

  /* Lane（右4列をまとめて覆う） */
  .tier-lane {
    grid-column: 2 / -1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-2);
    min-height: 80px;
    padding: var(--space-2) 0;
  }

  /* Bar（商品の帯） */
  .bar {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition:
      box-shadow var(--duration-hover) var(--ease-out-quint),
      transform var(--duration-hover) var(--ease-out-quint);
  }
  a.bar:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .bar-label {
    font-family: var(--font-jp-serif);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    line-height: 1.35;
  }
  .bar-sub {
    font-family: var(--font-jp);
    font-size: 11px;
    font-weight: var(--weight-regular);
    line-height: 1.4;
    margin-top: 2px;
    opacity: 0.85;
  }

  /* Variants */
  .bar--free {
    background: #E6F4EA;
    color: var(--color-success);
    border: 1px solid var(--color-success);
  }
  .bar--low {
    background: #fff;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }
  .bar--mid {
    background: var(--color-bg-warm);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }
  .bar--support {
    background: #F3F0EC;
    color: var(--color-text);
    border: 1px dashed var(--color-text-muted);
  }
  .bar--spot {
    background: var(--color-accent-soft);
    color: #B84A1E;
  }
  .bar--flagship {
    background: linear-gradient(180deg, #fff 0%, var(--color-accent-soft) 140%);
    border: 2px solid var(--color-accent);
    color: var(--color-text);
  }

  /* Note */
  .tier-note {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    text-align: center;
    margin: 0;
  }

  /* ========================================
   * Responsive
   * ======================================== */
  @media (max-width: 899px) {
    .tier-title {
      font-size: var(--text-h2);
    }

    .chart {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      padding: var(--space-4);
    }

    /* ヘッダ行はモバイルでは折りたたみ、スクロール型の簡易ヘッダのみ */
    .head-corner {
      display: none;
    }
    .head-stage {
      display: none;
    }

    /* 価格帯ラベルをブロック見出しに */
    .tier-label {
      border-left-width: 6px;
      padding: var(--space-3) var(--space-4);
    }

    /* Lane をモバイル用 4列のまま小さく表示（横スクロール許容） */
    .tier-lane {
      grid-column: 1;
      grid-template-columns: repeat(4, minmax(120px, 1fr));
      overflow-x: auto;
      padding: 0;
    }
    .bar {
      padding: var(--space-2) var(--space-3);
    }
    .bar-label {
      font-size: 12px;
    }
    .bar-sub {
      font-size: 10px;
    }
  }
</style>
