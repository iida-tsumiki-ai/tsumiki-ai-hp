---
import Layout from "../../../layouts/Layout.astro";
import CourseLandingPage from "../../../components/CourseLandingPage.astro";
import { noteUrls } from "../../../data/noteUrls";

const audience = [
  { text: "全社でAI活用の底上げが進み、個別効率化は形になった会社の経営者" },
  { text: "基幹系・重要サービス（販売／生産／会計／顧客管理）が古くデータ連携できない方" },
  { text: "データが散在していて経営判断に使えていない方" },
  { text: "社内に選定・運用を担う役割（社内CTO機能）が定まっていない方" },
];

const chapterParts = [
  {
    partLabel: "Part 1",
    partTitle: "導入と全体像",
    partDuration: "7分",
    chapters: [
      { no: "導入", title: "3段目の壁は、「やり方」ではなく「設計の問い」にある", duration: "0-3分", body: "Lv2 を終えた会社で見える「個別効率化と全体最適のギャップ」／Lv3 が「決めること」の連続になる理由。" },
      { no: 1, title: "「Lv3：戦略を描く」とは何か — 全体像", duration: "3-7分", body: "AI領域の入口としての Lv3／4つのブロック（基幹系再選定／API・MCP連携／データ経営判断／組織役割設計）の意味と順番。" },
    ],
  },
  {
    partLabel: "Part 2",
    partTitle: "本論",
    partDuration: "21分",
    chapters: [
      { no: 2, title: "基幹系ツール再選定の原則", duration: "7-13分", body: "API・MCP対応を基準に入れ替え／「連携しやすさ」の見分け方／選定フロー。クラウド前提＋API公開がベストプラクティス。" },
      { no: 3, title: "Claude / API連携 / MCP の現状＋データを経営判断に使う", duration: "13-22分", body: "中小企業で現実的に使える Claude Code の範囲／クラウド基盤＋Claude Code がベストプラクティス／売上・顧客・在庫の横断分析／ダッシュボード設計。" },
      { no: 4, title: "組織の役割設計 — 社内CTO機能", duration: "22-28分", body: "選定・運用・教育の3機能／外部専門家との役割分担／兼任か専任か／DeNAパラドックスへの打ち手5つ／インセンティブ設計（時間／お金／キャリアの3パターン）。" },
    ],
  },
  {
    partLabel: "Part 3",
    partTitle: "卒業条件と締め",
    partDuration: "7分",
    chapters: [
      { no: 5, title: "Lv4到達チェックリスト＋自律化への壁", duration: "28-32分", body: "5項目チェックリスト（仕組み4＋制度設計1）／自動化→自律化の違い／AI駆動経営伴走支援領域への接続。" },
      { no: "締め", title: "次の一歩 — 答えを出す場としての伴走支援", duration: "32-35分", body: "「頭の整理は記事で、実装の判断は伴走で」／AI駆動経営伴走支援（戦略再設計フェーズ）への接続。" },
    ],
  },
];

const cantDo = [
  {
    title: "本講座だけでは Lv3 を完走できません",
    body: "Lv3 は世の中に体系化された中小企業事例がほぼ存在しない領域です。本講座は「考える軸」を整理する道具にすぎません。実装は <a href=\"/support/\">AI駆動経営伴走支援</a>（Lv3向け＝基幹再設計フェーズ）／担当者チームで内製化に踏み込むなら <a href=\"/training/#stage3-training\">❸戦略実装研修</a>（Claude Code・API・MCP の2日研修）でお届けします。",
  },
  {
    title: "個別の基幹系製品レビューはしません",
    body: "「うちはどの会計ソフトに入れ替えるべきか」のような個別判断は AI駆動経営伴走支援 のヒアリング内で扱います。本講座は選定軸の原則を提供します。",
  },
  {
    title: "Lv2の卒業がない場合は早すぎます",
    body: "全社AI活用底上げと業務棚卸しが完了していない場合、本講座は早すぎます。<a href=\"/courses/lv2/\">Lv2講座</a> から戻ってください。",
  },
];

const faq = [
  {
    q: "なぜ「副読本」と書いてあるんですか？",
    a: "Lv3 は<strong>講義だけで完結する領域ではない</strong>からです。原則は本講座（¥3,000）で整理できますが、自社の業務に当てはめた基幹系再選定／組織役割設計の実装判断は AI駆動経営伴走支援で進めます。本講座は伴走支援に進む前の「頭の整理」として位置づけています。",
  },
  {
    q: "AI駆動経営伴走支援と Lv3講座、どちらを先に？",
    a: "順序は問いません。本講座（¥3,000）で先に頭を整理してから無料相談に進む方が会話が深まります。一方、すでに無料相談を予定している方も本講座を副読本として併読すると伴走中の判断スピードが上がります。",
  },
  {
    q: "リリースはいつ？",
    a: "公開中です。上の副CTA「Lv3講座を読む（note ¥3,000）」から note 有料記事として購入できます。",
  },
];
---

<Layout
  title="Lv3講座 ¥3,000（★副読本）— ツミキAI"
  description="基幹系再選定・組織役割設計の視点整理。AI駆動経営伴走支援（戦略再設計フェーズ）の副読本として設計しています。"
>
  <CourseLandingPage
    kicker="A. 経営者が先に学ぶ — Lv3講座（★副読本）"
    title={`Lv3：戦略を描く段階の<br /><span class="accent">"頭の整理"。</span>`}
    lead={`基幹系再選定・組織役割設計の視点を、読了35分で整理する note 有料記事です。<br />ただし<strong>Lv3は講義だけで完結する領域ではありません</strong>。実装は AI駆動経営伴走支援（戦略再設計フェーズ）で扱います。`}
    subreaderNote={`<strong>この記事は、AI駆動経営伴走支援に進む前の "頭の整理" として読む副読本として設計されています。</strong>主CTAは伴走支援の無料相談、副CTAは本講座の事前通知登録です。`}
    price="¥3,000"
    priceNote="共通版（GWS／MS365 問わず）／ 読了35分"
    audience={audience}
    chapterParts={chapterParts}
    graduationLabel="卒業条件：Lv4到達チェックリストを満たす（本講座＋AI駆動経営伴走支援の組み合わせで達成）"
    graduationItems={[
      "基幹系再選定の意思決定軸が言語化できた",
      "API・MCP対応の現状認識が更新された",
      "データを経営判断に使う仕組みの設計図を持つ",
      "社内CTO機能（選定・運用・教育）の役割設計が見えた",
    ]}
    cantDo={cantDo}
    faq={faq}
    ctaPrimary={{ label: "★ AI駆動経営伴走支援の無料相談", href: "/support/" }}
    ctaSecondary={{ label: "Lv3講座を読む（note ¥3,000）", href: noteUrls.lv3 }}
    variant="subreader"
  />
</Layout>
