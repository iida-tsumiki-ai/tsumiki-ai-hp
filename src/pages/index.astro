---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Container from "../components/Container.astro";
import DifferentiationPoints from "../components/DifferentiationPoints.astro";
import PriceTierChart from "../components/PriceTierChart.astro";
import ProductMatrix from "../components/ProductMatrix.astro";
import FlagshipSummary from "../components/FlagshipSummary.astro";
import RepMessage from "../components/RepMessage.astro";
---

<Layout>
  <main>
    <!-- 仮HERO（§1の本実装は別タスク / B1検証用の最小ヒーロー） -->
    <Section size="l" background="default">
      <Container>
        <div class="hero-placeholder">
          <p class="kicker">ツミキAI — HP リニューアル / ローカル開発版</p>
          <h1 class="display">小さく始めて、一つずつ積み上げる。</h1>
          <p class="lead">
            中小企業がAIを「当たり前のツール」にするための伴走者。
            診断で現在地がわかり、作って終われる。そして卒業できる。
          </p>
        </div>
      </Container>
    </Section>

    <!-- §2. 差別化3点セット（B3 / D案§2） -->
    <Section size="l" background="warm" id="differentiation">
      <Container>
        <DifferentiationPoints />
      </Container>
    </Section>

    <!-- §2.5. 4ステージ × 価格帯 帯グラフ（B7 / D案§2.5 / 論点5） -->
    <Section size="l" background="default" id="price-tiers">
      <Container>
        <PriceTierChart />
      </Container>
    </Section>

    <!-- §3. 4ステージ × 商品マトリックス 統合（B1 / D案§3） -->
    <Section size="l" background="subtle" id="product-matrix">
      <Container>
        <ProductMatrix />
      </Container>
    </Section>

    <!-- §4. 3系統の主力商品サマリー（B6 / D案§4 / 論点4） -->
    <Section size="l" background="default" id="flagship-summary">
      <Container>
        <FlagshipSummary />
      </Container>
    </Section>

    <!-- §5. 代表メッセージ（エピソード型 / D案§5 前倒し / 誠実さ②） -->
    <Section size="l" background="warm" id="rep-message">
      <Container>
        <RepMessage />
      </Container>
    </Section>
  </main>
</Layout>

<style>
  .hero-placeholder {
    max-width: 720px;
  }
  .kicker {
    font-family: var(--font-en);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 var(--space-4) 0;
  }
  .display {
    font-family: var(--font-jp-serif);
    font-size: var(--text-display);
    line-height: var(--leading-display);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-heading);
    color: var(--color-text);
    margin: 0 0 var(--space-6) 0;
  }
  .lead {
    font-size: var(--text-body-lg);
    line-height: var(--leading-body-lg);
    color: var(--color-text-body);
    margin: 0;
  }

  @media (max-width: 768px) {
    .display {
      font-size: var(--text-h1);
    }
  }
</style>
