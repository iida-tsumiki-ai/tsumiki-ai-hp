---
import Layout from "../../../layouts/Layout.astro";
import CourseLandingPage from "../../../components/CourseLandingPage.astro";
import { noteUrls } from "../../../data/noteUrls";

const audience = [
  { text: "「Aさんのパソコンの中にしかない」ファイルが社内にある会社の経営者" },
  { text: "発注を FAX で受けて手で Excel に打ち直す等、つなぎ目を手作業で凌いでいる方" },
  { text: "部署間のやりとりがメール添付のファイル往復で成り立っている会社の経営者" },
  { text: "全社員に会社のメールアドレスが配られていない、または使われていない状態の方" },
];

const chapterParts = [
  {
    partLabel: "Part 1",
    partTitle: "導入と全体像",
    partDuration: "7分",
    chapters: [
      { no: "導入", title: "1段目が、すべての土台になる", duration: "0-3分", body: "2026年に入って増えた経営者の声／中小機構2026年3月調査のAI導入率20.4%／Lv1から始める意味。" },
      { no: 1, title: "「Lv1：土台を組む」とは何か — 全体像", duration: "3-7分", body: "「システムはあるのに繋がっていない会社」の典型像／Lv1の3ブロック（共通基盤／1部門スタート／はじめてのAI活用）。" },
    ],
  },
  {
    partLabel: "Part 2",
    partTitle: "本論",
    partDuration: "13分",
    chapters: [
      { no: 2, title: "オフィス基盤を選ぶ — GWS vs MS365", duration: "7-13分", body: "「月2,000円/人」を払う前に — NAS・Office買い切りで止まっている会社へ／哲学の違い／4観点の判断フロー／「全社員アカウント配布」の意味／メールなしから始める方法。" },
      { no: 3, title: "1部門からスモールスタート＋はじめてのAI活用", duration: "13-20分", body: "60ライセンス問題／先行チーム5〜10名の選び方（影響力／業務量／素直さ）／1部門のつなぎ目を1箇所消す／要約・下書き・検索の3用途／Lv1の現場で起きること（複数経営者から見えるパターン）。" },
    ],
  },
  {
    partLabel: "Part 3",
    partTitle: "卒業条件と地雷予防＋締め",
    partDuration: "10分",
    chapters: [
      { no: 4, title: "Lv2到達チェックリスト 7項目", duration: "20-25分", body: "Lv1終了時の状態整理（全社員アカウント配布済／業務利用は先行チームのみ／1つのつなぎ目消えた）／7項目チェックリスト／5項目以上で Lv2 へ進む基準。" },
      { no: 5, title: "Lv1で詰まる4地雷の予防接種", duration: "25-28分", body: "60ライセンス問題／PoC死／現場拒否（3種類の抵抗）／ROI不明 — それぞれの構造と具体的な予防策。" },
      { no: "締め", title: "次の一歩 — 自走モデルの宣言", duration: "28-30分", body: "卒業前提で伴走する宣言／AI駆動経営診断・無料個別相談・Lv2講座への接続。" },
    ],
  },
];

const cantDo = [
  {
    title: "Lv2以上の具体策は扱いません",
    body: "「業務棚卸し」「ミニアプリ作成」「データ置き場共通化」など Lv2の中身は Lv2講座（メンバーシップ）で扱います。本講座はLv1を確実にクリアすることに集中します。",
  },
  {
    title: "個別業種の深掘りはしません",
    body: "建築／製造／卸売など業種別の深い事例は AI駆動経営伴走支援 のヒアリング内で扱います。本講座は業種を問わない原則を提供します。",
  },
  {
    title: "半年で劇的変化する魔法ではありません",
    body: "1段ずつ着実に進めるための地図と実習を提供します。読了 = 即変化ではなく、3ヶ月かけて社内に基盤を作る前提の設計です。",
  },
];

const faq = [
  {
    q: "GWS版とMS365版、どちらを買えばいい？",
    a: "<strong>すでに導入済みの基盤に合わせる</strong>のが早いです。Google Workspace を使っている／使う予定なら GWS版、Microsoft 365 を使っているなら MS365版。決まっていない方は、第2章「オフィス基盤を選ぶ」を先に立ち読みできるよう note でサンプル公開する予定です。",
  },
  {
    q: "Lv2以上でも役立ちますか？",
    a: "Lv2以上の方には Part 1 のロードマップ要約と Part 3 の Lv2到達チェックリストが「自社のLv1漏れ確認」として役立ちます。ただし本論の Part 2 は Lv1経営者向けに最適化されているため、Lv2以上の方はLv2講座をおすすめします。",
  },
  {
    q: "動画はありますか？",
    a: "現在は note の有料記事（経営者メンバーシップ）として提供しています（読了30分・約13,000字・図表豊富）。月¥3,000の加入で Lv1〜Lv4 全講座が読み放題。動画化は Phase 4 以降で検討予定です。",
  },
  {
    q: "返金はありますか？",
    a: "note プラットフォームの規約に準じます。購入前に本ページの目次・卒業条件・できないこと を必ず確認してください。期待値ズレを防ぐため、できる限り情報を先出ししています。",
  },
];

const checkList = [
  "全社共通のクラウド基盤（GWS or MS365）が導入されている",
  "会社ドメインのメールが全員に配られている",
  "社員全員の勤務PCから、会社のファイルにアクセスできる",
  "1部門で定着し、次の部門への展開計画がある",
  "Gemini / Copilot を日常業務で使う社員が3人以上いる",
  "紙・FAX が主な伝達手段ではなくなっている",
  "「次は業務棚卸し」が経営者の中で言語化できている",
];
---

<Layout
  title="Lv1講座（メンバーシップ）— ツミキAI"
  description="バラバラの業務を、繋げる第一歩。AIが社内データに到達できる土台を作るオフィス基盤選び＋1部門スモールスタート。Lv2到達チェックリスト7項目付き。GWS版/MS365版。"
>
  <CourseLandingPage
    kicker="A. 経営者が先に学ぶ — Lv1講座"
    title={`バラバラの業務を、<br /><span class="accent">繋げる第一歩。</span>`}
    lead={`紙・FAX・Excel 手入力で凌いでいた<strong>つなぎ目を1箇所消す</strong>。Lv2 以降に <strong>AI が社内データへ到達できる土台</strong>を作る Lv1 講座。<br />読み終わったとき、「Lv2到達まで何が足りないか」が7項目チェックリストで言葉になります。`}
    price="メンバーシップ"
    priceNote="月¥3,000で Lv1〜Lv4 全講座読み放題／GWS版・MS365版を同梱／読了30分・約13,000字"
    audience={audience}
    chapterParts={chapterParts}
    graduationLabel="卒業条件：Lv2到達チェックリスト 7項目中5項目以上を満たす"
    graduationItems={checkList}
    cantDo={cantDo}
    faq={faq}
    ctaPrimary={{ label: "Lv1講座を読む（メンバーシップ 月¥3,000）", href: noteUrls.lv1 }}
    ctaSecondary={{ label: "AI駆動経営診断で自分のLvを特定する（無料）", href: "/diagnose/" }}
    ctaTertiary={{ label: "無料個別相談（30分）", href: "https://docs.google.com/forms/d/e/1FAIpQLSd1yUsmc94ZTZ_MqR3tLVXDWlCaOmLIYxt3o2BqSb-AVF83gg/viewform" }}
    variant="normal"
    currentLevel="lv1"
  />
</Layout>
