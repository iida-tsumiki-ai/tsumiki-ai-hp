---
/**
 * note 記事「請求書を電帳法対応で自動台帳化」本文中スライド画像プレビュー（全スライド縦積み表示）
 * URL: /slide-preview/invoice-article/
 */
import "../../../styles/tokens.css";
import "../../../styles/global.css";
import SlideCard from "../../../components/SlideCard.astro";
import { slides } from "../../../data/slides-invoice-article.ts";
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <title>Slide Previews Invoice Article — ツミキAI</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;700;900&family=Shippori+Mincho:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      html, body {
        margin: 0;
        padding: 0;
        background: #D8D5D0;
      }
      body {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 32px;
        padding: 32px 0 64px;
      }
      .preview-label {
        font-family: var(--font-en);
        font-size: 13px;
        font-weight: 600;
        color: #888;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .preview-label a {
        color: #333;
        text-decoration: none;
      }
      .preview-label a:hover {
        text-decoration: underline;
      }
      astro-dev-toolbar,
      astro-dev-overlay {
        display: none !important;
      }
    </style>
  </head>
  <body>
    {
      slides.map((s) => (
        <>
          <p class="preview-label">
            <a href={`/slide-preview/invoice-article/${s.slug}/`}>
              [{s.layout}] {s.slug}
            </a>
          </p>
          <SlideCard slug={s.slug} slides={slides} />
        </>
      ))
    }
  </body>
</html>
