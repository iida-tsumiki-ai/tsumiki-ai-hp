---
/**
 * /training/ — 研修系2商品 統合ページ（F1）
 * 設計書: 11 §7（2026-04-23 論点3 反映 / 5ページ→2統合の研修側）
 * カテゴリB: 担当者チームに共通言語を入れる
 *
 * 構成:
 *   §HERO → §3カテゴリでの位置づけ → §❶入門研修 → §❷実践研修 → §❸戦略実装研修 →
 *   §オズ方式注意 → §他の始め方へ → §最終CTA
 */
import Layout from "../../layouts/Layout.astro";

const stage1Items = [
  "Claude / ChatGPT の基礎（要約・下書き・検索）",
  "AIに任せやすい業務の見分け方",
  "個人プロンプト集（受講者ごとに5-10個持ち帰り）",
  "セキュリティと社内ガイドライン整備の勘所",
  "Lv2への進み方ガイド",
];
const stage2Items = [
  "チーム共通プロンプト集の作り方",
  "GAS（Google Apps Script）入門 / Power Automate の型",
  "業務棚卸しワーク（やめる／AIに任せる／人がやる）",
  "ミニアプリ実装ハンズオン（集計・通知・転記の3パターン）",
  "Lv3への進み方ガイド",
];
const stage3Day1Items = [
  "Claude Code とは — 経営判断ツールを内製する道具（2h）",
  "API・MCP の基礎 — 何ができて何ができないか（2h）",
  "ハンズオン①: Claude Code で自社向けミニツールを作る（2h）",
];
const stage3Day2MorningItems = [
  "ハンズオン②: 基幹系データを Claude / API 経由で経営ダッシュボード化（3h）",
];
const stage3Day2AfternoonItems = [
  "社内CTO機能の選定／運用／教育（1h）",
  "DeNAパラドックス打ち手5つ（1h）",
  "インセンティブ設計3パターン＋持ち帰り課題（1h）",
];

const cantDo = [
  {
    title: "経営者向けではありません",
    body: "本研修はカテゴリB（組織に入れる）／担当者チームが対象です。経営者本人が学ぶ場合は <a href=\"/courses/\">講座シリーズ</a> をご検討ください。",
  },
  {
    title: "Lv4 の研修はありません",
    body: "Lv4 は AI内製化が定着して事業組み替えに進むフェーズで、研修よりも <a href=\"/support/\">AI駆動経営伴走支援</a> の個別伴走が適しています。担当者向け集合研修は ❶入門・❷実践・❸戦略実装 までの3商品です。",
  },
  {
    title: "業種特化版はありません",
    body: "建築／製造／卸売など業種別カスタマイズは <a href=\"/support/\">AI駆動経営伴走支援</a> のヒアリング内で扱います。本研修は業種を問わない共通カリキュラムです。",
  },
];
---

<Layout
  title="担当者向け研修プログラム — ツミキAI"
  description="❶入門研修（半日 ¥10万）／❷実践研修（1日 ¥25万）／❸戦略実装研修（2日 ¥50万）。組織に共通言語を入れる集合研修。カテゴリB「組織に入れる」の3商品。"
>
  <!-- ========== §HERO ========== -->
  <section class="page-section page-section--warm">
    <div class="page-container hero">
      <p class="kicker">B. 組織に入れる — 担当者向け研修</p>
      <h1 class="hero-title">
        組織に <span class="hero-accent">共通言語を入れる。</span>
      </h1>
      <p class="hero-lead">
        担当者チームが集合して受講する集合研修プログラム。
        効果は <strong>"組織に共通言語が入る"</strong>。
        3ヶ月後の自走率で測定する設計です。
      </p>
      <div class="hero-meta">
        <span class="hero-price">¥10〜50万</span>
        <span class="hero-price-note">半日〜2日 / カテゴリB（3商品）</span>
      </div>
      <div class="hero-ctas">
        <a class="btn btn-primary btn-lg" href="/contact/">無料個別相談を予約する</a>
        <a class="btn btn-secondary btn-lg" href="#stage1-training">研修内容を見る</a>
      </div>
    </div>
  </section>

  <!-- ========== §3カテゴリでの位置づけ ========== -->
  <section class="page-section">
    <div class="page-container">
      <header class="sec-head">
        <p class="sec-kicker">3カテゴリでの位置づけ</p>
        <h2 class="sec-title">本ページは「組織に入れる」の2商品です。</h2>
        <p class="sec-lead">
          ツミキAIの3カテゴリのうち、本ページは <strong>B. 組織に入れる</strong> に該当します。
          経営者本人が学ぶ場合は A の <a href="/courses/">講座シリーズ</a> をご検討ください。
        </p>
      </header>
      <ul class="cat-grid">
        <li class="cat-card">
          <span class="cat-icon">👨‍💼</span>
          <span class="cat-label">A. 経営者が先に学ぶ</span>
          <span class="cat-tag">講座／集合学習</span>
          <a class="cat-link" href="/courses/">講座シリーズ →</a>
        </li>
        <li class="cat-card cat-card--current">
          <span class="cat-icon">👥</span>
          <span class="cat-label">B. 組織に入れる</span>
          <span class="cat-tag">担当者集合研修（このページ）</span>
          <span class="cat-current-mark">現在地</span>
        </li>
        <li class="cat-card">
          <span class="cat-icon">🤝</span>
          <span class="cat-label">C. 一緒に実行する</span>
          <span class="cat-tag">伴走（プロジェクト）</span>
          <a class="cat-link" href="/support/">AI駆動経営伴走支援 →</a>
        </li>
      </ul>
    </div>
  </section>

  <!-- ========== §❶入門研修 ========== -->
  <section class="page-section page-section--subtle" id="stage1-training">
    <div class="page-container">
      <article class="program-card">
        <div class="program-header">
          <div class="program-tag">Lv1 ❶ 土台を組む</div>
          <h2 class="program-title">❶入門研修</h2>
          <p class="program-tagline">担当者チームに「触る人」を増やす半日研修。</p>
        </div>
        <div class="program-meta">
          <div class="program-meta-row"><span>料金</span><strong>¥10万 / 半日（4時間）</strong></div>
          <div class="program-meta-row"><span>対象</span><strong>Lv1 経営者＋現場担当者チーム</strong></div>
          <div class="program-meta-row"><span>定員</span><strong>5〜15名（御社の会議室で実施）</strong></div>
          <div class="program-meta-row"><span>本質</span><strong>オフィス基盤と "はじめてのAI活用" を実習で</strong></div>
        </div>
        <div class="program-content">
          <h3 class="program-content-label">想定される中身</h3>
          <ul class="program-items">
            {stage1Items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="program-cta">
          <a class="btn btn-primary" href="/contact/">この研修について相談する</a>
        </div>
      </article>
    </div>
  </section>

  <!-- ========== §❷実践研修 ========== -->
  <section class="page-section" id="stage2-training">
    <div class="page-container">
      <article class="program-card">
        <div class="program-header">
          <div class="program-tag">Lv2 ❷ 活用を広げる</div>
          <h2 class="program-title">❷実践研修</h2>
          <p class="program-tagline">チームが自走する状態を作る1日研修。</p>
        </div>
        <div class="program-meta">
          <div class="program-meta-row"><span>料金</span><strong>¥25万 / 1日（7時間）</strong></div>
          <div class="program-meta-row"><span>対象</span><strong>Lv2 経営者＋チーム（業務棚卸しに本格着手したい段階）</strong></div>
          <div class="program-meta-row"><span>定員</span><strong>5〜15名（御社の会議室で実施）</strong></div>
          <div class="program-meta-row"><span>本質</span><strong>AI活用底上げ／業務棚卸し／ミニアプリのハンズオン</strong></div>
        </div>
        <div class="program-content">
          <h3 class="program-content-label">想定される中身</h3>
          <ul class="program-items">
            {stage2Items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="program-cta">
          <a class="btn btn-primary" href="/contact/">この研修について相談する</a>
        </div>
      </article>
    </div>
  </section>

  <!-- ========== §❸戦略実装研修（2026-05-03 新設） ========== -->
  <section class="page-section page-section--subtle" id="stage3-training">
    <div class="page-container">
      <article class="program-card">
        <div class="program-header">
          <div class="program-tag">Lv3 ❸ 戦略を描く</div>
          <h2 class="program-title">❸戦略実装研修</h2>
          <p class="program-tagline">Claude Code・API・MCP の実装＋管理者限定の組織設計セッション込みの2日研修。</p>
        </div>
        <div class="program-meta">
          <div class="program-meta-row"><span>料金</span><strong>¥50万 / 2日（12時間）</strong></div>
          <div class="program-meta-row"><span>対象</span><strong>Lv3 担当者チーム（5〜10名）＋ 管理者層（部門長・経営者層）</strong></div>
          <div class="program-meta-row"><span>形式</span><strong>担当者向け技術ハンズオン＋管理者限定セッション（後半）</strong></div>
          <div class="program-meta-row"><span>本質</span><strong>Claude Code 内製の型と、組織制度設計の両輪</strong></div>
        </div>
        <div class="program-content">
          <h3 class="program-content-label">Day 1（全員参加・6時間）</h3>
          <ul class="program-items">
            {stage3Day1Items.map((item) => <li>{item}</li>)}
          </ul>
          <h3 class="program-content-label">Day 2 午前（全員参加・3時間）</h3>
          <ul class="program-items">
            {stage3Day2MorningItems.map((item) => <li>{item}</li>)}
          </ul>
          <h3 class="program-content-label">Day 2 午後（管理者限定セッション・3時間）</h3>
          <ul class="program-items">
            {stage3Day2AfternoonItems.map((item) => <li>{item}</li>)}
          </ul>
          <p class="program-note">
            ※ 担当者は Day 2 午後は退室可。管理者層（部門長・経営者層）は最終セッションまで参加。
          </p>
        </div>
        <div class="program-cta">
          <a class="btn btn-primary" href="/contact/">この研修について相談する</a>
        </div>
      </article>
    </div>
  </section>

  <!-- ========== §オズ方式の注意書き ========== -->
  <section class="page-section page-section--subtle">
    <div class="page-container">
      <div class="notice-block">
        <div class="notice-icon" aria-hidden="true">!</div>
        <div class="notice-body">
          <h3 class="notice-title">中身は「お引き合いに応じて詰めていく」設計です</h3>
          <p>
            両プログラムとも、御社の現状（業種・規模・現メンバーのITリテラシー）に合わせて当日のカリキュラムを調整します。
            まず無料の個別相談（30分）で、「うちの場合、何を扱ってもらいたいか」を一緒に固めてから正式申し込み、という流れを推奨しています。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== §できないこと ========== -->
  <section class="page-section">
    <div class="page-container">
      <header class="sec-head">
        <p class="sec-kicker">できないこと</p>
        <h2 class="sec-title">先に「お受けしないこと」をお伝えします。</h2>
      </header>
      <ul class="cantdo-list">
        {cantDo.map((c) => (
          <li class="cantdo-card">
            <div class="cantdo-mark" aria-hidden="true">×</div>
            <h3 class="cantdo-title">{c.title}</h3>
            <p class="cantdo-body" set:html={c.body}></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ========== §他の始め方へ ========== -->
  <section class="page-section page-section--subtle">
    <div class="page-container">
      <header class="sec-head">
        <p class="sec-kicker">他の始め方</p>
        <h2 class="sec-title">B 以外も検討できます。</h2>
      </header>
      <ul class="other-grid">
        <li class="other-card">
          <span class="other-icon">👨‍💼</span>
          <h3 class="other-title">A. 経営者が先に学ぶ</h3>
          <p class="other-body">経営者本人が地図を持って動く。講座シリーズ（無料＋¥3,000×4）。</p>
          <a class="other-link" href="/courses/">講座シリーズを見る →</a>
        </li>
        <li class="other-card">
          <span class="other-icon">🤝</span>
          <h3 class="other-title">C. 一緒に実行する</h3>
          <p class="other-body">社外CTOとして経営層〜現場まで一気通貫で伴走。月¥10〜30万 / 半年で自走。3プランから選べます。</p>
          <a class="other-link" href="/support/">AI駆動経営伴走支援を見る →</a>
        </li>
      </ul>
      <div class="diagnose-cta">
        <a class="btn btn-secondary btn-lg" href="/diagnose/">迷ったら AI駆動経営診断（10問・3分）</a>
      </div>
    </div>
  </section>

  <!-- ========== §最終CTA ========== -->
  <section class="page-section page-section--warm">
    <div class="page-container final-cta">
      <h2 class="final-title">担当者を次のステップへ。</h2>
      <p class="final-lead">
        御社の現状をまずヒアリングさせてください。30分の無料相談から、御社にフィットする研修の組み方を一緒に決めます。
      </p>
      <div class="final-ctas">
        <a class="btn btn-primary btn-lg" href="/contact/">無料個別相談を予約する</a>
        <a class="btn btn-secondary btn-lg" href="/diagnose/">AI駆動経営診断（10問・3分）</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ============================================================
   * 共通
   * ============================================================ */
  .page-section {
    width: 100%;
    padding-top: var(--section-py-desktop);
    padding-bottom: var(--section-py-desktop);
  }
  .page-section--subtle { background: var(--color-bg-subtle); }
  .page-section--warm { background: var(--color-bg-warm); }
  @media (max-width: 768px) {
    .page-section { padding-top: var(--section-py-mobile); padding-bottom: var(--section-py-mobile); }
  }

  .page-container {
    max-width: var(--container-lg);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .sec-head {
    max-width: 720px;
    margin: 0 0 var(--space-8) 0;
  }
  .sec-kicker {
    font-family: var(--font-en);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 var(--space-3) 0;
  }
  .sec-title {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-4) 0;
  }
  .sec-lead {
    font-size: var(--text-body-lg);
    line-height: var(--leading-body-lg);
    color: var(--color-text-body);
    margin: 0;
  }
  .sec-lead strong {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }
  .sec-lead a {
    color: var(--color-accent);
    font-weight: var(--weight-semibold);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    font-family: var(--font-jp);
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    transition: background-color var(--duration-hover) var(--ease-out-quint), transform var(--duration-hover) var(--ease-out-quint);
    white-space: nowrap;
  }
  .btn-lg { padding: var(--space-4) var(--space-8); font-size: var(--text-body-lg); }
  .btn-primary {
    background: var(--color-accent);
    color: #fff;
    box-shadow: var(--shadow-button);
  }
  .btn-primary:hover { background: #E55A2B; color: #fff; transform: translateY(-1px); }
  .btn-secondary {
    background: transparent;
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
  }
  .btn-secondary:hover { background: var(--color-primary); color: #fff; }

  /* HERO */
  .hero { text-align: center; max-width: 880px; }
  .kicker {
    font-family: var(--font-en);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 var(--space-4) 0;
  }
  .hero-title {
    font-family: var(--font-jp-serif);
    font-size: var(--text-display);
    line-height: var(--leading-display);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-6) 0;
  }
  .hero-accent { color: var(--color-accent); }
  .hero-lead {
    font-size: var(--text-body-lg);
    line-height: var(--leading-body-lg);
    color: var(--color-text-body);
    max-width: 640px;
    margin: 0 auto var(--space-6);
  }
  .hero-lead strong { color: var(--color-text); font-weight: var(--weight-semibold); }
  .hero-meta {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }
  .hero-price {
    font-family: var(--font-en), var(--font-jp);
    font-size: var(--text-h2);
    font-weight: var(--weight-bold);
    color: var(--color-accent);
  }
  .hero-price-note {
    align-self: center;
    padding: var(--space-2) var(--space-4);
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }
  .hero-ctas { display: flex; justify-content: center; gap: var(--space-3); flex-wrap: wrap; }

  /* §3カテゴリ */
  .cat-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  .cat-card {
    position: relative;
    padding: var(--space-6);
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }
  .cat-card--current {
    border: 2px solid var(--color-accent);
    background: var(--color-bg-warm);
  }
  .cat-icon { font-size: var(--text-h2); line-height: 1; }
  .cat-label {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h4);
    font-weight: var(--weight-bold);
    color: var(--color-text);
  }
  .cat-tag {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }
  .cat-link {
    margin-top: var(--space-2);
    color: var(--color-accent);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    font-size: var(--text-body-sm);
  }
  .cat-link:hover { text-decoration: underline; }
  .cat-current-mark {
    margin-top: var(--space-2);
    padding: 4px 12px;
    background: var(--color-accent);
    color: #fff;
    font-size: var(--text-caption);
    font-weight: var(--weight-bold);
    border-radius: var(--radius-full);
  }

  /* program-card */
  .program-card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-card);
    max-width: 880px;
  }
  .program-header { margin-bottom: var(--space-6); }
  .program-tag {
    font-family: var(--font-en);
    font-size: var(--text-caption);
    font-weight: var(--weight-bold);
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }
  .program-title {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    font-weight: var(--weight-bold);
    color: var(--color-text);
