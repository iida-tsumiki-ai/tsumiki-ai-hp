---
/**
 * SiteHeader — 全ページ共通ヘッダー（ナビゲーション）
 * 設計書: DESIGN.md §5 Navigation / 11_HPリニューアル_設計書.md L1 の14ページ体系
 *
 * 仕様:
 *   - 高さ 72px / 背景 #FFFFFF → スクロール後 rgba(255,255,255,0.85) + blur
 *   - ロゴ左 / テキストナビ 5本 / accent CTA 1つ（AI駆動経営診断）
 *   - モバイル: ハンバーガー → warm 背景の全画面オーバーレイ
 */

type NavLink = { href: string; label: string };

/**
 * ナビ構造: 3形態（講座/研修/伴走）フラット並列 + 全商品マップ + 会社情報
 * 主力プロダクト（Lv1講座 / AI駆動経営伴走支援）はホーム §3 + Footer で導線維持。
 * ヘッダーは "ツミキAIには3つの届け方がある" を一直線で見せる構造。
 * 経営者合同セミナーは商品ラインナップから外出し（2026-05-03）。
 */
const navLinks: NavLink[] = [
  { href: "/products/", label: "商品" },
  { href: "/courses/", label: "講座" },
  { href: "/training/", label: "研修" },
  { href: "/support/", label: "伴走" },
  { href: "/about/", label: "会社情報" },
];

const ctaPrimaryHref = "/diagnose/";
const ctaPrimaryLabel = "AI駆動経営診断（無料）";
const ctaSecondaryHref = "/contact/";
const ctaSecondaryLabel = "無料個別相談";
---

<header class="site-header" data-header>
  <div class="header-inner">
    <a class="brand" href="/" aria-label="積み木AI ホームへ">
      <span class="brand-mark" aria-hidden="true">
        <svg width="36" height="36" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="4" y="16" width="20" height="8" rx="2" fill="#FAF7F2" stroke="#E5E7EB" />
          <rect x="7" y="10" width="14" height="7" rx="2" fill="#FFE5D6" />
          <rect x="10" y="4" width="8" height="7" rx="2" fill="#1A3A5F" />
        </svg>
      </span>
      <span class="brand-text">積み木AI</span>
    </a>

    <nav class="desktop-nav" aria-label="主要ナビゲーション">
      <ul>
        {
          navLinks.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-cta-group">
      <a class="header-cta header-cta--secondary" href={ctaSecondaryHref}>{ctaSecondaryLabel}</a>
      <a class="header-cta header-cta--primary" href={ctaPrimaryHref}>{ctaPrimaryLabel}</a>
    </div>

    <button
      type="button"
      class="hamburger"
      aria-label="メニューを開く"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-hamburger
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>

  <!-- モバイルオーバーレイ -->
  <div class="mobile-overlay" id="mobile-nav" hidden data-mobile-overlay>
    <div class="mobile-inner">
      <button
        type="button"
        class="close-btn"
        aria-label="メニューを閉じる"
        data-close
      >
        <span aria-hidden="true">×</span>
      </button>

      <nav aria-label="モバイルナビゲーション">
        <ul class="mobile-list">
          {
            navLinks.map((l) => (
              <li>
                <a href={l.href} data-nav-link>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="mobile-cta-group">
        <a class="mobile-cta mobile-cta--primary" href={ctaPrimaryHref} data-nav-link>
          {ctaPrimaryLabel} →
        </a>
        <a class="mobile-cta mobile-cta--secondary" href={ctaSecondaryHref} data-nav-link>
          {ctaSecondaryLabel} →
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const hamburger = document.querySelector<HTMLButtonElement>("[data-hamburger]");
  const overlay = document.querySelector<HTMLElement>("[data-mobile-overlay]");
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-close]");
  const navLinks = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");

  // スクロール時の blur + 薄透明切替
  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 20) {
      header.classList.add("scrolled");
    } else {
      header.classList.remove("scrolled");
    }
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // ハンバーガー開閉
  const openMenu = () => {
    if (!overlay || !hamburger) return;
    overlay.hidden = false;
    requestAnimationFrame(() => overlay.classList.add("is-open"));
    hamburger.setAttribute("aria-expanded", "true");
    document.body.classList.add("nav-open");
  };

  const closeMenu = () => {
    if (!overlay || !hamburger) return;
    overlay.classList.remove("is-open");
    hamburger.setAttribute("aria-expanded", "false");
    document.body.classList.remove("nav-open");
    // トランジション後に hidden 付与（300ms）
    window.setTimeout(() => {
      if (!overlay.classList.contains("is-open")) {
        overlay.hidden = true;
      }
    }, 300);
  };

  hamburger?.addEventListener("click", openMenu);
  closeBtn?.addEventListener("click", closeMenu);

  // オーバーレイ内のリンククリックで自動で閉じる
  navLinks.forEach((a) => a.addEventListener("click", closeMenu));

  // ESC で閉じる
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && overlay && !overlay.hidden) closeMenu();
  });

  // ============================================================
  // カスタム スムーススクロール（CSS smooth より少しゆっくり）
  // ============================================================
  // リロード時にブラウザがスクロール位置を復元するのを抑止
  // （アンカーリンクのある SPA-like なホームでは毎回トップから始めたい）
  if ("scrollRestoration" in history) {
    history.scrollRestoration = "manual";
  }

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const SCROLL_DURATION = 900; // ms
  const HEADER_OFFSET = 80;

  function easeInOutCubic(t: number): number {
    return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
  }

  function smoothScrollTo(targetY: number, duration: number = SCROLL_DURATION) {
    const startY = window.scrollY;
    const distance = targetY - startY;
    const startTime = performance.now();

    function step(currentTime: number) {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const eased = easeInOutCubic(progress);
      window.scrollTo(0, startY + distance * eased);
      if (progress < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  // ページ内アンカーリンク（#xxx）のクリックを拾って、カスタム速度でスクロール
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
    link.addEventListener("click", (e) => {
      const href = link.getAttribute("href");
      if (!href || href === "#") return;
      const target = document.querySelector(href);
      if (!target) return;
      e.preventDefault();
      if (reduceMotion) {
        target.scrollIntoView({ behavior: "auto", block: "start" });
        return;
      }
      const targetY =
        target.getBoundingClientRect().top + window.scrollY - HEADER_OFFSET;
      smoothScrollTo(targetY);
      // URL に # を残さない（リロード時にスクロール復元させない）
      if (window.location.hash) {
        history.replaceState(null, "", window.location.pathname + window.location.search);
      }
    });
  });
</script>

<style is:global>
  /* body スクロール抑止（オーバーレイ展開時） */
  body.nav-open {
    overflow: hidden;
  }

  /* アンカーリンクがヘッダーに隠れないよう & スムーススクロール */
  html {
    scroll-padding-top: 80px;
    scroll-behavior: smooth;
  }
  /* OS設定で動きを抑える設定の人には respect する */
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>

<style>
  .site-header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: #ffffff;
    transition:
      background-color var(--duration-hover) var(--ease-out-quint),
      box-shadow var(--duration-hover) var(--ease-out-quint),
      backdrop-filter var(--duration-hover) var(--ease-out-quint);
  }
  .site-header.scrolled {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: var(--shadow-xs);
  }

  .header-inner {
    max-width: var(--container-lg);
    margin: 0 auto;
    padding: var(--space-3) var(--gutter);
    min-height: 84px;
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: var(--space-6);
  }

  /* Brand */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: inherit;
    transition: transform var(--duration-hover) var(--ease-out-quint);
  }
  .brand:hover {
    transform: translateY(-1px);
  }
  .brand-mark {
    display: inline-flex;
  }
  .brand-text {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
    color: var(--color-primary);
    letter-spacing: 0.02em;
    line-height: 1;
  }

  /* Desktop Nav */
  .desktop-nav {
    justify-self: end;
  }
  .desktop-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }
  .desktop-nav a {
    position: relative;
    font-family: var(--font-jp);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    text-decoration: none;
    padding: var(--space-2) 0;
    transition: color var(--duration-hover) var(--ease-out-quint);
  }
  /* アンダーライン スライドイン演出（中央から左右へ） */
  .desktop-nav a::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 0;
    height: 2px;
    background: var(--color-primary);
    transition:
      width var(--duration-hover) var(--ease-out-quint),
      left var(--duration-hover) var(--ease-out-quint);
  }
  .desktop-nav a:hover {
    color: var(--color-primary);
  }
  .desktop-nav a:hover::after {
    width: 100%;
    left: 0;
  }

  /* CTA Group (primary + secondary) */
  .header-cta-group {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }
  .header-cta {
    display: inline-flex;
    align-items: center;
    height: var(--button-height-md);
    padding: 0 var(--space-6);
    border-radius: var(--radius-md);
    font-family: var(--font-jp);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--duration-hover) var(--ease-out-quint),
      color var(--duration-hover) var(--ease-out-quint),
      transform var(--duration-hover) var(--ease-out-quint),
      box-shadow var(--duration-hover) var(--ease-out-quint);
  }
  .header-cta--primary {
    background: var(--color-primary);
    color: #fff;
    box-shadow: var(--shadow-button);
  }
  .header-cta--primary:hover {
    background: var(--color-primary-hover);
    color: #fff;
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }
  .header-cta--secondary {
    background: transparent;
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
  }
  .header-cta--secondary:hover {
    background: var(--color-primary);
    color: #fff;
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  /* Hamburger */
  .hamburger {
    display: none;
    width: 44px;
    height: 44px;
    padding: 10px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    flex-direction: column;
    justify-content: space-between;
  }
  .hamburger span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--color-primary);
    border-radius: 2px;
  }

  /* Mobile Overlay */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    background: var(--color-bg-warm);
    z-index: 200;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-page) var(--ease-out-quint);
  }
  .mobile-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  .mobile-overlay[hidden] {
    display: none;
  }

  .mobile-inner {
    height: 100%;
    padding: var(--space-8) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    justify-content: center;
    align-items: stretch;
    max-width: 480px;
    margin: 0 auto;
  }

  .close-btn {
    position: absolute;
    top: calc((var(--header-height) - 44px) / 2);
    right: var(--gutter);
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    cursor: pointer;
    font-family: var(--font-en);
    font-size: 28px;
    font-weight: var(--weight-regular);
    color: var(--color-primary);
    line-height: 1;
  }

  .mobile-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .mobile-list a {
    display: block;
    font-family: var(--font-jp-serif);
    font-size: var(--text-h3);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    text-decoration: none;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .mobile-list a:hover,
  .mobile-list a:focus {
    color: var(--color-accent);
  }

  .mobile-cta-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .mobile-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-md);
    font-family: var(--font-jp);
    font-size: var(--text-body-lg);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }
  .mobile-cta--primary {
    background: var(--color-primary);
    color: #fff;
    box-shadow: var(--shadow-button);
  }
  .mobile-cta--secondary {
    background: transparent;
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
  }

  /* ========================================
   * Responsive
   * ======================================== */
  @media (max-width: 1023px) {
    .desktop-nav ul {
      gap: var(--space-4);
    }
    .desktop-nav a {
      font-size: var(--text-caption);
    }
  }

  @media (max-width: 768px) {
    .header-inner {
      grid-template-columns: auto 1fr auto;
    }
    .desktop-nav,
    .header-cta-group {
      display: none;
    }
    .hamburger {
      display: flex;
      justify-self: end;
    }
  }
</style>
