---
/**
 * OGP プレビューページ
 * 1200×630 固定で OGP 画像（og-default.png）の元になる HTML/CSS を提供する。
 * 用途: headless Chrome で本ページを 1200×630 スクショして
 *       public/images/og-default.png として保存する。
 *
 * 再生成手順:
 *   1. `npm run build && npx astro preview --port 4322` を稼働
 *   2. /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome \
 *        --headless=new --hide-scrollbars --force-device-scale-factor=1 \
 *        --window-size=1200,900 --virtual-time-budget=5000 \
 *        --screenshot=/tmp/og-large.png \
 *        http://localhost:4322/og-default-preview/
 *   3. python3 -c "from PIL import Image; Image.open('/tmp/og-large.png').crop((0,0,1200,630)).save('public/images/og-default.png', optimize=True)"
 *
 * 注: --window-size=1200,630 で直接撮ると Chrome のビューポート計算で
 *     最下部数十pxが切れる現象あり（タグラインが見切れる）。1200×900 で撮って
 *     上から 1200×630 を切り出すのが安全。
 *
 * Hero.astro / DESIGN.md 準拠（`--color-primary` `--color-accent-soft` 等の色を継承）。
 * noindex で検索対象外。
 */
import "../styles/tokens.css";
import "../styles/global.css";
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <title>OGP Default Preview — ツミキAI</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;600;700;900&family=Shippori+Mincho:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="og-canvas">
      <div class="og-bg-spotlight"></div>
      <span class="og-bg-block og-bg-block--a"></span>
      <span class="og-bg-block og-bg-block--b"></span>

      <div class="og-content">
        <!-- LEFT: ロゴ＋ブランドコピー -->
        <div class="og-text">
          <img
            class="og-logo"
            src="/images/logo.png"
            alt="ツミキAI / Tsumiki AI"
          />
          <h1 class="og-h1">
            <span class="og-h1-line">
              <span class="og-h1-accent">1</span>段ずつ、着実に。
            </span>
            <span class="og-h1-line">AI駆動経営へ。</span>
          </h1>
          <p class="og-tagline">中小企業のための AI内製化伴走ブランド</p>
        </div>

        <!-- RIGHT: 積み木スタック（Hero と同じ） -->
        <div class="og-visual" aria-hidden="true">
          <div class="og-stack">
            <div class="og-block og-block--4">
              <span class="og-block-num">04</span>
              <span class="og-block-name">AIネイティブ</span>
            </div>
            <div class="og-block og-block--3">
              <span class="og-block-num">03</span>
              <span class="og-block-name">戦略を描く</span>
            </div>
            <div class="og-block og-block--2">
              <span class="og-block-num">02</span>
              <span class="og-block-name">活用を広げる</span>
            </div>
            <div class="og-block og-block--1">
              <span class="og-block-num">01</span>
              <span class="og-block-name">土台を組む</span>
            </div>
            <div class="og-stack-base"></div>
          </div>
        </div>
      </div>
    </div>

    <style>
      html, body {
        margin: 0;
        padding: 0;
        background: #fff;
      }
      body {
        font-family: var(--font-jp);
      }
      /* dev mode の Astro ツールバーを画像キャプチャから隠す */
      astro-dev-toolbar,
      astro-dev-overlay {
        display: none !important;
      }

      .og-canvas {
        position: fixed;
        top: 0;
        left: 0;
        width: 1200px;
        height: 630px;
        background: var(--color-bg-warm);
        overflow: hidden;
        isolation: isolate;
      }

      /* 中央スポットライト */
      .og-bg-spotlight {
        position: absolute;
        inset: 0;
        background:
          radial-gradient(ellipse 60% 75% at 75% 60%, rgba(255, 229, 214, 0.55) 0%, transparent 70%);
        pointer-events: none;
        z-index: 0;
      }

      /* 装飾積み木 */
      .og-bg-block {
        position: absolute;
        border-radius: var(--radius-md);
        z-index: 0;
      }
      .og-bg-block--a {
        top: 6%;
        right: 4%;
        width: 130px;
        height: 130px;
        background: rgba(26, 58, 95, 0.05);
        border: 1px solid rgba(26, 58, 95, 0.10);
        transform: rotate(8deg);
      }
      .og-bg-block--b {
        bottom: 8%;
        left: 4%;
        width: 90px;
        height: 90px;
        background: rgba(255, 107, 53, 0.10);
        border: 1px solid rgba(255, 107, 53, 0.18);
        transform: rotate(-6deg);
      }

      .og-content {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 32px;
        height: 100%;
        padding: 56px 64px 72px 64px;
        box-sizing: border-box;
      }

      /* ===== LEFT ===== */
      .og-text {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
      }
      .og-logo {
        height: 100px;
        width: auto;
        display: block;
        align-self: flex-start; /* flex column の align-items: stretch を上書き */
        flex-shrink: 0;
        object-fit: contain;
      }
      .og-h1 {
        font-family: var(--font-jp-serif);
        font-weight: 700;
        font-size: 64px;
        line-height: 1.25;
        letter-spacing: -0.01em;
        color: var(--color-primary);
        margin: 0;
      }
      .og-h1-line {
        display: block;
      }
      .og-h1-accent {
        color: var(--color-accent);
      }
      .og-tagline {
        font-family: var(--font-jp);
        font-weight: 500;
        font-size: 22px;
        color: var(--color-text-muted);
        margin: 0;
      }

      /* ===== RIGHT: stack ===== */
      .og-visual {
        position: relative;
        display: flex;
        align-items: flex-end;
        justify-content: flex-start;
        height: 100%;
      }
      .og-stack {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
        width: 100%;
        max-width: 460px;
      }
      .og-stack-base {
        align-self: stretch;
        height: 14px;
        margin-top: 6px;
        background:
          radial-gradient(ellipse 60% 100% at 50% 0%, rgba(26, 58, 95, 0.18) 0%, transparent 70%);
      }

      .og-block {
        position: relative;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 22px;
        border-radius: var(--radius-md);
        color: var(--color-text);
        background-image: linear-gradient(180deg, rgba(255,255,255,0.12) 0%, transparent 30%);
        box-shadow: var(--shadow-sm);
      }
      /* 立体感（側面影） */
      .og-block::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: var(--block-side, rgba(26, 58, 95, 0.14));
        transform: translate(5px, 7px);
        z-index: -1;
      }
      .og-block-num {
        font-family: var(--font-en);
        font-weight: 700;
        font-size: 13px;
        letter-spacing: 0.06em;
        color: inherit;
        opacity: 0.65;
      }
      .og-block-name {
        font-family: var(--font-jp-serif);
        font-weight: 600;
        font-size: 18px;
        white-space: nowrap;
      }

      .og-block--1 {
        width: 96%;
        background: var(--color-bg-warm);
        border: 1px solid var(--color-border);
        --block-side: #E8DFCE;
      }
      .og-block--2 {
        width: 78%;
        background: var(--color-bg-subtle);
        border: 1px solid var(--color-border);
        margin-left: 28px;
        --block-side: #DCD7C9;
      }
      .og-block--3 {
        width: 62%;
        background: var(--color-accent-soft);
        color: #B84A1E;
        margin-left: 56px;
        --block-side: #F4C5A4;
      }
      .og-block--4 {
        width: 44%;
        background: var(--color-primary);
        color: #fff;
        margin-left: 84px;
        box-shadow: var(--shadow-md);
        --block-side: #102845;
      }
    </style>
  </body>
</html>
