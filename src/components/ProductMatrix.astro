---
/**
 * ProductMatrix — ホーム §3「3カテゴリ × 4ステージ 商品ポートフォリオ」
 * 設計書: 11_HPリニューアル_設計書.md §1 §3 (D案9ブロック構成 / 2026-04-24 案X反映)
 * データ: src/data/products.ts（3カテゴリ×4ステージ + ロードマップ講座）
 *
 * 軸:
 *   - 行: 4ステージ（❶土台を組む / ❷活用を広げる / ❸戦略を描く / ❹AIネイティブになる）
 *   - 列: 3カテゴリ（A.経営者が先に学ぶ / B.組織に入れる / C.一緒に実行する）
 *
 * 各セルは1〜2商品を含む（A ❸❹ は講座+集合学習の2枚、B ❸❹ は空）
 *
 * 2026-04-28 案α: C列は AI駆動経営伴走支援1商品で Lv1-Lv4 をカバー（grid-row span 4）。
 *
 * レスポンシブ方針:
 *   - PC (≥ 900px): 4ステージ × 3カテゴリ のフルグリッド表示（grid-row span 対応）
 *   - モバイル: ステージ選択タブで該当ステージの3カテゴリ分を表示
 *     ※ C列 span セルは data-span-all で全タブ常時表示
 */

import {
  productCells,
  roadmapCourse,
  stageLabels,
  categoryLabels,
  type Category,
  type Stage,
} from "../data/products";

const stages: Stage[] = [1, 2, 3, 4];
const categories: Category[] = ["learn", "deploy", "execute"];

/**
 * カテゴリ別 SVG アイコン（Lucide ベース / regular weight）
 * - learn   = BookOpen   経営者が学ぶ
 * - deploy  = Users      担当者チーム
 * - execute = Handshake  伴走（経営者+現場 と社外CTO）
 * 色は currentColor で親要素から継承
 */
const categoryIcons: Record<Category, string> = {
  learn: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
  deploy: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  execute: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m11 17 2 2a1 1 0 1 0 3-3"/><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/><path d="m21 3 1 11h-2"/><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"/><path d="M3 4h8"/></svg>`,
};
---

<div class="matrix-block">
  <header class="matrix-head">
    <p class="kicker">§3 3つの始め方 × 4ステージ</p>
    <h2 class="display-sm">3つの始め方。あなたの現在地から、上へ。</h2>
    <p class="lead">
      経営者が学ぶか／組織に入れるか／一緒に実行するか — <strong>3つの始め方</strong>が、4ステージの階段で繋がっています。
      自社の今のステージから、次の一手が見つかる商品マップです。<br />
      価格は<strong>無料〜月¥30万</strong>。個別見積もりで濁さず、各マスにそのまま記載しています。
    </p>
    <details class="matrix-callout">
      <summary>4ステージの考え方</summary>
      <p>
        <strong>Lv.1 土台を組む → Lv.2 活用を広げる → Lv.3 戦略を描く → Lv.4 AIネイティブになる</strong> の4段の階段。
        前半 <strong>Lv.1-Lv.2 は DX領域</strong>（業務をデジタル化する段階）、後半 <strong>Lv.3-Lv.4 は AI領域</strong>（AIで会社を動かす経営=AI駆動経営へ進化する段階）。
        到達点 Lv.4 が、AI内製化が定着して企業価値を高め続けられる「<strong>AIネイティブな会社</strong>」です。
      </p>
    </details>
  </header>

  <!-- 3つの始め方ヘッダ（カテゴリ別の入口カード）-->
  <div class="start-headers" role="list" aria-label="3つの始め方">
    {
      categories.map((cat) => (
        <div class={`start-card start-card--${cat}`} role="listitem">
          <span class="start-card-icon" set:html={categoryIcons[cat]} />
          <h3 class="start-card-label">{categoryLabels[cat].label}</h3>
          <p class="start-card-tagline">{categoryLabels[cat].tagline}</p>
          <p class="start-card-price">{categoryLabels[cat].priceRange}</p>
          <a class="start-card-cta" href={categoryLabels[cat].hubHref}>
            {categoryLabels[cat].hubLabel} →
          </a>
        </div>
      ))
    }
  </div>

  <!-- ロードマップ講座（無料入口 / カテゴリA） -->
  <a class="roadmap-card" href={roadmapCourse.href}>
    <div class="roadmap-badge">無料 / 全ステージ共通</div>
    <div class="roadmap-body">
      <h3 class="roadmap-title">{roadmapCourse.name}</h3>
      <p class="roadmap-desc">{roadmapCourse.description}</p>
    </div>
    <span class="roadmap-cta" aria-hidden="true">読む →</span>
  </a>

  <!-- モバイル: ステージ選択タブ -->
  <div class="stage-tabs" role="tablist" aria-label="ステージを選ぶ">
    {
      stages.map((s) => (
        <button
          type="button"
          class="stage-tab"
          role="tab"
          aria-selected={s === 1 ? "true" : "false"}
          data-stage={s}
        >
          {stageLabels[s].short}
        </button>
      ))
    }
  </div>

  <!-- グリッド本体 -->
  <div class="matrix-grid" role="table" aria-label="3カテゴリ × 4ステージ の商品マップ">
    <!-- 列ヘッダ: カテゴリ -->
    <div class="grid-corner" aria-hidden="true"></div>
    {
      categories.map((cat) => (
        <div class={`cat-header cat-header--${cat}`} role="columnheader">
          <span class="cat-user" set:html={categoryIcons[cat]} />
          <span class="cat-name">{categoryLabels[cat].label}</span>
          <span class="cat-effect">{categoryLabels[cat].effect}</span>
        </div>
      ))
    }

    <!-- 4ステージ × 3カテゴリ のセル群（明示的 grid-row/column 指定で span 対応） -->
    {
      stages.map((s, sIdx) => (
        <>
          <div
            class={`stage-label stage-label--${s <= 2 ? "dx" : "ai"}`}
            data-stage={s}
            role="rowheader"
            style={{ gridColumn: 1, gridRow: sIdx + 2 }}
          >
            <span class="stage-zone-tag">{s <= 2 ? "DX領域" : "AI領域"}</span>
            <span class="stage-label-inner">{stageLabels[s].full}</span>
          </div>
          {categories.map((cat, cIdx) => {
            // C列で stage>1 はスパン継続行のためスキップ
            const isSpanContinuation = cat === "execute" && s > 1;
            if (isSpanContinuation) return null;

            const cells = productCells.filter(
              (c) => c.stage === s && c.category === cat
            );
            const firstCell = cells[0];
            const span = firstCell?.stageEnd
              ? firstCell.stageEnd - firstCell.stage + 1
              : 1;
            const gridStyle = {
              gridColumn: cIdx + 2,
              gridRow: span > 1 ? `${sIdx + 2} / span ${span}` : sIdx + 2,
            };
            const spanAttr = span > 1 ? "true" : undefined;

            if (cells.length === 0) {
              return (
                <div
                  class={`cell-group cell-group--empty cat-${cat}`}
                  data-stage={s}
                  data-category={cat}
                  style={gridStyle}
                >
                  <p class="empty-note">
                    {cat === "deploy" && s >= 3
                      ? "Lv.3-Lv.4 は経営者が自ら学ぶ／一緒に実行するフェーズです。担当者向け研修は Lv.1-Lv.2 までとなります。"
                      : "—"}
                  </p>
                </div>
              );
            }

            return (
              <div
                class={`cell-group cat-${cat} ${span > 1 ? "cell-group--span" : ""}`}
                data-stage={s}
                data-category={cat}
                data-span-all={spanAttr}
                style={gridStyle}
              >
                {cells.map((cell) => {
                  const classes = [
                    "cell",
                    `cell--${cat}`,
                    cell.isOz ? "cell--oz" : "",
                    cell.isUnavailable ? "cell--unavailable" : "",
                    cell.stageEnd ? "cell--span" : "",
                  ]
                    .filter(Boolean)
                    .join(" ");

                  const content = (
                    <>
                      {cell.isOz && <span class="cell-tag">オズ方式</span>}
                      {cell.isUnavailable && <span class="cell-tag">販売なし</span>}
                      {cell.stageEnd && (
                        <span class="cell-tag cell-tag--span">Lv1-Lv4 共通</span>
                      )}
                      <div class="cell-name">{cell.name}</div>
                      <div class="cell-price">
                        {cell.price}
                        {cell.priceNote && (
                          <small class="cell-price-note">（{cell.priceNote}）</small>
                        )}
                      </div>
                      <p class="cell-desc">{cell.description}</p>
                    </>
                  );

                  return cell.href ? (
                    <a href={cell.href} class={classes}>
                      {content}
                    </a>
                  ) : (
                    <div class={classes}>{content}</div>
                  );
                })}
              </div>
            );
          })}
        </>
      ))
    }
  </div>

  <!-- セクションCTA -->
  <div class="matrix-cta">
    <a class="btn btn-primary" href="/diagnose/">AI駆動経営診断で現在地を知る</a>
  </div>

  <p class="matrix-note">
    C列「AI駆動経営伴走支援」は Lv1-Lv4 を1サービスでカバー（現在地に応じて進め方が変わります）／
    B❹ は空（Lv4 は研修なし — AI駆動経営伴走支援で個別対応）
  </p>
</div>

<script>
  // モバイル: ステージタブの切替
  const tabs = document.querySelectorAll<HTMLButtonElement>(".stage-tab");
  const matrixGrid = document.querySelector<HTMLElement>(".matrix-grid");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const stage = tab.dataset.stage;
      if (!stage || !matrixGrid) return;

      tabs.forEach((t) => t.setAttribute("aria-selected", "false"));
      tab.setAttribute("aria-selected", "true");
      matrixGrid.dataset.activeStage = stage;
    });
  });

  if (matrixGrid) {
    matrixGrid.dataset.activeStage = "1";
  }
</script>

<style>
  .matrix-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* Section Header */
  .matrix-head {
    max-width: 720px;
  }
  .kicker {
    font-family: var(--font-en);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 var(--space-3) 0;
  }
  .display-sm {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-4) 0;
    letter-spacing: var(--tracking-heading);
  }
  .lead {
    font-size: var(--text-body-lg);
    line-height: var(--leading-body-lg);
    color: var(--color-text-body);
    margin: 0;
  }
  .lead strong {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }

  /* DX→AI領域の補足（折りたたみ） */
  .matrix-callout {
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-body-sm);
    color: var(--color-text-body);
  }
  .matrix-callout summary {
    cursor: pointer;
    font-family: var(--font-jp);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    list-style-position: outside;
  }
  .matrix-callout summary::marker {
    color: var(--color-accent);
  }
  .matrix-callout p {
    margin: var(--space-3) 0 0;
    line-height: var(--leading-body);
  }
  .matrix-callout strong {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }

  /* 3つの始め方 ヘッダカード（カテゴリ別の入口）*/
  .start-headers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  .start-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    border-top: 4px solid var(--color-border);
    box-shadow: var(--shadow-card);
  }
  .start-card--learn {
    border-top-color: var(--color-primary);
  }
  .start-card--deploy {
    border-top-color: #8A8270;
  }
  .start-card--execute {
    border-top-color: var(--color-accent);
  }
  .start-card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--color-bg-warm);
    color: var(--color-primary);
  }
  .start-card-icon :global(svg) {
    width: 24px;
    height: 24px;
  }
  .start-card-label {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    margin: 0;
  }
  .start-card-tagline {
    font-family: var(--font-jp);
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
    color: var(--color-text-body);
    margin: 0;
  }
  .start-card-price {
    font-family: var(--font-en), var(--font-jp);
    font-size: var(--text-body);
    font-weight: var(--weight-bold);
    color: #B84A1E;
    font-feature-settings: "tnum";
    margin: 0;
  }
  .start-card-cta {
    align-self: flex-start;
    margin-top: auto;
    padding-top: var(--space-2);
    font-family: var(--font-jp);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-hover) var(--ease-out-quint);
  }
  .start-card-cta:hover {
    border-bottom-color: var(--color-primary);
  }
  @media (max-width: 899px) {
    .start-headers {
      grid-template-columns: 1fr;
    }
  }

  /* ロードマップカード（無料入口） */
  .roadmap-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-6) var(--space-8);
    background: var(--color-bg-warm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-card);
    transition:
      box-shadow var(--duration-hover) var(--ease-out-quint),
      transform var(--duration-hover) var(--ease-out-quint);
  }
  .roadmap-card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
    color: inherit;
  }
  .roadmap-badge {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    background: var(--color-accent-soft);
    color: #B84A1E;
    border-radius: var(--radius-full);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    white-space: nowrap;
  }
  .roadmap-title {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h3);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    margin: 0 0 var(--space-2) 0;
  }
  .roadmap-desc {
    font-size: var(--text-body);
    color: var(--color-text-body);
    margin: 0;
  }
  .roadmap-cta {
    font-family: var(--font-en);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    white-space: nowrap;
  }

  /* ステージタブ（モバイル専用） */
  .stage-tabs {
    display: none;
    gap: var(--space-2);
    overflow-x: auto;
    padding-bottom: var(--space-2);
  }
  .stage-tab {
    flex-shrink: 0;
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-family: var(--font-jp);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      background-color var(--duration-hover) var(--ease-out-quint),
      color var(--duration-hover) var(--ease-out-quint);
  }
  .stage-tab[aria-selected="true"] {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }

  /* マトリックスグリッド（PC: 4ステージ × 3カテゴリ） */
  .matrix-grid {
    display: grid;
    grid-template-columns: 140px repeat(3, 1fr);
    gap: var(--space-3);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-card);
  }

  .grid-corner {
    /* 左上の空セル */
  }

  /* 列ヘッダ（カテゴリ） */
  .cat-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 2px;
    text-align: center;
    padding: var(--space-3) var(--space-2);
    border-radius: var(--radius-md);
  }
  .cat-header--learn { background: rgba(224, 122, 59, 0.08); }
  .cat-header--deploy { background: rgba(138, 130, 112, 0.10); }
  .cat-header--execute { background: rgba(224, 122, 59, 0.14); }

  .cat-user {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: var(--color-primary);
  }
  .cat-user :global(svg) {
    width: 20px;
    height: 20px;
  }
  .cat-name {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h4);
    font-weight: var(--weight-semibold);
    color: var(--color-primary);
  }
  .cat-effect {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }

  /* 行ヘッダ（ステージ） */
  .stage-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    background: var(--color-bg-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-2);
    min-height: 140px;
  }
  /* DX領域 (Lv.1-Lv.2) のゾーン色 — フラット背景 + 左帯 */
  .stage-label--dx {
    background: var(--color-bg-subtle);
    border-left: 3px solid rgba(120,120,140,0.4);
  }
  .stage-label--dx .stage-zone-tag {
    background: rgba(120,120,140,0.18);
    color: #4a4a55;
  }
  /* AI領域 (Lv.3-Lv.4) のゾーン色 — フラット背景 + 左帯 */
  .stage-label--ai {
    background: rgba(255,107,53,0.06);
    border-left: 3px solid var(--color-accent);
  }
  .stage-label--ai .stage-zone-tag {
    background: rgba(255,107,53,0.18);
    color: var(--color-accent);
  }
  .stage-zone-tag {
    display: inline-block;
    font-family: var(--font-en);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }
  .stage-label-inner {
    font-family: var(--font-jp-serif);
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
    color: var(--color-primary);
    writing-mode: vertical-rl;
    letter-spacing: 0.05em;
  }

  /* セルグループ（1カテゴリ×1ステージのコンテナ / 1〜2枚のカードを含む） */
  .cell-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-height: 140px;
  }
  .cell-group--empty {
    background: repeating-linear-gradient(
      135deg,
      var(--color-bg-subtle),
      var(--color-bg-subtle) 8px,
      var(--color-bg) 8px,
      var(--color-bg) 16px
    );
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
  }
