---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Container from "../components/Container.astro";
import Hero from "../components/Hero.astro";
import DifferentiationPoints from "../components/DifferentiationPoints.astro";
import ProductMatrix from "../components/ProductMatrix.astro";
import RepMessage from "../components/RepMessage.astro";
import FAQ from "../components/FAQ.astro";
import NoteFeed from "../components/NoteFeed.astro";
import FinalCTA from "../components/FinalCTA.astro";
---

<Layout>
  <main>
    <!-- §1. HERO（本実装 / 積み木ビジュアル + ダブルCTA） -->
    <Section size="l" background="default" id="hero">
      <Container>
        <Hero />
      </Container>
    </Section>

    <!-- §2. 差別化3点セット -->
    <Section size="l" background="warm" id="differentiation">
      <Container>
        <DifferentiationPoints />
      </Container>
    </Section>

    <!-- §3. 4ステージ × 商品マトリックス 統合 -->
    <Section size="l" background="subtle" id="product-matrix">
      <Container>
        <ProductMatrix />
      </Container>
    </Section>

    <!-- §5. 代表メッセージ（エピソード型） -->
    <Section size="l" background="warm" id="rep-message">
      <Container>
        <RepMessage />
      </Container>
    </Section>

    <!-- §6. よくある7つの質問（FAQ 中核） -->
    <Section size="l" background="default" id="faq">
      <Container>
        <FAQ />
      </Container>
    </Section>

    <!-- §7. note最新記事ブロック -->
    <Section size="l" background="subtle" id="note-feed">
      <Container>
        <NoteFeed />
      </Container>
    </Section>

    <!-- §8. 最終CTA（段階化） -->
    <Section size="l" background="default" id="final-cta">
      <Container>
        <FinalCTA />
      </Container>
    </Section>
  </main>
</Layout>

