---
import Layout from "../../../layouts/Layout.astro";
import CourseLandingPage from "../../../components/CourseLandingPage.astro";

const audience = [
  { text: "「うちはAI／DXで何ができるんだろう」と全体像を掴めずにいる経営者" },
  { text: "どこから始めればいいかわからず、最初の一歩を踏み出せない方" },
  { text: "DX診断を受けて、まず現在地と4段階の地図を持ちたい方" },
  { text: "ツミキAIの講座シリーズを買う前に、無料で性格を確かめたい方" },
];

const chapterParts = [
  {
    partLabel: "Part 1",
    partTitle: "なぜ今、中小企業がAIなのか",
    partDuration: "10分",
    chapters: [
      { no: 1, title: "中小企業が後回しにされてきた理由", duration: "5分", body: "240万社規模のインフラを支えてきた経験から見えた構造的な課題。" },
      { no: 2, title: "AIで変わる前提条件", duration: "5分", body: "「DXで遅れた会社こそ、AI駆動経営で先に着く」逆説的ポジション。" },
    ],
  },
  {
    partLabel: "Part 2",
    partTitle: "4段階ロードマップ：Lv1→Lv4",
    partDuration: "30分",
    chapters: [
      { no: 3, title: "Lv1 ❶ 土台を組む（DX領域）", duration: "8分", body: "クラウド基盤の導入と全社展開。1部門スモールスタート→全社へ。" },
      { no: 4, title: "Lv2 ❷ 活用を広げる（DX領域）", duration: "8分", body: "AI活用の全社底上げ・業務棚卸し・ミニアプリの型。" },
      { no: 5, title: "Lv3 ❸ 戦略を描く（AI領域）", duration: "7分", body: "基幹系再選定・組織役割設計。「AI駆動経営の本領」が始まる段階。" },
      { no: 6, title: "Lv4 ❹ AIネイティブになる（AI領域）", duration: "7分", body: "自律化・内製化定着。ツミキAIから自走していただく到達域。" },
    ],
  },
  {
    partLabel: "Part 3",
    partTitle: "Lv間の壁とツミキAIの3カテゴリ",
    partDuration: "25分",
    chapters: [
      { no: 7, title: "Lv1→Lv2の壁：基盤の全社共通化", duration: "5分", body: "「触る人／触らない人」分断を防ぐ仕組み。" },
      { no: 8, title: "Lv2→Lv3の壁：個別効率化から戦略転換へ", duration: "5分", body: "最も高い壁。基幹系再選定と組織設計のレイヤー。" },
      { no: 9, title: "Lv3→Lv4の壁：自動化から自律化へ", duration: "5分", body: "エージェント化と人間の介在ポイント設計。" },
      { no: 10, title: "ツミキAIの3カテゴリ商品マップ", duration: "5分", body: "A.経営者が先に学ぶ／B.組織に入れる／C.一緒に実行する の使い分け。" },
      { no: 11, title: "次の一手を決める", duration: "5分", body: "DX診断の活用、Lv別の入口、無料個別相談へのつなぎ方。" },
    ],
  },
];

const cantDo = [
  {
    title: "具体的なツール選定の正解は示しません",
    body: "「うちはGWS／MS365どちら？」のような個別判断は、Lv1講座（¥3,000）以降で扱います。本講座は地図を配る役割です。",
  },
  {
    title: "業種別の深掘りはしません",
    body: "建築／製造／卸売など業種別の事例は、各Lv講座および AI駆動経営伴走支援 のヒアリングで扱います。",
  },
  {
    title: "個別相談の代替にはなりません",
    body: "本講座を読んで自社の戦略が固まらない場合は、無料個別相談（30分）をご活用ください。",
  },
];

const faq = [
  {
    q: "本当に無料ですか？",
    a: "はい、note の無料記事として公開しています。メールアドレス登録も不要で、note アカウントなしでも閲覧可能です（一部機能は note アカウントが必要）。",
  },
  {
    q: "Lv1講座（¥3,000）と何が違うんですか？",
    a: "本講座は<strong>全Lv共通の地図</strong>を65分で配ります。Lv1講座は地図のなかの「Lv1区画」だけを3時間かけて深掘りします。まず本講座→Lv1講座（必要なら）の順で読むのが王道です。",
  },
  {
    q: "更新はありますか？",
    a: "ロードマップは半年〜1年ごとに更新を予定しています。メールアドレス登録（任意）すると更新通知をお送りします。",
  },
];
---

<Layout
  title="ロードマップ講座（無料）— ツミキAI"
  description="中小企業AIの全体像を65分で。4段階ロードマップ＋3カテゴリ商品マップ。note無料記事。"
>
  <CourseLandingPage
    kicker="A. 経営者が先に学ぶ — ロードマップ講座"
    title={`中小企業AIの<span class="accent">"全体地図"</span>を、65分で。`}
    lead={`4段階ロードマップ（Lv1→Lv4）と、ツミキAIの3カテゴリ商品マップ。<strong>無料の note 記事</strong>として公開しています。読み終わったとき、自社の現在地と次の一手が言葉になります。`}
    price="無料"
    priceNote="note 無料記事"
    releasePhase="Phase 2 リリース"
    audience={audience}
    chapterParts={chapterParts}
    graduationLabel="読後の到達地点：「自分の現在地で何をすべきかの見取り図」が手に入った状態"
    graduationItems={[
      "自社のLv（1〜4）を仮説で言える",
      "Lv1→Lv2、Lv2→Lv3、Lv3→Lv4 の壁を理解した",
      "DX領域❶❷とAI領域❸❹の違いがわかる",
      "ツミキAIの3カテゴリ（A/B/C）の使い分けを判断できる",
    ]}
    cantDo={cantDo}
    faq={faq}
    ctaPrimary={{ label: "DX診断で自分のLvを特定する（無料）", href: "/diagnose/" }}
    ctaSecondary={{ label: "新記事の通知を受け取る（メアド登録）", href: "/contact/" }}
    ctaTertiary={{ label: "無料個別相談", href: "/contact/" }}
    variant="normal"
  />
</Layout>
