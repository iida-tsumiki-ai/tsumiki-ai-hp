---
import Layout from "../../../layouts/Layout.astro";
import CourseLandingPage from "../../../components/CourseLandingPage.astro";
import { noteUrls } from "../../../data/noteUrls";

const audience = [
  { text: "「うちはAI／DXで何ができるんだろう」と全体像を掴めずにいる経営者" },
  { text: "どこから始めればいいかわからず、最初の一歩を踏み出せない方" },
  { text: "DX診断を受けて、まず現在地と4段階の地図を持ちたい方" },
  { text: "ツミキAIの講座シリーズを買う前に、無料で性格を確かめたい方" },
];

const chapterParts = [
  {
    partLabel: "Part 1",
    partTitle: "導入と全体マップ",
    partDuration: "10分",
    chapters: [
      { no: "導入", title: "速さで戦わない宣言", duration: "0-3分", body: "「DXで遅れた会社こそ、AI駆動経営で先に着く」逆説的ポジションと、ツミキAIのスタンスを共有。" },
      { no: 1, title: "4ステージの地図", duration: "3-10分", body: "❶土台を組む／❷活用を広げる／❸戦略を描く／❹AIネイティブになる の全体像。DX領域❶❷とAI領域❸❹の境界。" },
    ],
  },
  {
    partLabel: "Part 2",
    partTitle: "経営インパクトと現在地特定",
    partDuration: "14分",
    chapters: [
      { no: 2, title: "経営インパクトの差＋半年で自走できる時間軸", duration: "10-17分", body: "Lv別の経営インパクト／自走モデルとは何か／半年で到達する時間軸の組み立て方。" },
      { no: 3, title: "自社のLvを特定する：ミニ診断（5問）", duration: "17-24分", body: "5問のミニ診断で仮のLv判定。精緻化したい方は HPの無料DX診断（10問）へ。" },
    ],
  },
  {
    partLabel: "Part 3",
    partTitle: "次の一歩と締め",
    partDuration: "6分",
    chapters: [
      { no: 4, title: "次の一歩：Lv別推奨講座＋4地雷予防接種＋ツール病の警告", duration: "24-28分", body: "Lv別に何を読むか／Lv1向け4地雷（60ライセンス／PoC死／現場拒否／ROI不明）の予防／ツール先行導入の落とし穴。" },
      { no: "締め", title: "自走モデルの約束", duration: "28-30分", body: "卒業前提で伴走する宣言。次の一歩へのCTA。" },
    ],
  },
];

const cantDo = [
  {
    title: "具体的なツール選定の正解は示しません",
    body: "「うちはGWS／MS365どちら？」のような個別判断は、Lv1講座（¥3,000）以降で扱います。本講座は地図を配る役割です。",
  },
  {
    title: "業種別の深掘りはしません",
    body: "建築／製造／卸売など業種別の事例は、各Lv講座および AI駆動経営伴走支援 のヒアリングで扱います。",
  },
  {
    title: "個別相談の代替にはなりません",
    body: "本講座を読んで自社の戦略が固まらない場合は、無料個別相談（30分）をご活用ください。",
  },
];

const faq = [
  {
    q: "本当に無料ですか？",
    a: "はい、note の無料記事として公開しています。メールアドレス登録も不要で、note アカウントなしでも閲覧可能です（一部機能は note アカウントが必要）。",
  },
  {
    q: "Lv1講座（¥3,000）と何が違うんですか？",
    a: "本講座は<strong>全Lv共通の地図</strong>を読了30分で配ります。Lv1講座は地図のなかの「Lv1区画」を読了30分で深掘りし、Lv2到達チェックリスト7項目まで持って帰っていただきます。まず本講座→Lv1講座（必要なら）の順で読むのが王道です。",
  },
  {
    q: "更新はありますか？",
    a: "ロードマップは半年〜1年ごとに更新を予定しています。メールアドレス登録（任意）すると更新通知をお送りします。",
  },
];
---

<Layout
  title="ロードマップ講座（無料）— ツミキAI"
  description="中小企業AIの全体像を読了30分で。4段階ロードマップ＋3カテゴリ商品マップ。note無料記事。"
>
  <CourseLandingPage
    kicker="A. 経営者が先に学ぶ — ロードマップ講座"
    title={`中小企業AIの<span class="accent">"全体地図"</span>を、読了30分で。`}
    lead={`4段階ロードマップ（Lv1→Lv4）と、ツミキAIの3カテゴリ商品マップ。<strong>無料の note 記事</strong>として公開しています。読み終わったとき、自社の現在地と次の一手が言葉になります。`}
    price="無料"
    priceNote="note 無料記事 / 読了30分"
    releasePhase="Phase 2 リリース"
    audience={audience}
    chapterParts={chapterParts}
    graduationLabel="読後の到達地点：「自分の現在地で何をすべきかの見取り図」が手に入った状態"
    graduationItems={[
      "自社のLv（1〜4）を仮説で言える",
      "Lv1→Lv2、Lv2→Lv3、Lv3→Lv4 の壁を理解した",
      "DX領域❶❷とAI領域❸❹の違いがわかる",
      "ツミキAIの3カテゴリ（A/B/C）の使い分けを判断できる",
    ]}
    cantDo={cantDo}
    faq={faq}
    ctaPrimary={{ label: "ロードマップ講座を読む（note 無料）", href: noteUrls.roadmap }}
    ctaSecondary={{ label: "DX診断で自分のLvを特定する（無料）", href: "/diagnose/" }}
    ctaTertiary={{ label: "無料個別相談", href: "/contact/" }}
    variant="normal"
  />
</Layout>
