---
/**
 * ApproachCategories — ホーム §3「3つの関わり方で、組織にAIを根付かせる。」
 * 設計書: 11_HPリニューアル_設計書.md §1 §3
 *
 * 3カテゴリ（A.経営者が先に学ぶ / B.組織に入れる / C.一緒に実行する）の入口カード。
 * 旧 ProductMatrix.astro から分離（§3 が長すぎる問題への対応 / 2026-05-04）。
 */

import { categoryLabels, type Category } from "../data/products";

const categories: Category[] = ["learn", "deploy", "execute"];

const categoryIcons: Record<Category, string> = {
  learn: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
  deploy: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  execute: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m11 17 2 2a1 1 0 1 0 3-3"/><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/><path d="m21 3 1 11h-2"/><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"/><path d="M3 4h8"/></svg>`,
};

const categoryMeta: Record<Category, { useFor: string; format: string }> = {
  learn:   { useFor: "経営者本人",        format: "講座 / メンバーシップ" },
  deploy:  { useFor: "担当者チーム",      format: "研修（チーム集合）" },
  execute: { useFor: "経営者+現場×ツミキAI", format: "伴走（社外CTO）" },
};
---

<div class="approach-block">
  <header class="approach-head">
    <p class="kicker">あなたの会社のAI活用の始め方</p>
    <h2 class="approach-title">3つの関わり方で、組織にAIを根付かせる。</h2>
    <p class="approach-lead">
      経営者本人が先に学び、担当者チームに型を入れ、現場と一緒に実行する。
      <strong>3つを組み合わせる</strong>ことで、AI活用が一過性で終わらない仕組みを作ります。
    </p>
  </header>

  <div class="cat-cards" role="list">
    {
      categories.map((cat, i) => (
        <article class={`cat-card cat-card--${cat}`} role="listitem">
          <header class="cat-card-head">
            <span class="cat-card-tag">CATEGORY {String.fromCharCode(65 + i)}</span>
            <span class="cat-card-icon" set:html={categoryIcons[cat]} />
          </header>
          <h3 class="cat-card-title">{categoryLabels[cat].label}</h3>
          <p class="cat-card-effect">{categoryLabels[cat].effect}</p>

          <dl class="cat-card-meta">
            <div class="meta-row">
              <dt>使い手</dt>
              <dd>{categoryMeta[cat].useFor}</dd>
            </div>
            <div class="meta-row">
              <dt>形態</dt>
              <dd>{categoryMeta[cat].format}</dd>
            </div>
            <div class="meta-row">
              <dt>価格帯</dt>
              <dd class="meta-price">{categoryLabels[cat].priceRange}</dd>
            </div>
            <div class="meta-row">
              <dt>効果</dt>
              <dd>{categoryLabels[cat].tagline}</dd>
            </div>
          </dl>

          <a class="cat-card-cta" href={categoryLabels[cat].hubHref}>
            {categoryLabels[cat].hubLabel} →
          </a>
        </article>
      ))
    }
  </div>
</div>

<style>
  .approach-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .approach-head {
    max-width: 720px;
  }
  .kicker {
    font-family: var(--font-en);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 var(--space-3) 0;
  }
  .approach-title {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-4) 0;
    letter-spacing: var(--tracking-heading);
  }
  .approach-lead {
    font-size: var(--text-body-lg);
    line-height: var(--leading-body-lg);
    color: var(--color-text-body);
    margin: 0;
  }
  .approach-lead strong {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }

  /* 3カテゴリカード */
  .cat-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }
  .cat-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    transition:
      box-shadow var(--duration-hover) var(--ease-out-quint),
      transform var(--duration-hover) var(--ease-out-quint);
  }
  .cat-card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .cat-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .cat-card-tag {
    display: inline-block;
    padding: 4px 12px;
    font-family: var(--font-en);
    font-size: 11px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
  }
  .cat-card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--color-primary);
  }
  .cat-card-icon :global(svg) {
    width: 22px;
    height: 22px;
  }

  .cat-card-title {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    margin: 0;
  }
  .cat-card-effect {
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-text-body);
    margin: 0 0 var(--space-2);
  }

  .cat-card-meta {
    margin: 0;
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .meta-row {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--space-3);
    align-items: baseline;
    font-size: var(--text-body-sm);
  }
  .meta-row dt {
    color: var(--color-text-muted);
    font-weight: var(--weight-regular);
  }
  .meta-row dd {
    margin: 0;
    color: var(--color-text);
    font-weight: var(--weight-semibold);
    text-align: right;
  }
  .meta-row .meta-price {
    font-family: var(--font-en), var(--font-jp);
    color: #B84A1E;
    font-feature-settings: "tnum";
    white-space: nowrap;
  }

  .cat-card-cta {
    align-self: flex-start;
    margin-top: auto;
    font-family: var(--font-jp);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-hover) var(--ease-out-quint);
  }
  .cat-card-cta:hover {
    border-bottom-color: var(--color-primary);
  }

  /* レスポンシブ */
  @media (max-width: 899px) {
    .approach-title {
      font-size: var(--text-h2);
    }
    .cat-cards {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
