---
/**
 * /about/ — 会社情報（G1）
 * 設計書: 11 §14
 * 役割: ミッション／代表プロフィール（エピソード型）／強み／会社概要／CTA
 * 素材: ../../01_マーケティング/エピソード集_20260424_代表タケ.md（4エピソード）
 */
import Layout from "../../layouts/Layout.astro";

const episodes = [
  {
    no: "01",
    label: "独立した動機",
    title: "中小企業が後回しにされがちな社会",
    body: "日本企業の99%以上が中小企業です。中小企業で働く人は、労働人口の7割を占めています。それなのに世の中の仕組みは大企業向けにできていて、中小企業の現場は後回しにされがちです。弥生で中小企業のリアルを6年見続けた中で、この違和感がずっと頭にありました。独立したのは、この状況を少しでも変えたかったからです。",
  },
  {
    no: "02",
    label: "業界で見たこと",
    title: "法改正と現場のギャップ",
    body: "弥生ではインボイス制度・電帳法の製品対応を指揮しました。どちらも「難しい法改正だな」と身構えたのを覚えています。制度は始まっても、中小企業の現場はまだ追いついていない会社がたくさんあります。制度を作る側と現場の間に、誰かが立つ必要があると感じています。",
  },
  {
    no: "03",
    label: "千葉で出会った景色",
    title: "変える必要を感じない、本当の理由",
    body: "千葉に戻って地域の経営者と話すと、クラウド化していない会社がまだまだ多いです。特に小規模になるほどその傾向は強くなります。でもそれは怠慢ではありません。クラウドはサブスクリプションで費用を払い続けることになるため、そのコスト感と享受できるメリットを天秤にかけたとき、メリットを感じづらい——というのが本当のところです。だから押し売りはしません。「今までのやり方でも回っているけれど、実はもっと楽に、もっと遠くへ行ける方法がある」——そう気づいてもらうところから、伴走します。",
  },
  {
    no: "04",
    label: "自分の失敗体験",
    title: "業務を流れに繋ぐ難しさ",
    body: "独立前にEC事業をやっていました。仕入れ・梱包・発送は手作業の連続でした。本当に難しかったのは、個別作業を効率化することではなく、それらを一連の流れに繋げることでした。「利益商品を探す → 自動で仕入れる → 仕入れたら自動で商品を掲載する」のように、個別業務を一つの流れに繋ぐ——これが想像より遥かに大変でした。だから「AIで効率化」の話をする時に、現場の感覚を持って話せます。",
  },
];

const careers = [
  { period: "2009-2015", title: "自治体システム開発（6年）", body: "公共インフラに近い領域で、要件定義から運用まで一気通貫で経験。「使われ続けるシステム」の感覚を学んだ時期。" },
  { period: "2015-2021", title: "弥生株式会社（6年）", body: "中小企業向けクラウドサービスの事業企画・PM。複数プロダクトの統括を経て、240万社規模のバックオフィスのリアルを見続ける。インボイス制度・電帳法の製品対応を指揮。" },
  { period: "2021-2024", title: "EC事業経営", body: "独立してEC事業を経営。仕入れ／梱包／発送を全て自分で回す中で、現場の手作業の壁と「業務を流れに繋ぐ難しさ」を体感。" },
  { period: "2024-現在", title: "ツミキAI 創業（千葉県印西市）", body: "「中小企業のAI内製化伴走ブランド」として、生成AI×Google Workspace の組み合わせで中小企業のDX→AI駆動経営を支援。" },
];

const strengths = [
  {
    title: "中小企業のバックオフィス深理解",
    body: "弥生での6年で、240万社規模の中小企業のバックオフィスのリアルを見続けました。請求／会計／人事／給与のどこに本当のボトルネックがあるかを、机上ではなく現場の温度で語れます。",
  },
  {
    title: "BtoB業種特化",
    body: "建築業／製造業／卸売業のBtoB企業の業務フローを具体的に理解しています。業界共通の構造と、業種ごとの特殊事情の両方を踏まえた提案ができます。",
  },
  {
    title: "AI＋IT総合サポート",
    body: "Excel／メール／Slack／Notion／Google Workspace／Microsoft 365 など、業務で使うツール全般を横断的にサポートできます。「AIだけ」「ツールだけ」ではない、IT顧問機能としての伴走です。",
  },
  {
    title: "千葉地域密着",
    body: "印西市拠点。千葉県内の経営者・商工会議所との接点があり、訪問対応・顔の見える関係構築が可能です。同じ地域にいる安心感を強みに。",
  },
];
---

<Layout
  title="会社情報 — ツミキAI"
  description="ツミキAI 代表 飯田武之（タケ）／千葉県印西市拠点／中小企業のAI内製化伴走ブランド。経歴・代表エピソード・会社概要。"
>
  <!-- ========== §HERO ========== -->
  <section class="page-section page-section--warm">
    <div class="page-container hero">
      <p class="kicker">About — ツミキAIについて</p>
      <h1 class="hero-title">
        小さく始めて、<br />
        <span class="hero-accent">一つずつ積み上げる。</span>
      </h1>
      <p class="hero-lead">
        中小企業のための <strong>AI内製化伴走ブランド</strong>。
        積み木を一つずつ積むように、無理なく進める。
        ツミキAIは、中小企業がAIを「当たり前のツール」にするための伴走者です。
      </p>
    </div>
  </section>

  <!-- ========== §ミッション ========== -->
  <section class="page-section">
    <div class="page-container">
      <header class="sec-head">
        <p class="sec-kicker">ミッション</p>
        <h2 class="sec-title">240万社規模の品質と、AI活用のスピードで、中小企業の現場を変える。</h2>
      </header>
      <div class="mission-block">
        <p class="mission-text">
          中小企業は、日本の企業数の <strong>99%以上</strong>を占め、労働人口の <strong>約7割</strong>がそこで働いています。
          それなのに、世の中の仕組みは大企業向けにできていて、中小企業の現場は後回しにされがちです。
        </p>
        <p class="mission-text">
          ツミキAIは、弥生で<strong>240万社規模のインフラを支えた品質</strong>と、
          AI活用による<strong>スピード</strong>を武器に、中小企業の現場を変えたい。
          顧客がAIを内製化できたら、ツミキAIは不要になる。
          <strong>ベンダーロックしない自走モデル</strong>が、ツミキAIの責任の取り方です。
        </p>
      </div>
    </div>
  </section>

  <!-- ========== §代表プロフィール ========== -->
  <section class="page-section page-section--subtle">
    <div class="page-container">
      <header class="sec-head">
        <p class="sec-kicker">代表プロフィール</p>
        <h2 class="sec-title">飯田武之（タケ）</h2>
        <p class="sec-lead">
          自治体システム開発6年 → 弥生株式会社で中小企業向けサービス開発6年 → EC事業経営を経て、2024年にツミキAIを創業。
          数字や役職の前に、実際に見てきた<strong>現場の景色</strong>でお話しします。
        </p>
      </header>

      <ul class="episode-list">
        {episodes.map((ep) => (
          <li class="episode-card">
            <div class="episode-meta">
              <span class="episode-no">{ep.no}</span>
              <span class="episode-label">{ep.label}</span>
            </div>
            <h3 class="episode-title">{ep.title}</h3>
            <p class="episode-body">{ep.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ========== §経歴 ========== -->
  <section class="page-section">
    <div class="page-container">
      <header class="sec-head">
        <p class="sec-kicker">経歴</p>
        <h2 class="sec-title">15年の歩み。</h2>
      </header>
      <ol class="career-list">
        {careers.map((c) => (
          <li class="career-item">
            <div class="career-period">{c.period}</div>
            <div class="career-body">
              <h3 class="career-title">{c.title}</h3>
              <p class="career-text">{c.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ========== §強み ========== -->
  <section class="page-section page-section--subtle">
    <div class="page-container">
      <header class="sec-head">
        <p class="sec-kicker">ツミキAIの強み</p>
        <h2 class="sec-title">大手コンサルとは違う、4つの強み。</h2>
      </header>
      <ul class="strength-grid">
        {strengths.map((s, idx) => (
          <li class="strength-card">
            <div class="strength-num">{String(idx + 1).padStart(2, "0")}</div>
            <h3 class="strength-title">{s.title}</h3>
            <p class="strength-body">{s.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ========== §会社概要 ========== -->
  <section class="page-section">
    <div class="page-container">
      <header class="sec-head">
        <p class="sec-kicker">会社概要</p>
        <h2 class="sec-title">事業者情報。</h2>
      </header>
      <dl class="info-list">
        <div class="info-row">
          <dt>屋号</dt>
          <dd>ツミキAI</dd>
        </div>
        <div class="info-row">
          <dt>代表者</dt>
          <dd>飯田武之（いいだ・たけゆき）</dd>
        </div>
        <div class="info-row">
          <dt>所在地</dt>
          <dd>千葉県印西市</dd>
        </div>
        <div class="info-row">
          <dt>創業</dt>
          <dd>2024年</dd>
        </div>
        <div class="info-row">
          <dt>事業内容</dt>
          <dd>
            中小企業向けDX支援／AI活用伴走支援／講座・研修プログラム提供／生成AI関連の業務改善コンサルティング
          </dd>
        </div>
        <div class="info-row">
          <dt>主要技術</dt>
          <dd>Google Workspace／Microsoft 365／Claude／ChatGPT／Gemini／GAS／Power Automate／Claude Code／API・MCP連携</dd>
        </div>
        <div class="info-row">
          <dt>連絡先</dt>
          <dd><a href="mailto:iida@tsumiki.ai">iida@tsumiki.ai</a></dd>
        </div>
        <div class="info-row">
          <dt>URL</dt>
          <dd><a href="https://tsumiki.ai/">https://tsumiki.ai/</a></dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ========== §最終CTA ========== -->
  <section class="page-section page-section--warm">
    <div class="page-container final-cta">
      <h2 class="final-title">話してみるところから、はじめませんか。</h2>
      <p class="final-lead">
        まずは無料の AI駆動経営診断 か、30分の無料個別相談から。千葉県内なら訪問対応も可能です。
      </p>
      <div class="final-ctas">
        <a class="btn btn-primary btn-lg" href="/contact/">無料個別相談を予約する</a>
        <a class="btn btn-secondary btn-lg" href="/diagnose/">AI駆動経営診断（10問・3分）</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-section {
    width: 100%;
    padding-top: var(--section-py-desktop);
    padding-bottom: var(--section-py-desktop);
  }
  .page-section--subtle { background: var(--color-bg-subtle); }
  .page-section--warm { background: var(--color-bg-warm); }
  @media (max-width: 768px) {
    .page-section { padding-top: var(--section-py-mobile); padding-bottom: var(--section-py-mobile); }
  }

  .page-container {
    max-width: var(--container-lg);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .sec-head { max-width: 720px; margin: 0 0 var(--space-8) 0; }
  .sec-kicker {
    font-family: var(--font-en);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 var(--space-3) 0;
  }
  .sec-title {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-4) 0;
  }
  .sec-lead {
    font-size: var(--text-body-lg);
    line-height: var(--leading-body-lg);
    color: var(--color-text-body);
    margin: 0;
  }
  .sec-lead strong {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    font-family: var(--font-jp);
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    transition: background-color var(--duration-hover) var(--ease-out-quint), transform var(--duration-hover) var(--ease-out-quint);
    white-space: nowrap;
  }
  .btn-lg { padding: var(--space-4) var(--space-8); font-size: var(--text-body-lg); }
  .btn-primary {
    background: var(--color-accent);
    color: #fff;
    box-shadow: var(--shadow-button);
  }
  .btn-primary:hover { background: #E55A2B; color: #fff; transform: translateY(-1px); }
  .btn-secondary {
    background: transparent;
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
  }
  .btn-secondary:hover { background: var(--color-primary); color: #fff; }

  /* HERO */
  .hero { text-align: center; max-width: 880px; }
  .kicker {
    font-family: var(--font-en);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 var(--space-4) 0;
  }
  .hero-title {
    font-family: var(--font-jp-serif);
    font-size: var(--text-display);
    line-height: var(--leading-display);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-6) 0;
  }
  .hero-accent { color: var(--color-accent); }
  .hero-lead {
    font-size: var(--text-body-lg);
    line-height: var(--leading-body-lg);
    color: var(--color-text-body);
    max-width: 720px;
    margin: 0 auto;
  }
  .hero-lead strong { color: var(--color-text); font-weight: var(--weight-semibold); }

  /* mission */
  .mission-block {
    max-width: 760px;
    padding: var(--space-8);
    background: var(--color-bg-warm);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-md);
  }
  .mission-text {
    font-size: var(--text-body-lg);
    line-height: var(--leading-body-lg);
    color: var(--color-text-body);
    margin: 0 0 var(--space-4) 0;
  }
  .mission-text:last-child { margin-bottom: 0; }
  .mission-text strong { color: var(--color-text); font-weight: var(--weight-semibold); }

  /* episodes */
  .episode-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }
  .episode-card {
    padding: var(--space-6);
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }
  .episode-meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }
  .episode-no {
    font-family: var(--font-en);
    font-size: var(--text-h2);
    font-weight: var(--weight-bold);
    color: var(--color-accent);
    line-height: 1;
  }
  .episode-label {
    font-family: var(--font-jp);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }
  .episode-title {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h4);
    line-height: var(--leading-h4);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-3) 0;
  }
  .episode-body {
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-text-body);
    margin: 0;
  }

  /* career */
  .career-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    position: relative;
  }
  .career-list::before {
    content: "";
    position: absolute;
    left: 75px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-border);
  }
  .career-item {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: var(--space-6);
    align-items: flex-start;
    position: relative;
    padding-left: 0;
  }
  .career-item::before {
    content: "";
    position: absolute;
    left: 71px;
    top: 12px;
    width: 10px;
    height: 10px;
    background: var(--color-accent);
    border-radius: var(--radius-full);
    z-index: 1;
  }
  .career-period {
    font-family: var(--font-en);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    color: var(--color-accent);
    text-align: right;
    padding-right: var(--space-6);
  }
  .career-title {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h4);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-2) 0;
  }
  .career-text {
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-text-body);
    margin: 0;
  }

  /* strength */
  .strength-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }
  .strength-card {
    padding: var(--space-6);
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .strength-num {
    font-family: var(--font-en);
    font-size: var(--text-h2);
    font-weight: var(--weight-bold);
    color: var(--color-accent);
    line-height: 1;
    margin-bottom: var(--space-3);
  }
  .strength-title {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-3) 0;
  }
  .strength-body {
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-text-body);
    margin: 0;
  }

  /* info */
  .info-list {
    margin: 0;
    padding: 0;
    background: var(--color-bg-warm);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .info-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--space-6);
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }
  .info-row:last-child { border-bottom: none; }
  .info-row dt {
    font-family: var(--font-jp);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
    margin: 0;
  }
  .info-row dd {
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-text);
    margin: 0;
  }
  .info-row dd a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: var(--weight-semibold);
  }
  .info-row dd a:hover { text-decoration: underline; }

  /* final */
  .final-cta { text-align: center; max-width: 720px; }
  .final-title {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-4) 0;
  }
  .final-lead {
    font-size: var(--text-body-lg);
    line-height: var(--leading-body-lg);
    color: var(--color-text-body);
