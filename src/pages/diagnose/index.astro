    Lv4: { category: 'A', catLabel: 'A. 経営者が先に学ぶ', name: 'Lv4講座（事例集）＋ AI駆動経営伴走支援', stageTag: 'STAGE ❹ AI駆動経営へ', price: '月3,000 + 月10〜30万', priceUnit: '（Lv4講座はメンバーシップ・事例集／伴走支援は C カテゴリ主力）', desc: 'Lv4はvisionと事例集の領域。Lv4講座は AI駆動経営伴走支援を自走した会社のインタビュー集として設計されており、「自社が次に何を目指せば良いか」の参照点になります。本格的な内製化にはAI駆動経営伴走支援を。', primaryCta: '★ AI駆動経営伴走支援の無料相談', secondaryCta: 'Lv4講座（事例集）の詳細', primaryHref: '/support/', secondaryHref: '/courses/lv4/' },
    TR1: { category: 'B', catLabel: 'B. 組織に入れる', name: '❶入門研修（担当者向け）', stageTag: 'STAGE ❶ 土台を組む', price: '10', priceUnit: '万円 / 半日', desc: '担当者チームが集まって受講する半日研修。Claude・ChatGPT基礎と個人プロンプト集を一気に作ります。経営者が「組織に共通言語を入れたい」タイミングで。', primaryCta: '入門研修の詳細', secondaryCta: '研修プログラム一覧', primaryHref: '/training/', secondaryHref: '/training/' },
    TR2: { category: 'B', catLabel: 'B. 組織に入れる', name: '❷実践研修（担当者向け）', stageTag: 'STAGE ❷ 活用を広げる', price: '25', priceUnit: '万円 / 日', desc: 'チーム向け1日研修。共通プロンプト＋GAS入門で、現場が自走できる状態を作ります。Lv2で組織展開を本格化するタイミングで。', primaryCta: '実践研修の詳細', secondaryCta: '研修プログラム一覧', primaryHref: '/training/', secondaryHref: '/training/' },
    B: { category: 'C', catLabel: 'C. 一緒に実行する', name: '★ AI駆動経営伴走支援（主力）', stageTag: 'Lv1-Lv4 共通 / 現在地に応じた進め方', price: '月 10〜30', priceUnit: '万円 / 半年で自走', desc: '社外CTOとして戦略→実装→運用→自走まで一気通貫で伴走します。Lv1なら導入設計・初期学習、Lv2なら業務棚卸し・全社展開、Lv3なら基幹系再選定・組織役割設計、Lv4なら自律運用と内製化──現在地に応じた進め方で、最終的にAI駆動経営の会社まで持っていきます。', primaryCta: '無料個別相談を予約する', secondaryCta: 'AI駆動経営伴走支援の詳細', primaryHref: 'https://docs.google.com/forms/d/e/1FAIpQLSd1yUsmc94ZTZ_MqR3tLVXDWlCaOmLIYxt3o2BqSb-AVF83gg/viewform', secondaryHref: '/support/' }
  };

  const STAGES = [
    { num: '❶', label: 'STAGE 1', name: '土台を組む', zone: 'dx', zoneLabel: 'DX領域' },
    { num: '❷', label: 'STAGE 2', name: '活用を広げる', zone: 'dx', zoneLabel: 'DX領域' },
    { num: '❸', label: 'STAGE 3', name: '戦略を描く', zone: 'ai', zoneLabel: 'AI領域' },
    { num: '❹', label: 'STAGE 4', name: 'AI駆動経営へ', zone: 'ai', zoneLabel: 'AI領域' }
  ];

  const answers = {};

  function showScreen(name) {
    document.querySelectorAll('.diagnose-page .screen').forEach(el => el.classList.remove('is-active'));
    document.getElementById('screen-' + name).classList.add('is-active');
    window.scrollTo({ top: 0, behavior: 'instant' });
    if (name === 'quiz') renderQuiz();
  }

  function renderQuiz() {
    const container = document.getElementById('questions-container');
    const catOrder = ['comm', 'info', 'auto', 'it'];
    container.innerHTML = '';
    catOrder.forEach(catKey => {
      const cat = CATEGORIES[catKey];
      const section = document.createElement('div');
      section.className = 'cat-section';
      section.innerHTML = `<div class="cat-label">${cat.label}</div>`;
      cat.ids.forEach(qId => {
        const q = QUESTIONS.find(x => x.id === qId);
        const qEl = document.createElement('div');
        qEl.className = 'question';
        qEl.id = `q-${q.id}`;
        qEl.innerHTML = `
          <div class="question-head">
            <span class="question-num">${q.id}</span>
            <div class="question-text">${q.text}</div>
          </div>
          <div class="answers">
            <button class="answer-btn" data-answer="yes" onclick="selectAnswer(${q.id}, 'yes')">はい</button>
            <button class="answer-btn" data-answer="no" onclick="selectAnswer(${q.id}, 'no')">いいえ</button>
          </div>
        `;
        section.appendChild(qEl);
      });
      container.appendChild(section);
    });
    updateProgress();
  }

  function selectAnswer(qId, value) {
    answers[qId] = value;
    const qEl = document.getElementById(`q-${qId}`);
    qEl.classList.add('is-answered');
    qEl.querySelectorAll('.answer-btn').forEach(btn => {
      btn.classList.toggle('is-selected', btn.dataset.answer === value);
    });
    updateProgress();
  }

  function updateProgress() {
    const answered = Object.keys(answers).length;
    document.getElementById('progress-answered').textContent = answered;
    document.getElementById('progress-fill').style.width = (answered / 10 * 100) + '%';
    const submitBtn = document.getElementById('btn-submit');
    const submitNote = document.getElementById('submit-note');
    if (answered === 10) {
      submitBtn.disabled = false;
      submitNote.textContent = 'すべての質問に回答しました。結果を確認しましょう。';
    } else {
      submitBtn.disabled = true;
      submitNote.textContent = `あと ${10 - answered} 問で結果を表示できます`;
    }
  }

  function calcLevel(yesCount) {
    if (yesCount <= 2) return 1;
    if (yesCount <= 4) return 2;
    if (yesCount <= 7) return 3;
    return 4;
  }

  function findWeakestCategory() {
    let minRate = 2;
    let weakest = null;
    Object.entries(CATEGORIES).forEach(([key, cat]) => {
      const yesCount = cat.ids.filter(id => answers[id] === 'yes').length;
      const rate = yesCount / cat.ids.length;
      if (rate < minRate) { minRate = rate; weakest = key; }
    });
    return weakest;
  }

  function submitQuiz() {
    const yesCount = Object.values(answers).filter(v => v === 'yes').length;
    const level = calcLevel(yesCount);
    const levelData = LEVELS[level];
    const weakest = findWeakestCategory();

    document.getElementById('result-level-badge').textContent = `DX ${levelData.name} / YES ${yesCount} / 10`;
    document.getElementById('result-headline').textContent = levelData.headline;
    document.getElementById('result-state').innerHTML = levelData.state;

    const nodesEl = document.getElementById('stage-nodes');
    nodesEl.innerHTML = '';
    STAGES.forEach((stage, i) => {
      const isCurrent = i === levelData.mainStageIndex;
      const isPast = i < levelData.mainStageIndex;
      const node = document.createElement('div');
      node.className = 'stage-node zone-' + stage.zone + (isCurrent ? ' is-current' : '') + (isPast ? ' is-past' : '');
      node.innerHTML = `
        ${isCurrent ? '<div class="stage-marker">あなたはここ</div>' : ''}
        <div class="stage-zone-tag">${stage.zoneLabel}</div>
        <div class="stage-dot">${stage.num}</div>
        <div class="stage-node-label">${stage.label}</div>
        <div class="stage-node-name">${stage.name}</div>
      `;
      nodesEl.appendChild(node);
    });

    const weakCopy = WEAKEST_COPY[weakest];
    document.getElementById('weakest-title').textContent = weakCopy.title;
    document.getElementById('weakest-desc').textContent = weakCopy.desc;

    const listEl = document.getElementById('action-list');
    listEl.innerHTML = '';
    levelData.actions.forEach(text => {
      const li = document.createElement('li');
      li.textContent = text;
      listEl.appendChild(li);
    });

    const prescription = levelData.prescription;
    const mainProduct = PRODUCTS[prescription.learn];
    document.getElementById('prescription-main').innerHTML = `
      <div class="prescription-badge">${mainProduct.catLabel} — 主推奨</div>
      <div class="stage-tag">${mainProduct.stageTag}</div>
      <h3>${mainProduct.name}</h3>
      <div class="price">${mainProduct.price}<span class="unit">${mainProduct.priceUnit}</span></div>
      <p>${mainProduct.desc}</p>
      <div class="prescription-cta">
        <a class="diag-btn diag-btn-accent" href="${mainProduct.primaryHref}" ${mainProduct.primaryHref.startsWith('http') ? 'target="_blank" rel="noopener noreferrer"' : ''}>${mainProduct.primaryCta}</a>
        <a class="diag-btn diag-btn-secondary" href="${mainProduct.secondaryHref}" ${mainProduct.secondaryHref.startsWith('http') ? 'target="_blank" rel="noopener noreferrer"' : ''}>${mainProduct.secondaryCta}</a>
      </div>
    `;

    let subHtml = '';
    if (prescription.deploy) {
      const p = PRODUCTS[prescription.deploy];
      subHtml += `
        <div class="prescription-sub-card">
          <div class="stage-tag">${p.catLabel}</div>
          <h4>${p.name}</h4>
          <p>${p.desc}</p>
          <p style="font-size:12px;color:var(--color-text-muted, #6C757D);margin-top:8px;">
            <strong>${p.price}${p.priceUnit}</strong>
          </p>
        </div>
      `;
    }
    if (prescription.execute) {
      const p = PRODUCTS[prescription.execute];
      subHtml += `
        <div class="prescription-sub-card">
          <div class="stage-tag">${p.catLabel}</div>
          <h4>${p.name}</h4>
          <p>${p.desc}</p>
          <p style="font-size:12px;color:var(--color-text-muted, #6C757D);margin-top:8px;">
            <strong>${p.price}${p.priceUnit}</strong>
          </p>
        </div>
      `;
    }
    if (!prescription.deploy) {
      subHtml += `
        <div class="prescription-sub-card" style="opacity:0.7;">
          <div class="stage-tag">B. 組織に入れる</div>
          <h4>担当者向け研修は❶❷まで</h4>
          <p>Lv3-4は経営者自身が学ぶ（A）／一緒に実行する（C）フェーズです。担当者向け研修は Lv1-2 の段階でご利用ください。</p>
        </div>
      `;
    }
    document.getElementById('prescription-sub').innerHTML = subHtml;

    showScreen('result');
  }

  function retake() {
    Object.keys(answers).forEach(k => delete answers[k]);
    showScreen('intro');
  }
</script>
