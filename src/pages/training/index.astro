          <ul class="program-items">
            {stage2Day2MorningItems.map((item) => <li>{item}</li>)}
          </ul>

          <h3 class="program-content-label">Day 2 午後（経営者＋責任者限定・75分）：経営判断＋Lv3への合図</h3>
          <ul class="program-items">
            {stage2Day2AfternoonItems.map((item) => <li>{item}</li>)}
          </ul>

