const lvFlows = [
  {
    lv: "Lv1",
    stage: "❶ 土台を組む",
    zone: "DX領域",
    title: "導入設計・初期学習",
    body: "クラウド基盤（GWS／MS365）の導入と全社展開、Gemini／Copilot を日常業務に混ぜる初期設計から始めます。「自分たちだけだと立ち上げが止まる」会社にフィットします。",
  },
  {
    lv: "Lv2",
    stage: "❷ 活用を広げる",
    zone: "DX領域",
    title: "業務棚卸し・全社展開",
    body: "現場が自分で試せる環境を全社に広げ、業務を「やめる／AIに任せる／人がやる」に仕分けます。属人化を解き、データ・情報の置き場を共通化していきます。",
  },
  {
    lv: "Lv3",
    stage: "❸ 戦略を描く",
    zone: "AI領域",
    title: "基幹再設計・組織役割設計",
    body: "基幹系・重要サービスを API・MCP対応基準で再選定し、Claude Code／API連携で経営判断にデータを接続します。「選定・運用・教育」の組織役割設計まで踏み込みます。",
  },
  {
    lv: "Lv4",
    stage: "❹ AIネイティブになる",
    zone: "AI領域",
    title: "自律化・内製化定着",
    body: "業務をエージェントに任せる仕組みを構築し、新規業務も社内で即AI組込できる状態へ。AIと組織が共進化する運営モデルを定着させ、ツミキAIから自走していただきます。",
  },
];

const plans = [
  {
    id: "light",
    name: "ライト",
    price: "¥100,000",
    priceUnit: "/ 月",
    initial: "¥50,000",
    hours: "15時間 / 月",
    target: "小さく始めたい方におすすめ",
    features: [
      "月次定例（オンライン）",
      "Slack／メール相談",
      "ツール選定アドバイス",
      "プロンプト・自動化レシピ提供",
    ],
    isFlagship: false,
  },
  {
    id: "standard",
    name: "スタンダード",
    price: "¥200,000",
    priceUnit: "/ 月",
    initial: "¥50,000",
    hours: "30時間 / 月",
    target: "毎週活用したい方におすすめ",
    features: [
      "週次定例（オンライン or 訪問）",
      "Slack／メール常時相談",
      "業務AI組み込み実装",
      "Claude Code・GAS実装支援",
      "現場担当者ハンズオン",
    ],
    isFlagship: true,
  },
  {
    id: "premium",
    name: "プレミアム",
    price: "¥300,000",
    priceUnit: "/ 月",
    initial: "¥50,000",
    hours: "45時間 / 月",
    target: "完全伴走を希望の方におすすめ",
    features: [
      "週次定例＋随時ミーティング",
      "Slack／メール常時相談",
      "基幹系再選定・データ戦略",
      "組織役割設計・社外CTO機能",
      "経営層〜現場まで一気通貫伴走",
    ],
    isFlagship: false,
  },
];

const cantDo = [
  {
    title: "半年で劇的な成果は約束できません",
    body: "ツミキAIは「1段ずつ、着実に」がブランドコアです。短期間で売上を倍にする、というご期待には応えられません。半年で社内に内製化の型が残り、自社で次の一手を選べる状態になることをコミットします。",
  },
  {
    title: "永続的なベンダーロックはしません",
    body: "ツミキAIに依存し続ける設計にはしません。半年で自走していただくことを前提にしています。卒業後も緩やかに繋がる仕組みを今後整備予定ですが、契約継続を前提にした商品ではありません。",
  },
  {
    title: "業種・規模が合わない場合はお断りします",
    body: "BtoB（製造／建築／卸売）以外の業種、社員10名未満／500名以上の規模、緊急対応専業の体制を求める会社は、ツミキAIのフィットゾーン外です。初回ヒアリングでお互いに見極めます。",
  },
];
---

<Layout
  title="AI駆動経営伴走支援 — ツミキAI"
  description="社外CTOとして、戦略→実装→運用→自走まで一気通貫で伴走。Lv1-Lv4を1サービスでカバー。月¥10〜30万 / 半年で自走。3プラン（ライト/スタンダード/プレミアム）から選べます。"
>
  <!-- ========== §HERO ========== -->
  <Section size="l" background="warm">
    <div class="support-container hero">
      <p class="kicker">C. 一緒に実行する — AI駆動経営伴走支援</p>
      <h1 class="hero-title">
        1段ずつ、着実に。<br />
        <span class="hero-accent">AI駆動経営を、現場で。</span>
      </h1>
      <p class="hero-lead">
        社外CTOとして、戦略→実装→運用→自走まで一気通貫で伴走します。
        Lv1（導入設計）から Lv4（自律化・内製化）まで、<strong>現在地に応じた進め方</strong>で、
        最終的に自社で内製化できる「<strong>AIネイティブな会社</strong>」へ。
      </p>
      <div class="hero-kpi">
        <div class="kpi"><span class="kpi-num">月¥10〜30万</span><span class="kpi-label">3プランから選べます</span></div>
        <div class="kpi"><span class="kpi-num">半年</span><span class="kpi-label">で自走できる状態へ</span></div>
        <div class="kpi"><span class="kpi-num">Lv1-Lv4</span><span class="kpi-label">を1サービスでカバー</span></div>
      </div>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="/contact/">無料個別相談を予約する</a>
        <a class="btn btn-secondary" href="/diagnose/">DX診断 — AI駆動経営まで残り◯段 を測る</a>
      </div>
    </div>
  </Section>

  <!-- ========== §1 サービス本質3点 ========== -->
  <Section size="l" background="default">
    <div class="support-container">
      <header class="sec-head">
        <p class="sec-kicker">§1 ツミキAIが伴走する理由</p>
        <h2 class="sec-title">外注で「作る」のではなく、社内で「作れるようになる」までを伴走します。</h2>
      </header>
      <ul class="essence-grid">
        <li class="essence-card">
          <div class="essence-num">01</div>
          <h3 class="essence-title">社外CTOとして経営に伴走</h3>
          <p class="essence-body">
            業務システムベンダーではなく、経営者の右腕としてAI戦略全体に伴走します。240万社規模のインフラ開発と複数プロダクト統括の経験から、中小企業の現場感覚で意思決定をサポートします。
          </p>
        </li>
        <li class="essence-card">
          <div class="essence-num">02</div>
          <h3 class="essence-title">実務を通して作る</h3>
          <p class="essence-body">
            「読む・聞く」で終わらせません。御社の実業務（請求／在庫／顧客対応／社内ドキュメント等）に即したAIアプリやプロンプトをハンズオンで一緒に作ります。机上の研修との根本的な違いです。
          </p>
        </li>
        <li class="essence-card">
          <div class="essence-num">03</div>
          <h3 class="essence-title">半年で自走モデル</h3>
          <p class="essence-body">
            半年で「社内担当者が新規業務にも自分でAIを組み込める」状態を作ります。永続契約を前提とした設計はしていません。自走後も緩やかに繋がる仕組みを今後整備予定です。
          </p>
        </li>
      </ul>
    </div>
  </Section>

  <!-- ========== §2 4フェーズ Flow（D2/D6） ========== -->
  <Section size="l" background="subtle">
    <div class="support-container">
      <header class="sec-head">
        <p class="sec-kicker">§2 進め方の型</p>
        <h2 class="sec-title">4フェーズで「戦略 → 自走」までを設計しています。</h2>
        <p class="sec-lead">
          Strategy（戦略）→ Build（実装）→ Operate（運用）→ Independence（自走）。
          すべてのプランで、この4フェーズを半年〜1年かけて辿ります。
          <strong>最終フェーズは "自走" を設計に組み込んでいる</strong>のがツミキAIの特徴です。
        </p>
      </header>
      <ol class="phase-flow">
        {phases.map((p) => (
          <li class={`phase-card phase-card--${p.no}`}>
            <div class="phase-num">{p.no}</div>
            <div class="phase-en">{p.en}</div>
            <div class="phase-jp">{p.jp}</div>
            <div class="phase-duration">{p.duration}</div>
            <p class="phase-body">{p.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <!-- ========== §3 Lv別の進め方 ========== -->
  <Section size="l" background="default">
    <div class="support-container">
      <header class="sec-head">
        <p class="sec-kicker">§3 Lv別の進め方</p>
        <h2 class="sec-title">あなたの会社の「現在地」によって、進め方が変わります。</h2>
        <p class="sec-lead">
          AI駆動経営伴走支援は <strong>Lv1〜Lv4 を1サービス</strong>でカバーします。
          初回ヒアリングと <a href="/diagnose/">DX診断</a> で現在地を特定し、それに合った Strategy フェーズを設計します。
        </p>
      </header>
      <ul class="lv-flow">
        {lvFlows.map((l) => (
          <li class={`lv-card lv-card--${l.zone === "DX領域" ? "dx" : "ai"}`}>
            <div class="lv-head">
              <span class="lv-tag">{l.lv}</span>
              <span class="lv-zone">{l.zone}</span>
            </div>
            <div class="lv-stage">{l.stage}</div>
            <h3 class="lv-title">{l.title}</h3>
            <p class="lv-body">{l.body}</p>
          </li>
        ))}
      </ul>
      <p class="lv-note">
        ※ 現在地の特定には <a href="/diagnose/">無料DX診断（10問・3分）</a> をおすすめします。「どのLvから始めるか」「半年でどこまで進むか」を、初回ヒアリングで一緒に設計します。
      </p>
    </div>
  </Section>

  <!-- ========== §4 3プラン比較表 ========== -->
  <Section size="l" background="warm">
    <div class="support-container">
      <header class="sec-head">
        <p class="sec-kicker">§4 料金プラン</p>
        <h2 class="sec-title">3プランから、関わり方を選べます。</h2>
        <p class="sec-lead">
          稼働時間と関わり方で3段階。<strong>初期費用は ¥50,000 共通</strong>（初回ヒアリング含む）。
          最低契約 1ヶ月から。<strong>いつでも解約可能</strong>です。価格は税別です。
        </p>
      </header>
      <ul class="plan-grid">
        {plans.map((p) => (
          <li class={`plan-card ${p.isFlagship ? "plan-card--flagship" : ""}`}>
            {p.isFlagship && <span class="plan-recommended">人気</span>}
            <h3 class="plan-name">{p.name}</h3>
            <p class="plan-target">{p.target}</p>
            <div class="plan-price">
              <span class="plan-price-main">{p.price}</span>
              <span class="plan-price-unit">{p.priceUnit}</span>
            </div>
            <div class="plan-meta">
              <div class="plan-meta-row"><span>初期費用</span><strong>{p.initial}</strong></div>
              <div class="plan-meta-row"><span>稼働時間</span><strong>{p.hours}</strong></div>
            </div>
            <ul class="plan-features">
              {p.features.map((f) => <li>{f}</li>)}
            </ul>
            <a class="plan-cta" href="/contact/">このプランで相談する →</a>
          </li>
        ))}
      </ul>
      <p class="plan-note">
        ※ 初回ヒアリング時間は初期費用に含まれます（月次稼働時間には計上されません）／
        最初の1ヶ月で「進め方が合うか」を確認できます／
        プラン変更は月単位で可能です
      </p>
    </div>
  </Section>

  <!-- ========== §5 自走事例（D3 スタブ） ========== -->
  <Section size="l" background="default">
    <div class="support-container">
      <header class="sec-head">
        <p class="sec-kicker">§5 自走事例</p>
        <h2 class="sec-title">伴走を経て、社内で内製化が回るようになった会社の話。</h2>
        <p class="sec-lead">
          実際にツミキAIの伴走を経て自走した企業のインタビューを、Phase 2 以降で順次公開します。
          現在は守秘義務の都合で詳細公開は準備中です。<strong>初回ヒアリングでは、過去案件の構造（業務フロー再設計／AI組込／自走移行）を匿名でお話しできます。</strong>
        </p>
      </header>
      <div class="case-placeholder">
        <p class="case-placeholder-label">事例詳細は Phase 2 で公開予定</p>
        <p class="case-placeholder-body">
          現状ご紹介できる軸：建築業／製造業／卸売業の中小規模（30〜200名）／請求・受発注・在庫管理のAI化／半年で社内担当者が新規業務にも自分でAIを組み込める状態へ。
        </p>
        <a class="link-arrow" href="/contact/">過去案件の詳細を聞く →</a>
      </div>
    </div>
  </Section>

  <!-- §6 OBコミュニティ章は 2026-05-03 削除（実態未整備のため） -->

  <!-- ========== §7 できないこと（誠実さ①） ========== -->
  <Section size="l" background="default">
    <div class="support-container">
      <header class="sec-head">
        <p class="sec-kicker">§7 できないこと</p>
        <h2 class="sec-title">先に「お受けしないこと」をお伝えします。</h2>
        <p class="sec-lead">
          情報の非対称性を自ら解消するために、ご提供できないこと・お断りする条件を先に明示します。
        </p>
      </header>
      <ul class="cantdo-list">
        {cantDo.map((c) => (
          <li class="cantdo-card">
            <div class="cantdo-mark" aria-hidden="true">×</div>
            <h3 class="cantdo-title">{c.title}</h3>
            <p class="cantdo-body">{c.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- ========== §8 最終CTA ========== -->
  <Section size="l" background="warm">
    <div class="support-container final-cta">
      <h2 class="final-title">まずは現在地から、一緒に確かめませんか。</h2>
      <p class="final-lead">
        無料個別相談は30分から。オンラインでも、千葉県印西市の事務所でも、御社訪問でも対応します。
        ヒアリングだけでお引き取りいただいても構いません。
      </p>
      <div class="final-ctas">
        <a class="btn btn-primary btn-lg" href="/contact/">無料個別相談を予約する</a>
        <a class="btn btn-secondary btn-lg" href="/diagnose/">先に DX診断（10問・3分）を受ける</a>
      </div>
      <p class="final-note">
        ※ 初回ヒアリング時間は初期費用に含まれます（契約後）。相談だけならもちろん無料です。
      </p>
    </div>
  </Section>
</Layout>

<style>
  /* ============================================================
   * 共通コンテナ・見出し
   * ============================================================ */
  .support-container {
    max-width: var(--container-lg);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .sec-head {
    max-width: 720px;
    margin: 0 0 var(--space-8) 0;
  }
  .sec-kicker {
    font-family: var(--font-en);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 var(--space-3) 0;
  }
  .sec-title {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-heading);
    color: var(--color-text);
    margin: 0 0 var(--space-4) 0;
  }
  .sec-lead {
    font-size: var(--text-body-lg);
    line-height: var(--leading-body-lg);
    color: var(--color-text-body);
    margin: 0;
  }
  .sec-lead strong {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }
  .sec-lead a {
    color: var(--color-accent);
    font-weight: var(--weight-semibold);
  }

  /* ボタン共通 */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    font-family: var(--font-jp);
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    transition:
      background-color var(--duration-hover) var(--ease-out-quint),
      transform var(--duration-hover) var(--ease-out-quint);
    white-space: nowrap;
  }
  .btn-lg {
    padding: var(--space-4) var(--space-8);
    font-size: var(--text-body-lg);
  }
  .btn-primary {
    background: var(--color-accent);
    color: #fff;
    box-shadow: var(--shadow-button);
  }
  .btn-primary:hover {
    background: #E55A2B;
    color: #fff;
    transform: translateY(-1px);
  }
  .btn-secondary {
    background: transparent;
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
  }
  .btn-secondary:hover {
    background: var(--color-primary);
    color: #fff;
    transform: translateY(-1px);
  }

  /* ============================================================
   * §HERO
   * ============================================================ */
  .hero {
    text-align: center;
    max-width: 880px;
  }
  .hero .kicker {
    font-family: var(--font-en);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
