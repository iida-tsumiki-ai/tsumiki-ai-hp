---
import Layout from "../../../layouts/Layout.astro";
import CourseLandingPage from "../../../components/CourseLandingPage.astro";
import { noteUrls } from "../../../data/noteUrls";

const audience = [
  { text: "クラウド基盤は全社共通で使えているが、AIを触る人と触らない人で分かれている会社" },
  { text: "部門をまたぐとツール・データが断絶している方" },
  { text: "ミニアプリ／自動化が一部の得意な人依存になっている方" },
  { text: "「次は業務棚卸しだな」と感じ始めている経営者" },
];

const chapterParts = [
  {
    partLabel: "Part 1",
    partTitle: "導入と全体像",
    partDuration: "7分",
    chapters: [
      { no: "導入", title: "2段目の壁は、「使い方」ではなく「広げ方」にある", duration: "0-3分", body: "Lv1を抜けた会社で起きる「触る人と触らない人」の分断／中小機構2026年3月調査の8.3%（業務組み込み比率）。" },
      { no: 1, title: "「Lv2：活用を広げる」とは何か — 全体像", duration: "3-7分", body: "Lv1完了時の状態整理（全社員アカウント配布済／業務利用は先行チームのみ）／Lv2の4ブロック（全社底上げ／情報置き場共通化／業務棚卸し／ミニアプリ内製）。" },
    ],
  },
  {
    partLabel: "Part 2",
    partTitle: "本論",
    partDuration: "21分",
    chapters: [
      { no: 2, title: "AI活用の全社底上げと情報置き場の共通化", duration: "7-15分", body: "アカウントを配るだけ→全社員が業務で使う状態へ／持ち回り型の社内勉強会／3種類の拒否反応への向き合い方／命名規則・権限設計の3ステップ。" },
      { no: 3, title: "業務棚卸し：やめる／AIに任せる／人がやる", duration: "15-22分", body: "棚卸し4ステップ（一覧化→3分類→判断軸→時間泥棒）／「やめる」を最優先にする理由／AIに任せる／人がやる の境界（重複度・生成性・現場タッチ）。" },
      { no: 4, title: "ミニアプリ内製の型 — GAS / Power Automate", duration: "22-28分", body: "3つの定番パターン（集計・通知・転記）／GWS版 GAS / MS365版 Power Automate それぞれの補足／AIに書かせるプロンプトの型／3本目安の意味。" },
    ],
  },
  {
    partLabel: "Part 3",
    partTitle: "卒業条件と締め",
    partDuration: "7分",
    chapters: [
      { no: 5, title: "Lv3到達チェックリスト＋Lv3入口の落とし穴", duration: "28-32分", body: "5項目チェックリスト／個別効率化の罠／DeNAパラドックスの初出／「AI力＝マネジメント力」の入り口。" },
      { no: "締め", title: "次の一歩 — 自走モデルの約束", duration: "32-35分", body: "卒業前提で伴走する宣言／Lv3講座・無料個別相談への接続。" },
    ],
  },
];

const cantDo = [
  {
    title: "Lv1の基盤がない場合は適しません",
    body: "全社共通のクラウド基盤と会社メール配布が前提です。未着手の方は <a href=\"/courses/lv1/\">Lv1講座</a> から始めてください。",
  },
  {
    title: "Lv3の基幹系再選定は扱いません",
    body: "基幹系（販売／生産／会計）の再選定は Lv3講座／AI駆動経営伴走支援 の領域です。本講座は現場のAI活用底上げに集中します。",
  },
  {
    title: "ミニアプリの完成保証はありません",
    body: "GAS／Power Automate の型と判断軸は提供しますが、御社固有の実装は AI駆動経営伴走支援 でハンズオン支援します。",
  },
];

const faq = [
  {
    q: "Lv1講座は必読ですか？",
    a: "Lv1未読の場合、Part 1 のロードマップ要約だけでは追いつかない可能性があります。<a href=\"/courses/roadmap/\">ロードマップ講座（無料）</a>と Lv1の卒業チェックリスト確認をおすすめします。",
  },
  {
    q: "GWS版／MS365版どちらが先にリリースされますか？",
    a: "Lv1講座と同じく、購入時に GWS版／MS365版のどちらかを選択していただきます。すでに導入している基盤側を選ぶのが早いです。",
  },
  {
    q: "リリースはいつ？",
    a: "公開中です。経営者メンバーシップ（月¥3,000）に加入すると Lv1〜Lv4 全講座が読み放題になります。詳しくは上の主CTA「Lv2講座を読む（メンバーシップ 月¥3,000）」からどうぞ。",
  },
];
---

<Layout
  title="Lv2講座（メンバーシップ）— ツミキAI"
  description="AI活用の全社底上げ・業務棚卸し・ミニアプリの型を、読了35分で経営者自身が掴める note 有料記事。"
>
  <CourseLandingPage
    kicker="A. 経営者が先に学ぶ — Lv2講座"
    title={`AI活用の<span class="accent">全社底上げ</span>と、<br />業務棚卸しの型。`}
    lead={`「触る人と触らない人」の分断を解き、業務をやめる／AIに任せる／人がやるに仕分ける。<br />ミニアプリの型まで含めて、<strong>読了35分で経営者自身が掴める</strong> note 有料記事です。`}
    price="メンバーシップ"
    priceNote="月¥3,000で Lv1〜Lv4 全講座読み放題／GWS版・MS365版を同梱／読了35分・約13,600字"
    audience={audience}
    chapterParts={chapterParts}
    graduationLabel="卒業条件：Lv3到達チェックリストを満たす（次Lv講座 Part 3 で詳細）"
    graduationItems={[
      "全社でAI活用が底上げされた状態",
      "情報置き場が共通化されている",
      "ミニアプリ／自動化を社内で内製3本以上",
      "業務棚卸しが完了している",
      "基幹系の限界が経営者に見えてきた",
    ]}
    cantDo={cantDo}
    faq={faq}
    ctaPrimary={{ label: "Lv2講座を読む（メンバーシップ 月¥3,000）", href: noteUrls.lv2 }}
    ctaSecondary={{ label: "AI駆動経営診断で現在地を確認", href: "/diagnose/" }}
    ctaTertiary={{ label: "無料個別相談", href: "/contact/" }}
    variant="normal"
  />
</Layout>
