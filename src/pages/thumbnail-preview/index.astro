---
/**
 * note 記事サムネ画像プレビュー（全6バリアント縦積み表示）
 * URL: /thumbnail-preview/
 *
 * 一覧プレビュー用。個別書き出しは /thumbnail-preview/{variant}/ を使う。
 */
import "../../styles/tokens.css";
import "../../styles/global.css";
import ThumbnailCard from "../../components/ThumbnailCard.astro";
import { allVariants } from "../../data/thumbnails.ts";
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <title>Thumbnail Previews — ツミキAI</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;700;900&family=Shippori+Mincho:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      html, body {
        margin: 0;
        padding: 0;
        background: #D8D5D0;
      }
      body {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 32px;
        padding: 32px 0 64px;
      }
      .preview-label {
        font-family: var(--font-en);
        font-size: 13px;
        font-weight: 600;
        color: #888;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .preview-label a {
        color: #333;
        text-decoration: none;
      }
      .preview-label a:hover {
        text-decoration: underline;
      }
      astro-dev-toolbar,
      astro-dev-overlay {
        display: none !important;
      }
    </style>
  </head>
  <body>
    {
      allVariants.map((v) => (
        <>
          <p class="preview-label">
            <a href={`/thumbnail-preview/${v}/`}>?variant={v}</a>
          </p>
          <ThumbnailCard variant={v} />
        </>
      ))
    }
  </body>
</html>
