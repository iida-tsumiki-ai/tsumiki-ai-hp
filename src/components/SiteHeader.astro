---
/**
 * SiteHeader — 全ページ共通ヘッダー（ナビゲーション）
 * 設計書: DESIGN.md §5 Navigation / 11_HPリニューアル_設計書.md L1 の14ページ体系
 *
 * 仕様:
 *   - 高さ 72px / 背景 #FFFFFF → スクロール後 rgba(255,255,255,0.85) + blur
 *   - ロゴ左 / テキストナビ 5本 / accent CTA 1つ（無料DX診断）
 *   - モバイル: ハンバーガー → warm 背景の全画面オーバーレイ
 */

type NavLink = { href: string; label: string };

const navLinks: NavLink[] = [
  { href: "/products/", label: "商品" },
  { href: "/courses/", label: "A講座" },
  { href: "/seminar/", label: "合同セミナー" },
  { href: "/support-b/", label: "B伴走" },
  { href: "/about/", label: "会社情報" },
];

const ctaHref = "/diagnose/";
const ctaLabel = "無料DX診断";
---

<header class="site-header" data-header>
  <div class="header-inner">
    <a class="brand" href="/" aria-label="ツミキAI ホームへ">
      <span class="brand-mark" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="4" y="16" width="20" height="8" rx="2" fill="#FAF7F2" stroke="#E5E7EB" />
          <rect x="7" y="10" width="14" height="7" rx="2" fill="#FFE5D6" />
          <rect x="10" y="4" width="8" height="7" rx="2" fill="#1A3A5F" />
        </svg>
      </span>
      <span class="brand-text">ツミキAI</span>
    </a>

    <nav class="desktop-nav" aria-label="主要ナビゲーション">
      <ul>
        {
          navLinks.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="header-cta" href={ctaHref}>{ctaLabel}</a>

    <button
      type="button"
      class="hamburger"
      aria-label="メニューを開く"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-hamburger
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>

  <!-- モバイルオーバーレイ -->
  <div class="mobile-overlay" id="mobile-nav" hidden data-mobile-overlay>
    <div class="mobile-inner">
      <button
        type="button"
        class="close-btn"
        aria-label="メニューを閉じる"
        data-close
      >
        <span aria-hidden="true">×</span>
      </button>

      <nav aria-label="モバイルナビゲーション">
        <ul class="mobile-list">
          {
            navLinks.map((l) => (
              <li>
                <a href={l.href} data-nav-link>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <a class="mobile-cta" href={ctaHref} data-nav-link>
        {ctaLabel} →
      </a>

      <p class="mobile-sub">
        個別相談なら <a href="/contact/" data-nav-link>お問い合わせ</a> からどうぞ。
      </p>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const hamburger = document.querySelector<HTMLButtonElement>("[data-hamburger]");
  const overlay = document.querySelector<HTMLElement>("[data-mobile-overlay]");
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-close]");
  const navLinks = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");

  // スクロール時の blur + 薄透明切替
  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 20) {
      header.classList.add("scrolled");
    } else {
      header.classList.remove("scrolled");
    }
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // ハンバーガー開閉
  const openMenu = () => {
    if (!overlay || !hamburger) return;
    overlay.hidden = false;
    requestAnimationFrame(() => overlay.classList.add("is-open"));
    hamburger.setAttribute("aria-expanded", "true");
    document.body.classList.add("nav-open");
  };

  const closeMenu = () => {
    if (!overlay || !hamburger) return;
    overlay.classList.remove("is-open");
    hamburger.setAttribute("aria-expanded", "false");
    document.body.classList.remove("nav-open");
    // トランジション後に hidden 付与（300ms）
    window.setTimeout(() => {
      if (!overlay.classList.contains("is-open")) {
        overlay.hidden = true;
      }
    }, 300);
  };

  hamburger?.addEventListener("click", openMenu);
  closeBtn?.addEventListener("click", closeMenu);

  // オーバーレイ内のリンククリックで自動で閉じる
  navLinks.forEach((a) => a.addEventListener("click", closeMenu));

  // ESC で閉じる
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && overlay && !overlay.hidden) closeMenu();
  });
</script>

<style is:global>
  /* body スクロール抑止（オーバーレイ展開時） */
  body.nav-open {
    overflow: hidden;
  }

  /* アンカーリンクがヘッダーに隠れないよう */
  html {
    scroll-padding-top: 80px;
  }
</style>

<style>
  .site-header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: #ffffff;
    transition:
      background-color var(--duration-hover) var(--ease-out-quint),
      box-shadow var(--duration-hover) var(--ease-out-quint),
      backdrop-filter var(--duration-hover) var(--ease-out-quint);
  }
  .site-header.scrolled {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: var(--shadow-xs);
  }

  .header-inner {
    max-width: var(--container-lg);
    margin: 0 auto;
    padding: 0 var(--gutter);
    height: var(--header-height);
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: var(--space-6);
  }

  /* Brand */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: inherit;
  }
  .brand-mark {
    display: inline-flex;
  }
  .brand-text {
    font-family: var(--font-jp-serif);
    font-size: var(--text-h4);
    font-weight: var(--weight-bold);
    color: var(--color-primary);
    letter-spacing: 0.02em;
  }

  /* Desktop Nav */
  .desktop-nav {
    justify-self: end;
  }
  .desktop-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }
  .desktop-nav a {
    font-family: var(--font-jp);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    text-decoration: none;
    padding: var(--space-2) 0;
    border-bottom: 2px solid transparent;
    transition:
      color var(--duration-hover) var(--ease-out-quint),
      border-color var(--duration-hover) var(--ease-out-quint);
  }
  .desktop-nav a:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  /* CTA */
  .header-cta {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    background: var(--color-accent);
    color: #fff;
    border-radius: var(--radius-md);
    font-family: var(--font-jp);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    box-shadow: var(--shadow-button);
    white-space: nowrap;
    transition:
      background-color var(--duration-hover) var(--ease-out-quint),
      transform var(--duration-hover) var(--ease-out-quint);
  }
  .header-cta:hover {
    background: #E55A2B;
    color: #fff;
    transform: translateY(-1px);
  }

  /* Hamburger */
  .hamburger {
    display: none;
    width: 44px;
    height: 44px;
    padding: 10px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    flex-direction: column;
    justify-content: space-between;
  }
  .hamburger span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--color-primary);
    border-radius: 2px;
  }

  /* Mobile Overlay */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    background: var(--color-bg-warm);
    z-index: 200;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-page) var(--ease-out-quint);
  }
  .mobile-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  .mobile-overlay[hidden] {
    display: none;
  }

  .mobile-inner {
    height: 100%;
    padding: var(--space-8) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    justify-content: center;
    align-items: stretch;
    max-width: 480px;
    margin: 0 auto;
  }

  .close-btn {
    position: absolute;
    top: calc((var(--header-height) - 44px) / 2);
    right: var(--gutter);
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    cursor: pointer;
    font-family: var(--font-en);
    font-size: 28px;
    font-weight: var(--weight-regular);
    color: var(--color-primary);
    line-height: 1;
  }

  .mobile-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .mobile-list a {
    display: block;
    font-family: var(--font-jp-serif);
    font-size: var(--text-h3);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    text-decoration: none;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .mobile-list a:hover,
  .mobile-list a:focus {
    color: var(--color-accent);
  }

  .mobile-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4) var(--space-6);
    background: var(--color-accent);
    color: #fff;
    border-radius: var(--radius-md);
    font-family: var(--font-jp);
    font-size: var(--text-body-lg);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    box-shadow: var(--shadow-button);
  }

  .mobile-sub {
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
    text-align: center;
    margin: 0;
  }
  .mobile-sub a {
    color: var(--color-primary);
    font-weight: var(--weight-semibold);
  }

  /* ========================================
   * Responsive
   * ======================================== */
  @media (max-width: 1023px) {
    .desktop-nav ul {
      gap: var(--space-4);
    }
    .desktop-nav a {
      font-size: var(--text-caption);
    }
  }

  @media (max-width: 768px) {
    .header-inner {
      grid-template-columns: auto 1fr auto;
    }
    .desktop-nav,
    .header-cta {
      display: none;
    }
    .hamburger {
      display: flex;
      justify-self: end;
    }
  }
</style>
