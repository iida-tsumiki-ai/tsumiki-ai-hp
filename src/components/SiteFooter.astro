---
/**
 * SiteFooter — 全ページ共通フッター
 * 設計書: 11_HPリニューアル_設計書.md §1 §9 FOOTER（代表写真＋1行プロフィール常設）
 * DESIGN.md §5: 背景 #1A3A5F / リンクはアンダーラインなし・ホバーでアクセント
 */

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-rep">
        <img
          class="footer-rep-photo"
          src="/images/rep-interview.jpg"
          alt="ツミキAI代表 飯田武之"
          width="64"
          height="64"
          loading="lazy"
        />
        <div class="footer-rep-text">
          <p class="footer-rep-name">飯田武之（タケ）— ツミキAI 代表</p>
          <p class="footer-rep-desc">
            千葉県印西市が拠点です。弥生で中小企業向けプロダクトを6年担当し、EC経営を経て独立しました。中小企業向けインフラの品質とAI活用で、中小企業の現場を変えるために活動しています。
          </p>
        </div>
      </div>
    </div>

    <nav class="footer-nav" aria-label="フッターナビゲーション">
      <div class="footer-col">
        <h4 class="footer-col-title">サービス</h4>
        <ul>
          <li><a href="/courses/">経営者向け講座</a></li>
          <li><a href="/training/">担当者向け研修</a></li>
          <li><a href="/support/">AI駆動経営伴走支援</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="footer-col-title">最初の一歩</h4>
        <ul>
          <li><a href="/diagnose/">AI駆動経営診断（無料）</a></li>
          <li><a href="/courses/roadmap/">ロードマップ講座（無料）</a></li>
          <li><a href="/contact/">無料個別相談</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="footer-col-title">ツミキAIについて</h4>
        <ul>
          <li><a href="/about/">会社情報・代表プロフィール</a></li>
          <li><a href="/privacy/">プライバシーポリシー</a></li>
          <li><a href="/tokushoho/">特定商取引法に基づく表記</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="footer-col-title">SNS・外部発信</h4>
        <ul>
          <li><a href="https://note.com/tsumiki_ai" target="_blank" rel="noopener noreferrer">note（記事・講座）</a></li>
          <li><a href="https://x.com/tsumiki_ai_x" target="_blank" rel="noopener noreferrer">X（旧Twitter）</a></li>
          <li><a href="mailto:iida@tsumiki.ai">iida@tsumiki.ai</a></li>
        </ul>
      </div>
    </nav>

    <div class="footer-bottom">
      <p class="footer-brand">
        <strong>ツミキAI</strong> — 1段ずつ、着実に積み上げる。
      </p>
      <p class="footer-copy">© {currentYear} ツミキAI. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary);
    color: #fff;
    padding: var(--section-py-desktop-md) 0 var(--space-6);
  }

  .footer-inner {
    max-width: var(--container-lg);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* 代表プロフィール（常設） */
  .footer-rep {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: center;
    padding-bottom: var(--space-6);
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }
  .footer-rep-photo {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(255, 255, 255, 0.2);
  }
  .footer-rep-name {
    font-family: var(--font-jp-serif);
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
    color: #fff;
    margin: 0 0 4px 0;
  }
  .footer-rep-desc {
    font-size: var(--text-body-sm);
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin: 0;
  }

  /* ナビ */
  .footer-nav {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-8);
  }
  .footer-col-title {
    font-family: var(--font-jp);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: 0.04em;
    margin: 0 0 var(--space-3) 0;
  }
  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .footer-col a {
    font-size: var(--text-body-sm);
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color var(--duration-hover) var(--ease-out-quint);
  }
  .footer-col a:hover {
    color: var(--color-accent);
  }

  /* Bottom */
  .footer-bottom {
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .footer-brand {
    font-family: var(--font-jp-serif);
    font-size: var(--text-body);
    margin: 0;
  }
  .footer-brand strong {
    font-weight: var(--weight-bold);
  }
  .footer-copy {
    font-family: var(--font-en);
    font-size: var(--text-caption);
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
  }

  /* ========================================
   * Responsive
   * ======================================== */
  @media (max-width: 1023px) {
    .footer-nav {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .footer-rep {
      grid-template-columns: 1fr;
      text-align: left;
    }
    .footer-rep-photo {
      width: 56px;
      height: 56px;
    }
    .footer-nav {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
